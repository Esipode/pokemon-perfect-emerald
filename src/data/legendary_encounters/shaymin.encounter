Encounter: Shaymin

# Shaymin, "The Gratitude Pokemon". Every other legendary asks how hard the player can hit. Shaymin
# asks HOW THEY FIGHT, and then becomes the answer. One number runs the whole battle:
#   GARDEN  0-10, starting at 5. Tending it pushes it up, harming it pushes it down, and it moves by
#           at most one step per turn - a slope, not a switch.
#     0 BARREN | 1-2 WITHERING | 3-4 STRAINED | 5 neutral | 6-7 SPROUTING | 8-9 VERDANT | 10 FULL BLOOM
#     guard 94 |     guard 94  |    guard 92  | guard 90  |    guard 86   |   guard 80  |   guard 74
# THE GUARD IS THE POINT. At Garden 0 Shaymin takes 6% of what it is dealt; at Garden 10 it takes 26%,
# more than four times as much. The peaceful path is not flavour, it is mathematically the shorter
# fight - and it is the path a player optimising the way they normally optimise will never find,
# because everything that pushes the Garden DOWN is what a good competitive player reaches for first:
# Toxic, a burn, a Fire coverage move, hazards on the way in.
# THE LEDGER. Swing opens each turn at 10. Tend sources add, Harm sources subtract, and TurnClose
# moves the Garden one step toward whichever side won. A tie holds it.
#   TEND  a Grass move from either side (Shaymin's only counts while Garden >= 5 - a withered field
#         no longer answers it, which is what stops the two sides cancelling forever), the player
#         recovering HP, the player's status being cured.
#   HARM  a status standing on Shaymin (EVERY turn it lasts), a Fire or Poison move from the player,
#         entry hazards being set.
# ANTI-ABUSE IS THE LEDGER, not an immunity: status lands on Shaymin fully and works fully, it just
# costs a step of Garden per turn it runs, and the guard climbs while it does. A slept Shaymin at
# guard 94 is a worse deal than an awake one at 74, and the player is free to work that out.
# THE FORMES are decided by the Garden, not by HP, and can be changed back: Sky at Garden <= 2, Land
# at Garden >= 4, with the gap between them as hysteresis so it cannot flap at a boundary. Sky is
# faster and hits harder and is far frailer - the aggressive forme is the one the player made.
# No Ability: override. Natural Cure is Shaymin's own and is inert in a battle it never switches out
# of; Sky Forme's Serene Grace comes with the form change and gives Air Slash a 60% flinch chance,
# a genuine extra fang on the Blight path that costs nothing to implement.
Properties:
    Level: LevelCap
    CatchRate: 0                # none; the weakened script sets a real one off the Garden
    Balls: Blocked
    DamageReduction: 90         # the neutral band; EncScript_Shaymin_ApplyGarden owns this from here
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo
    CapTypeEffectiveness: True  # earns its keep here: Sky Forme is Grass/Flying, 4x weak to Ice
    FlatToxicDamage: True
    Survive: True
    AiFlags: AI_FLAG_SMART_TRAINER
    Moves: MOVE_ENERGY_BALL, MOVE_EARTH_POWER, MOVE_LEECH_SEED, MOVE_PLAY_ROUGH

# Always-true block: pins the variable numbering the battle scripts hard-code. encounterproc assigns
# each Var() an index in first-appearance order, so naming all fourteen here in order fixes
# Phase..RecovGuard to 0..13.
# 0 Phase (0 Gratitude Pokemon / 1 Gratitude / 2 Seed Flare / 3 Weakened), 1 Garden (0-10, starts 5),
# 2 LastBand (the last ANNOUNCED band index; 255 = force), 3 Swing (the turn's ledger, opens at 10 -
# one signed axis because encjumpifvar can only compare a var against a literal, never against
# another var), 4 Forme (0 Land / 1 Sky), 5 TurnGuard (the once-per-turn scaffold), 6 PlayerHpMark
# (the player's HP% at turn open; ENC_SNAP_RECOVERY turns it into "healed this turn"), 7 StatusMark
# (the player was statused at turn open), 8 PlayerMoveGuard / 9 BossMoveGuard / 10 StatusGuard (the
# per-turn re-entry guards), 11 FlareClock (the Phase 2 countdown), 12 Verdict (0 none / 1 gratitude
# / 2 indifferent / 3 distress), 13 RecovGuard.
Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_Shaymin_Intro
Conditions:
    Var(Phase) >= 0
    Var(Garden) >= 0
    Var(LastBand) >= 0
    Var(Swing) >= 0
    Var(Forme) >= 0
    Var(TurnGuard) >= 0
    Var(PlayerHpMark) >= 0
    Var(StatusMark) >= 0
    Var(PlayerMoveGuard) >= 0
    Var(BossMoveGuard) >= 0
    Var(StatusGuard) >= 0
    Var(FlareClock) >= 0
    Var(Verdict) >= 0
    Var(RecovGuard) >= 0
    Var(Pulse) >= 0

# The three phase transitions. Each is registered at both checkpoints because the blow that crosses a
# threshold can be a move or an end-of-turn tick; both copies are Once, which is marked at SELECTION,
# so whichever fires first permanently disables the other. Each is also gated on the Phase value its
# own script overwrites, so one huge hit crossing two thresholds steps through them in order.
# Registered ahead of every accounting trigger below so a threshold-crossing tick resolves as a
# transition first.
Trigger: OnMoveEnd
Priority: 5
Flags: Once, OnEnter
Script: EncScript_Shaymin_Gratitude
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 0

Trigger: OnTurnEnd
Priority: 5
Flags: Once, OnEnter
Script: EncScript_Shaymin_Gratitude
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 0

Trigger: OnMoveEnd
Priority: 6
Flags: Once, OnEnter
Script: EncScript_Shaymin_SeedFlarePhase
Conditions:
    Battler(Boss).HpPercent <= 20
    Var(Phase) == 1

Trigger: OnTurnEnd
Priority: 6
Flags: Once, OnEnter
Script: EncScript_Shaymin_SeedFlarePhase
Conditions:
    Battler(Boss).HpPercent <= 20
    Var(Phase) == 1

Trigger: OnMoveEnd
Priority: 7
Flags: Once
Script: EncScript_Shaymin_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 2

Trigger: OnTurnEnd
Priority: 7
Flags: Once
Script: EncScript_Shaymin_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 2

# Once-per-turn scaffold. TurnOpen's only gate is TurnGuard == 0, which it sets immediately, so no
# branch out of it can leave it re-armed; it opens the ledger, clears every re-entry guard, marks the
# player's HP and prints the standing line. TurnClose resolves the ledger and is the only caller of
# ApplyGarden outside a phase script.
Trigger: OnTurnStart
Priority: 10
Script: EncScript_Shaymin_TurnOpen
Conditions:
    Var(TurnGuard) == 0

# A script cannot read a battler's status - only a condition can - so the "was the player statused at
# the top of this turn" mark has to be its own trigger. Self-disabling: the script sets StatusMark.
Trigger: OnTurnStart
Priority: 20
Script: EncScript_Shaymin_MarkStatus
Conditions:
    Var(TurnGuard) == 1
    Var(StatusMark) == 0
    Battler(PlayerLeft).Status != 0

# THE LEDGER'S CREDITS AND DEBITS. At OnMoveEnd, Event.Battler is who GOT hit and Event.Target is who
# hit them, so Event.Target == B_POSITION_PLAYER_LEFT reads "the player used this move".
# Every one of these gates on a var it sets: an Event.* condition stays true for the whole dispatch
# and no script can move it, so an event-reacting trigger that does not disable itself re-selects
# until the per-checkpoint script cap trips. Once is wrong - it means once per BATTLE, and the ledger
# is the fight's central mechanic. In singles the player uses one move a turn, so the three
# player-move triggers share PlayerMoveGuard and are mutually exclusive anyway.
# Event.MoveType is the move's BASE type, so a Normalize/Electrify/Tera re-type does not count; the
# cheat-sheet says "Grass-type moves" rather than "moves that hit as Grass".
Trigger: OnMoveEnd
Priority: 20
Script: EncScript_Shaymin_TendGrassPlayer
Conditions:
    Var(PlayerMoveGuard) == 0
    Var(Phase) <= 2
    Event.Target == B_POSITION_PLAYER_LEFT
    Event.MoveType == TYPE_GRASS

# Shaymin's own Grass moves only answer a field that is still alive. Without the Garden >= 5 gate,
# Energy Ball would cancel out every debit the player ever pays and the Blight half of the fight
# would be unreachable.
Trigger: OnMoveEnd
Priority: 21
Script: EncScript_Shaymin_TendGrassBoss
Conditions:
    Var(BossMoveGuard) == 0
    Var(Phase) <= 2
    Var(Garden) >= 5
    Event.Target == B_POSITION_OPPONENT_LEFT
    Event.MoveType == TYPE_GRASS

Trigger: OnMoveEnd
Priority: 22
Script: EncScript_Shaymin_HarmBurnRot
Conditions:
    Var(PlayerMoveGuard) == 0
    Var(Phase) <= 2
    Event.Target == B_POSITION_PLAYER_LEFT
    Any:
        Event.MoveType == TYPE_FIRE
        Event.MoveType == TYPE_POISON

Trigger: OnMoveEnd
Priority: 23
Script: EncScript_Shaymin_HarmHazards
Conditions:
    Var(PlayerMoveGuard) == 0
    Var(Phase) <= 2
    Event.Target == B_POSITION_PLAYER_LEFT
    Any:
        Event.Move == MOVE_SPIKES
        Event.Move == MOVE_TOXIC_SPIKES
        Event.Move == MOVE_STEALTH_ROCK
        Event.Move == MOVE_STICKY_WEB

# The debit that ticks EVERY turn a status stands on Shaymin. This is the whole anti-abuse rule: no
# immunity anywhere, the tax is the guard.
Trigger: OnTurnEnd
Priority: 20
Script: EncScript_Shaymin_HarmStatusStanding
Conditions:
    Var(StatusGuard) == 0
    Var(Phase) <= 2
    Battler(Boss).Status != 0

Trigger: OnTurnEnd
Priority: 21
Script: EncScript_Shaymin_TendCured
Conditions:
    Var(StatusMark) == 1
    Var(Phase) <= 2
    Battler(PlayerLeft).Status == 0

# "The player recovered HP this turn", read against the mark TurnOpen set. Its own trigger rather than
# a line inside TurnClose because encsnapshothp is a single-slot command and asserts on a fainted
# battler - the PlayerLeft.HP condition is the guard, and conditions read a fainted battler safely.
Trigger: OnTurnEnd
Priority: 22
Script: EncScript_Shaymin_TendRecovery
Conditions:
    Var(RecovGuard) == 0
    Var(Phase) <= 2
    Battler(PlayerLeft).HP >= 1

# The Phase 2 flare. Ticked at OnTurnStart and resolved here, one checkpoint away, so a real turn
# passes between steps; the script re-arms the clock, so the condition is false the instant it
# finishes and no guard var is needed.
Trigger: OnTurnEnd
Priority: 40
Script: EncScript_Shaymin_SeedFlare
Conditions:
    Var(Phase) == 2
    Var(FlareClock) == 1

Trigger: OnTurnEnd
Priority: 90
Script: EncScript_Shaymin_TurnClose
Conditions:
    Var(TurnGuard) == 1
