Encounter: Keldeo

# Keldeo, "The Colt Pokemon". One rule, stated in both directions:
#   KELDEO FIGHTS YOU HONESTLY, AND IT ONLY GETS STRONGER BY TESTING ITSELF AGAINST YOU. Its guard
#   drops while it duels - and once its Resolve is complete, it stops duelling.
# THE DUEL IS THE GUARD. EncScript_Keldeo_ApplyStance is the only writer of the damage reduction,
#   and whether a duel is running is its only real input:
#     guard  93/80  Phase 0 (Apprentice)    - guarded / duelling
#            94/82  Phase 1 (Mentors' Teachings)
#            95/-   Phase 2 (True Resolve - Keldeo never duels again)
#     A broken Sacred Sword drops the guard a further 15 for one turn (Reeling).
#   Unlike its three siblings the phase does not own the guard and the meter does not either - the
#   duel does. A duel is a ~13-point guard drop and the only real damage window in the fight, and
#   Keldeo offers one on a cooldown until its Resolve completes, then never again.
# RESOLVE, 0-5. Pure offence and escalation, no defence at all:
#     1 Student   +1 Speed stage           (granted AND revoked as the meter moves)
#     2 Swordsman raised critical-hit ratio (granted AND revoked)
#     3 Adept     RIPOSTE - take health off Keldeo on a turn no duel is running and it counter-slashes
#     4 Master    THE DISARMING STROKE - every duel now opens by wiping your stat stages and screens;
#                 Riposte hits harder
#     5 Resolute  encformchange to KELDEO_RESOLUTE, slot 3 becomes Secret Sword, raw Sp. Atk +15% /
#                 Speed +10%. Resolve LOCKS at 5 forever, the duels stop, the SACRED SWORD test begins
#     +2  Keldeo won a duel (it knocked out the Pokemon it challenged)
#     +1  a super-effective type landed on Keldeo and it was still standing
#     +1  Keldeo shed a status at the top of a turn (Phase 1+ only)
#     +2  Phase 1 - it remembers its mentors
#     ->5 Phase 2 - forced, whatever the player had held it to
#     -1  Keldeo lost a duel (your Pokemon was still standing when time ran out)
# THE ENDGAME. Resolute reached -> duels stop, guard sits at its guarded value, and the SACRED SWORD
#   test cycles: the blade is raised at OnTurnStart and resolves at OnTurnEnd the SAME turn. Break it
#   - a status on Keldeo, or >= 25% of its max HP taken this turn - and it loses its next action, -1
#   Def / -1 Sp. Def, and its guard falls 15 for one turn. Otherwise SACRED SWORD lands for
#   30 / 36 / 42% of the player's side, escalating.
# ANTI-ABUSE IS DISPLACEMENT, NOT IMMUNITY (guideline 8). In Phase 0 a status sticks and works
#   completely - the strongest opening play in the fight. From Phase 1 Keldeo sheds it every turn, so
#   it keeps working but costs a move a turn AND feeds Resolve +1. Sacred Sword sits in a fixed slot
#   all fight and ignores defensive stat changes and evasion; Aura Sphere never misses; the Disarming
#   Stroke wipes stat stages and screens at the top of every duel from Resolve 4. Toxic is flat.
Properties:
    Level: LevelCap
    CatchRate: 0                # none; EncScript_Keldeo_Spent sets a real one
    Balls: Blocked
    DamageReduction: 93         # Guarded, Phase 0. Every later value is written absolutely by
                                # EncScript_Keldeo_ApplyStance, which _Intro calls on turn 0
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo
    CapTypeEffectiveness: True  # Water/Fighting has no 4x weakness of its own, but the cap still
                                # matters against anything the player re-types (guideline 6)
    FlatToxicDamage: True
    Survive: True               # load-bearing: 1 HP is what ends TRUE RESOLVE and opens the catch
                                # window, and an oversized hit into a reeling guard of 80 could
                                # otherwise skip the whole last phase. Cleared in _Spent
    Ability: ABILITY_JUSTIFIED  # its own, and the family's - a Dark move raises its Attack, so the
                                # obvious neutral coverage answer feeds it
    Moves: MOVE_SACRED_SWORD, MOVE_SCALD, MOVE_AQUA_JET, MOVE_AURA_SPHERE
    AiFlags: AI_FLAG_SMART_TRAINER

# Always-true block: pins the variable numbering the battle scripts hard-code. encounterproc assigns
# each Var() an index in first-appearance order, so naming all sixteen here in order fixes
# Phase..Ultimate to 0..15. No var-to-var comparison appears anywhere in this design; every test is
# against a literal, and ENC_SNAP_DAMAGE is the engine's own answer to "subtract one value from
# another".
# 0 Phase (0 Apprentice / 1 Mentors' Teachings / 2 True Resolve / 3 Spent), 1 Resolve (0-5),
# 2 LastRes (the last ANNOUNCED Resolve - the callout's re-fire latch), 3 Rank (revocable perks
# applied: 0 none / 1 Speed / 2 Speed + crit), 4 TurnGuard (the once-per-turn scaffold), 5 Duel
# (0 no duel / 1 duel running), 6 DuelTurns (turns left before the challenged Pokemon has survived),
# 7 DuelCd (turns until Keldeo may challenge again), 8 BossMark (Keldeo HP% at turn open), 9 Scratch
# (the copy ENC_SNAP_DAMAGE consumes, so BossMark survives being measured), 10 Charge (0 none / 1
# blade raised / 2 reeling from a broken sword), 11 EventGuard (per-turn guard shared by OnFaint and
# OnSwitchIn), 12 Riposted (0 nothing to answer / 1 armed / 2 already answered), 13 Gained (the
# super-effective +1 has already been taken this turn), 14 Resolute (the form change has fired and
# Resolve is locked at 5), 15 Ultimate (how many Sacred Swords have landed - drives escalating
# damage and dialogue).
Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_Keldeo_Intro
Conditions:
    Var(Phase) >= 0
    Var(Resolve) >= 0
    Var(LastRes) >= 0
    Var(Rank) >= 0
    Var(TurnGuard) >= 0
    Var(Duel) >= 0
    Var(DuelTurns) >= 0
    Var(DuelCd) >= 0
    Var(BossMark) >= 0
    Var(Scratch) >= 0
    Var(Charge) >= 0
    Var(EventGuard) >= 0
    Var(Riposted) >= 0
    Var(Gained) >= 0
    Var(Resolute) >= 0
    Var(Ultimate) >= 0

# The three phase transitions. Each is registered at both checkpoints because the blow that crosses a
# threshold can be a move or an end-of-turn tick; both copies are Once, which is marked at SELECTION,
# so whichever fires first permanently disables the other. All three sit below _TurnClose (80), so at
# an OnTurnEnd where the player's damage crossed a threshold the transition runs first and every
# later script sees the new Phase. Same shape as all three siblings.
Trigger: OnMoveEnd
Priority: 5
Flags: Once, OnEnter
Script: EncScript_Keldeo_Teachings
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 0

Trigger: OnTurnEnd
Priority: 5
Flags: Once, OnEnter
Script: EncScript_Keldeo_Teachings
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 0

Trigger: OnMoveEnd
Priority: 6
Flags: Once, OnEnter
Script: EncScript_Keldeo_TrueResolve
Conditions:
    Battler(Boss).HpPercent <= 20
    Var(Phase) == 1

Trigger: OnTurnEnd
Priority: 6
Flags: Once, OnEnter
Script: EncScript_Keldeo_TrueResolve
Conditions:
    Battler(Boss).HpPercent <= 20
    Var(Phase) == 1

Trigger: OnMoveEnd
Priority: 7
Flags: Once
Script: EncScript_Keldeo_Spent
Conditions:
    Battler(Boss).HpPercent <= 1
    Var(Phase) == 2

Trigger: OnTurnEnd
Priority: 7
Flags: Once
Script: EncScript_Keldeo_Spent
Conditions:
    Battler(Boss).HpPercent <= 1
    Var(Phase) == 2

# The once-per-turn scaffold. TurnGuard is its only gate and the script sets it immediately, so no
# branch out of it can leave it re-armed. It ticks the duel cooldown and the duel timer (the
# decrement half of the split countdown), snapshots the mark the turn is measured against, runs the
# recurring cue, and clears the per-turn state.
Trigger: OnTurnStart
Priority: 10
Script: EncScript_Keldeo_TurnOpen
Conditions:
    Var(TurnGuard) == 0

# Phase 1+ anti-abuse: a status is shed at the top of every turn - it keeps working but costs a move
# and feeds Resolve. Self-disabling: the script cures the status its own condition reads. In Phase 0
# there is no shedding at all.
Trigger: OnTurnStart
Priority: 12
Script: EncScript_Keldeo_Shed
Conditions:
    Var(Phase) >= 1
    Var(Phase) <= 2
    Battler(Boss).Status >= 1

# THE CHALLENGE. Announced before the player picks a move, so the turn can be spent on the answer.
# Self-disabling: the script sets Duel. DuelCd == 0 is the cooldown; Resolute == 0 stops it once the
# fight has moved on to the Sacred Sword test.
Trigger: OnTurnStart
Priority: 15
Script: EncScript_Keldeo_Challenge
Conditions:
    Var(Phase) <= 1
    Var(Resolute) == 0
    Var(Duel) == 0
    Var(DuelCd) == 0

# THE SACRED SWORD telegraph (Resolute only). Sets Charge at OnTurnStart so the player sees the blade
# raised before choosing a move; _SwordResolve resolves it at OnTurnEnd the same turn. Self-disabling
# through Charge, which _SwordResolve and _TurnClose move.
Trigger: OnTurnStart
Priority: 16
Script: EncScript_Keldeo_RaiseBlade
Conditions:
    Var(Phase) <= 2
    Var(Resolute) == 1
    Var(Duel) == 0
    Var(Charge) == 0

# TEMPERED. A Flying / Psychic / Electric / Grass / Fairy move landed on Keldeo - exactly
# Water/Fighting's weaknesses, so "survived a super-effective hit" is expressible without an
# effectiveness operand. At OnMoveEnd Event.Battler is the battler that GOT HIT. Self-disables
# through Gained, which its script sets; Once would mean once per BATTLE.
Trigger: OnMoveEnd
Priority: 30
Script: EncScript_Keldeo_Tempered
Conditions:
    Var(Gained) == 0
    Var(TurnGuard) == 1
    Var(Phase) <= 2
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Any:
        Event.MoveType == TYPE_FLYING
        Event.MoveType == TYPE_PSYCHIC
        Event.MoveType == TYPE_ELECTRIC
        Event.MoveType == TYPE_GRASS
        Event.MoveType == TYPE_FAIRY

# Keldeo knocked out the Pokemon it challenged. EventGuard stops the replacement switch-in being
# processed a second time against the same faint; the +2 is applied by _DuelWon.
Trigger: OnFaint
Priority: 30
Script: EncScript_Keldeo_DuelWon
Conditions:
    Var(EventGuard) == 0
    Var(Phase) <= 2
    Var(Duel) == 1
    Event.Battler == B_POSITION_PLAYER_LEFT

# TurnGuard == 1 is load-bearing: OnSwitchIn fires for the player's lead BEFORE OnBattleStart, when
# every var is 0. Sets EventGuard and nothing else - a mid-turn switch (U-turn, Eject Button) only
# exists here so a faint later in the same turn is not double-counted.
Trigger: OnSwitchIn
Priority: 31
Script: EncScript_Keldeo_TheyEntered
Conditions:
    Var(EventGuard) == 0
    Var(TurnGuard) == 1
    Var(Phase) <= 2
    Event.Battler == B_POSITION_PLAYER_LEFT

# THE LEDGER. Runs first of the OnTurnEnd measuring scripts so it sees a finished turn: it measures
# the damage the player took off Keldeo this turn, arms Riposte, and leaves the amount in Scratch for
# the sword-break test. Self-disables by clearing TurnGuard.
Trigger: OnTurnEnd
Priority: 80
Script: EncScript_Keldeo_TurnClose
Conditions:
    Var(TurnGuard) == 1

# RIPOSTE (Resolve 3+, no duel running). Runs after _TurnClose (80), which arms it. The Duel == 0
# condition is the mechanic: inside a duel Keldeo fights straight and takes the hit. Self-disables
# through Riposted, which its script sets to 2.
Trigger: OnTurnEnd
Priority: 82
Script: EncScript_Keldeo_Riposte
Conditions:
    Var(Phase) <= 2
    Var(Duel) == 0
    Var(Resolve) >= 3
    Var(Riposted) == 1

# The duel timer ran out with the challenged Pokemon still standing. Resolved at OnTurnEnd, one
# checkpoint away from the _TurnOpen decrement (the mandated split for a countdown). Self-disables:
# _EndDuel clears Duel.
Trigger: OnTurnEnd
Priority: 84
Script: EncScript_Keldeo_DuelSurvived
Conditions:
    Var(Phase) <= 2
    Var(Duel) == 1
    Var(DuelTurns) == 0

# The SACRED SWORD test resolves, the same turn the blade was raised. Runs after _TurnClose (80),
# which leaves the turn's damage in Scratch. Self-disables by moving Charge off 1.
Trigger: OnTurnEnd
Priority: 90
Script: EncScript_Keldeo_SwordResolve
Conditions:
    Var(Phase) <= 2
    Var(Charge) == 1
