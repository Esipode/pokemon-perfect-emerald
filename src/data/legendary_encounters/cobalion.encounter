Encounter: Cobalion

# Cobalion, "The Iron Will". One rule, stated at two time scales:
#   COBALION'S STANCE ANSWERS YOUR LAST TURN. ITS DISCIPLINE ANSWERS YOUR LAST TEN.
#   STANCE - GUARD (you attacked it), ASSAULT (you set up, switched or went status), COMMAND
#   (Discipline 4+, or Cobalion is carrying a status it wants gone). The stance is the ONLY input
#   to the damage-reduction guard, and EncScript_Cobalion_ApplyGuard is its only writer, so the
#   number the player feels always has exactly one cause they were told about.
#     GUARD   91/93/89 by phase - the wall. Metal Burst and Safeguard in slots 2-3
#     ASSAULT 79/81/74          - the real damage window, and the turn Cobalion hits hardest
#     COMMAND 86/88/84          - it stops attacking, sheds its status, and reads you
#   DISCIPLINE 0-5 - the pattern meter. +1 for repeating a damage CATEGORY (or repeating a
#   switch), -1 for doing something different. It never touches the guard; it punishes.
#     3+  COUNTERSTRIKE: a repeated category into GUARD comes back for 12/15/18% of your max HP
#     4+  Cobalion drops into COMMAND
#     5   THE READ: encdisablemove locks the move you lean on, and from Phase 1 encswitchout
#         drags your Pokemon out. Discipline then falls back to 3 - a spike, not a lock
# Phase 1 (50%) writes +25% Attack and +15% Speed into the raw stats and starts TACTICAL COMMAND:
# encstoreprediction reads the engine's real AI_FLAG_PREDICT_MOVE answer and Cobalion declares the
# approach it expects. It guessed right - a 14/16% counter. It guessed wrong - its guard falls 18
# for the turn, the biggest window in the fight, opened by being unpredictable.
# Phase 2 (25%) floors Discipline at 2 and flips the stance every single turn.
# ANTI-ABUSE IS DISPLACEMENT, NOT IMMUNITY (guideline 8). Cobalion has no status immunities at
# all: sleep, paralysis and burn land and work completely, for up to three turns, until COMMAND
# comes off cooldown and sheds them. Safeguard is the other half, and it is Defog-able.
Properties:
    Level: LevelCap
    CatchRate: 0                # none; EncScript_Cobalion_LastStand sets a real one
    Balls: Blocked
    DamageReduction: 90         # GUARD, Phase 0 - turn 1 opens braced. Every later value is
                                # written absolutely by EncScript_Cobalion_ApplyGuard
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo
    CapTypeEffectiveness: True
    FlatToxicDamage: True
    Survive: True               # load-bearing: the Last Stand must never resolve against a dead
                                # Cobalion, and it is what guarantees the catch window is
                                # reachable. Cleared in EncScript_Cobalion_LastStand
    Ability: ABILITY_JUSTIFIED  # its own, and a real trap: a Dark move raises its Attack
    Moves: MOVE_SACRED_SWORD, MOVE_IRON_HEAD, MOVE_METAL_BURST, MOVE_SAFEGUARD
    AiFlags: AI_FLAG_SMART_TRAINER | AI_FLAG_PREDICT_MOVE

# Always-true block: pins the variable numbering the battle scripts hard-code. encounterproc
# assigns each Var() an index in first-appearance order, so naming all sixteen here in order fixes
# Phase..Declared to 0..15.
# 0 Phase (0 The Vanguard / 1 Leader of the Swords / 2 Iron Resolve / 3 Spent),
# 1 Stance (0 GUARD, 1 ASSAULT, 2 COMMAND), 2 LastStance (the last ANNOUNCED stance - the
# callout's re-fire latch), 3 Discipline (0-5), 4 LastDisc (the same latch, other meter),
# 5 LastCat (what the player did last turn: 0 nothing, 1 physical, 2 special, 3 status,
# 4 switched), 6 ThisCat (the same, for the turn in progress), 7 Broke (1 if this turn's action
# differed from LastCat), 8 TurnGuard (the once-per-turn scaffold), 9 Hit (per-turn re-entry guard
# for the three OnMoveEnd ledger triggers), 10 EventGuard (per-turn guard shared by OnSwitchIn and
# OnFaint, so a forced replacement is not charged as a voluntary switch), 11 Predict (the category
# Cobalion declared this turn), 12 Stall (consecutive turns the player committed no action),
# 13 Cooldown (turns until COMMAND / THE READ may fire again), 14 Seen (per-turn guard for the
# evasion strip), 15 Declared (per-turn guard for the declaration - encstoreprediction can
# legitimately answer 0, so Predict cannot be the thing that self-disables that trigger).
Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_Cobalion_Intro
Conditions:
    Var(Phase) >= 0
    Var(Stance) >= 0
    Var(LastStance) >= 0
    Var(Discipline) >= 0
    Var(LastDisc) >= 0
    Var(LastCat) >= 0
    Var(ThisCat) >= 0
    Var(Broke) >= 0
    Var(TurnGuard) >= 0
    Var(Hit) >= 0
    Var(EventGuard) >= 0
    Var(Predict) >= 0
    Var(Stall) >= 0
    Var(Cooldown) >= 0
    Var(Seen) >= 0
    Var(Declared) >= 0

# The three phase transitions. Each is registered at both checkpoints because the blow that crosses
# a threshold can be a move or an end-of-turn tick; both copies are Once, which is marked at
# SELECTION, so whichever fires first permanently disables the other. All three sit below
# _TurnClose (90), so at an OnTurnEnd where the player's damage crossed a threshold the transition
# runs first and _TurnClose then does its Discipline arithmetic against the phase it is in.
Trigger: OnMoveEnd
Priority: 5
Flags: Once, OnEnter
Script: EncScript_Cobalion_Leader
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 0

Trigger: OnTurnEnd
Priority: 5
Flags: Once, OnEnter
Script: EncScript_Cobalion_Leader
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 0

Trigger: OnMoveEnd
Priority: 6
Flags: Once, OnEnter
Script: EncScript_Cobalion_IronResolve
Conditions:
    Battler(Boss).HpPercent <= 25
    Var(Phase) == 1

Trigger: OnTurnEnd
Priority: 6
Flags: Once, OnEnter
Script: EncScript_Cobalion_IronResolve
Conditions:
    Battler(Boss).HpPercent <= 25
    Var(Phase) == 1

Trigger: OnMoveEnd
Priority: 7
Flags: Once
Script: EncScript_Cobalion_LastStand
Conditions:
    Battler(Boss).HpPercent <= 1
    Var(Phase) == 2

Trigger: OnTurnEnd
Priority: 7
Flags: Once
Script: EncScript_Cobalion_LastStand
Conditions:
    Battler(Boss).HpPercent <= 1
    Var(Phase) == 2

# The once-per-turn scaffold, and where the stance for the turn is chosen. TurnGuard is set
# immediately so no branch out of it can leave it re-armed.
Trigger: OnTurnStart
Priority: 10
Script: EncScript_Cobalion_TurnOpen
Conditions:
    Var(TurnGuard) == 0

# TACTICAL COMMAND's declaration half, split off _TurnOpen so the stance line prints before the
# read line. Gated on its own Declared guard rather than on Predict: encstoreprediction writes 0
# when the AI has no prediction this turn, which is an ordinary quiet turn, not a reason to
# re-select until the per-checkpoint script cap trips.
Trigger: OnTurnStart
Priority: 20
Script: EncScript_Cobalion_ResolveDeclare
Conditions:
    Var(Declared) == 0
    Var(TurnGuard) == 1
    Var(Phase) >= 1
    Var(Phase) <= 2

# THE LEDGER. Split three ways because no command reads a move's category into a variable - the
# split IS the branch, and each arm knows its own category as a literal, which is the only
# comparison the condition language has. All three self-disable through Hit, which their own
# scripts set; Once would mean once per battle, and OnEnter cannot help because an Event.*
# condition does not change inside a dispatch.
# At OnMoveEnd Event.Battler is the battler that GOT HIT and Event.Target the one that USED the
# move, so the damage pair reads as "the player's Pokemon hit Cobalion" - a confusion self-hit is
# not a read the player made and does not count.
Trigger: OnMoveEnd
Priority: 30
Script: EncScript_Cobalion_StruckPhysical
Conditions:
    Var(Hit) == 0
    Var(TurnGuard) == 1
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Event.Target == B_POSITION_PLAYER_LEFT
    Event.MoveCategory == DAMAGE_CATEGORY_PHYSICAL

Trigger: OnMoveEnd
Priority: 30
Script: EncScript_Cobalion_StruckSpecial
Conditions:
    Var(Hit) == 0
    Var(TurnGuard) == 1
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Event.Target == B_POSITION_PLAYER_LEFT
    Event.MoveCategory == DAMAGE_CATEGORY_SPECIAL

# The status arm keys on Event.Target alone, so it catches a status move pointed at Cobalion
# (Toxic, Will-O-Wisp) and one pointed at the player's own Pokemon (Swords Dance, Protect) alike -
# both are "you spent the turn on something other than hitting it".
Trigger: OnMoveEnd
Priority: 31
Script: EncScript_Cobalion_TheyManeuvered
Conditions:
    Var(Hit) == 0
    Var(TurnGuard) == 1
    Event.Target == B_POSITION_PLAYER_LEFT
    Event.MoveCategory == DAMAGE_CATEGORY_STATUS

# TurnGuard == 1 is load-bearing: OnSwitchIn fires for the player's lead BEFORE OnBattleStart,
# when every var is still 0 - without the gate the opening switch-in would be charged as a
# repositioning on turn 0.
Trigger: OnSwitchIn
Priority: 30
Script: EncScript_Cobalion_TheyRepositioned
Conditions:
    Var(EventGuard) == 0
    Var(TurnGuard) == 1
    Var(Phase) <= 2
    Event.Battler == B_POSITION_PLAYER_LEFT

Trigger: OnFaint
Priority: 30
Script: EncScript_Cobalion_TheyFell
Conditions:
    Var(EventGuard) == 0
    Var(Phase) <= 2
    Event.Battler == B_POSITION_PLAYER_LEFT

# Runs last, so it sees a finished turn: the stall ledger, the Discipline arithmetic,
# COUNTERSTRIKE, the callout, and the guard restored absolutely.
Trigger: OnTurnEnd
Priority: 90
Script: EncScript_Cobalion_TurnClose
Conditions:
    Var(TurnGuard) == 1

# THE READ, after _TurnClose has settled the meter. Self-disabling: the script spends Discipline
# back down to 3 and sets the cooldown.
Trigger: OnTurnEnd
Priority: 91
Script: EncScript_Cobalion_TheRead
Conditions:
    Var(Discipline) == 5
    Var(Cooldown) == 0
    Var(Phase) <= 2

# The evasion answer. Gated on Seen, cleared in _TurnOpen, so it strips two stages a turn rather
# than re-selecting inside one checkpoint's re-evaluation loop.
Trigger: OnTurnEnd
Priority: 92
Script: EncScript_Cobalion_SeeThrough
Conditions:
    Var(Seen) == 0
    Var(Phase) <= 2
    Battler(PlayerLeft).Stat(STAT_EVASION) > DEFAULT_STAT_STAGE
