Encounter: Miraidon

# Miraidon, "The Iron Serpent Pokemon". One rule:
#   RESHIRAM'S RULE, IN REVERSE - it doesn't learn from you slowly, it learns from you INSTANTLY.
#   Analysis (0-6) is the read: it climbs on resisted hits, repeated move category, and correct
#   predictions, and once it hits 3 Miraidon calls its shot (physical/special/status) every turn -
#   guess right and it hits hard, guess wrong and Analysis drops. Landing 5%+ of Miraidon's max HP
#   in one hit knocks a Node offline, denting Analysis and (late) Paradox Drive's scaling - the
#   player's one lever against a meter that otherwise only goes up.
# THREE PHASES: Analysis Network (100-50%) -> Future Engine (50-20%, Nodes regen, Overclock can
#   fire once Analysis caps) -> Paradox Collapse (<20%, System Failure punishes repeat
#   misprediction, Paradox Drive fires once at 15% and resets every meter, Balls unlock at 10%).
# ENGINE LIMITS (forced by primitives that don't exist, not by choice):
#   - No var-to-var or var-to-Event comparison opcode exists, so "predicted category matches this
#     turn's" is expressed as paired literal conditions (Event.MoveCategory==X AND Var(..)==X), and
#     "repeated move TYPE" (needs an 18-way type enumeration to fake a var-vs-var compare) is
#     substituted with "repeated move CATEGORY" (3-way, and it reuses the same category tracking
#     SCAN already needs) - a same-theme, cheaper substitute.
#   - enccomparestat compares the SAME stat across two BATTLERS, not two different stats on the same
#     battler, so it cannot answer "is the player's Atk or SpAtk higher". SCAN instead reads off the
#     CATEGORY of the player's last landed hit (already tracked for the repeat check above) - the
#     one thing this engine actually can answer about "the player's offensive leaning".
#   - encchangehp's amount is a compile-time literal, not a variable, so Paradox Drive's
#     16 + 2*Analysis + 4*Nodes (capped 30) is approximated as a 4(Nodes)x3(Analysis-band) lookup
#     rather than computed live. Monotonic, same floor/ceiling, banded rather than exact - a build-
#     and-feel tuning target like every other percentage dial in this fight.
#   - Resisted-hit / repeated-category / Node-destroy are three INDEPENDENT facts about the same
#     OnMoveEnd occurrence, but Event.* is only testable in trigger Conditions (never inside a
#     script), so each needs its own trigger. They share one guard var as a 2-bit mask (bit 0 =
#     Analyze group, bit 1 = NodeDestroy) rather than costing two variables outright - the 16-var
#     budget has no room to spare with 16 named uses already.
#   - Phase transitions, Paradox Drive and the catch window are each registered at BOTH OnMoveEnd
#     and OnTurnEnd (the Reshiram/Genesect idiom), not just OnMoveEnd as sketched - Miraidon can
#     cross a threshold from passive damage (Toxic, weather) with no move involved, and a single-
#     checkpoint registration would leave the fight stuck at that phase forever.
Properties:
    Level: LevelCap
    CatchRate: 15
    Balls: Blocked
    DamageReduction: 92
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo
    CapTypeEffectiveness: True   # Electric/Dragon takes 4x from Ice/Dragon/Fairy stacks otherwise
    FlatToxicDamage: True
    Ability: ABILITY_HADRON_ENGINE   # its own; Electric Terrain (below) makes it pay off natively
    Moves: MOVE_ELECTRO_DRIFT, MOVE_DRAGON_PULSE, MOVE_DISCHARGE, MOVE_PARABOLIC_CHARGE
    AiFlags: AI_FLAG_SMART_TRAINER | AI_FLAG_PREDICT_MOVE

# Always-true block: pins the variable numbering the battle scripts hard-code. encounterproc assigns
# each Var() an index in first-appearance order.
# 0 Phase (0 Network / 1 Future Engine / 2 Paradox Collapse), 1 Analysis (0-6, the core meter),
# 2 Nodes (0-3, active Electric Nodes), 3 PredictCat (encstoreprediction result: 0 none/1 phys/
# 2 spec/3 status), 4 PredictActive (this turn's CALCULATING window is live), 5 LastReduction (the
# announced guard-state latch for the CapTypeEffectiveness/terrain callout - 1 guarded/0 exposed),
# 6 OverclockTurns (0-3, countdown), 7 ErrorCount (0-3, failed predictions since Paradox Collapse),
# 8 ErrorActive (0-3, System Failure countdown), 9 ScanStat (0/STAT_ATK/STAT_SPATK, the live buffed
# stat), 10 ScanTurns (0-3, Scan bonus countdown), 11 LastMoveType (unused sentinel slot reserved -
# see header note on the type-repeat substitution), 12 LastCategory (0 unset/1 physical/2 special -
# the player's last landed category, drives both the repeat bonus and SCAN's target), 13 TurnGuard
# (the once-per-turn scaffold), 14 MoveGuard (2-bit mask: bit0 Analyze group, bit1 NodeDestroy),
# 15 SnapVar (0-100, Miraidon's HP% baseline for the Node-destroy damage check).
Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_Miraidon_Init
Conditions:
    Var(Phase) >= 0
    Var(Analysis) >= 0
    Var(Nodes) >= 0
    Var(PredictCat) >= 0
    Var(PredictActive) >= 0
    Var(LastReduction) >= 0
    Var(OverclockTurns) >= 0
    Var(ErrorCount) >= 0
    Var(ErrorActive) >= 0
    Var(ScanStat) >= 0
    Var(ScanTurns) >= 0
    Var(LastMoveType) >= 0
    Var(LastCategory) >= 0
    Var(TurnGuard) >= 0
    Var(MoveGuard) >= 0
    Var(SnapVar) >= 0

# The once-per-turn scaffold. TurnGuard is the only gate and the script sets it immediately.
Trigger: OnTurnStart
Priority: 0
Script: EncScript_Miraidon_TurnOpen
Conditions:
    Var(TurnGuard) == 0

# The ledger: passive Analysis trickle (Phase >= 1), SCAN start/tick, Overclock residual tick,
# System Failure countdown - all folded into one script so none of them is a bare countdown trigger
# that would re-select itself within the same checkpoint pass (the "split a countdown across two
# checkpoints" gotcha - ticking and resolving at the same checkpoint as an independent trigger
# chases itself through every state in one dispatch). Self-disables by clearing TurnGuard.
Trigger: OnTurnEnd
Priority: 20
Script: EncScript_Miraidon_TurnClose
Conditions:
    Var(TurnGuard) == 1

Trigger: OnTurnStart
Priority: 1
Flags: OnEnter
Script: EncScript_Miraidon_CalculatingOn
Conditions:
    Var(Analysis) >= 3

Trigger: OnTurnStart
Priority: 1
Flags: OnEnter
Script: EncScript_Miraidon_CalculatingOff
Conditions:
    Not:
        Var(Analysis) >= 3

# ANALYZE group (resisted-type / repeated-category), MoveGuard bit 0. Event.* is condition-only, so
# a script can't branch on it - each fact needs its own trigger. Only one fires per hit (whichever
# is eligible at the lowest priority), matching the "first arm to fire is the only one" idiom this
# project already ships (see genesect.encounter's three ANALYZE triggers) - a resisted Special hit
# registers as resisted, not also as a category repeat, that same turn.
Trigger: OnMoveEnd
Priority: 5
Script: EncScript_Miraidon_AnalyzeResisted
Conditions:
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Any:
        Var(MoveGuard) == 0
        Var(MoveGuard) == 2
    Any:
        Event.MoveType == TYPE_ELECTRIC
        Event.MoveType == TYPE_DRAGON
        Event.MoveType == TYPE_STEEL
        Event.MoveType == TYPE_FLYING
        Event.MoveType == TYPE_GRASS

Trigger: OnMoveEnd
Priority: 6
Script: EncScript_Miraidon_AnalyzePhysical
Conditions:
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Event.MoveCategory == DAMAGE_CATEGORY_PHYSICAL
    Any:
        Var(MoveGuard) == 0
        Var(MoveGuard) == 2

Trigger: OnMoveEnd
Priority: 7
Script: EncScript_Miraidon_AnalyzeSpecial
Conditions:
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Event.MoveCategory == DAMAGE_CATEGORY_SPECIAL
    Any:
        Var(MoveGuard) == 0
        Var(MoveGuard) == 2

# NODE DESTROY, MoveGuard bit 1 - independent of the Analyze group above, so it needs its own bit
# rather than sharing theirs (a 5%+ hit and a resisted/repeated hit are both true of the same move).
Trigger: OnMoveEnd
Priority: 8
Script: EncScript_Miraidon_NodeDestroy
Conditions:
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Any:
        Var(MoveGuard) == 0
        Var(MoveGuard) == 1

Trigger: OnTurnStart
Priority: 2
Script: EncScript_Miraidon_MoveGuardClear
Conditions:
    Not:
        Var(MoveGuard) == 0

# CALCULATING. encstoreprediction's real AI_FLAG_PREDICT_MOVE answer, armed at TurnOpen once
# Analysis hits 3. Self-disables through PredictActive, which both arms clear.
Trigger: OnMoveEnd
Priority: 3
Script: EncScript_Miraidon_PredictHit
Conditions:
    Event.Target == B_POSITION_PLAYER_LEFT
    Var(PredictActive) == 1
    Any:
        All:
            Event.MoveCategory == DAMAGE_CATEGORY_PHYSICAL
            Var(PredictCat) == 1
        All:
            Event.MoveCategory == DAMAGE_CATEGORY_SPECIAL
            Var(PredictCat) == 2
        All:
            Event.MoveCategory == DAMAGE_CATEGORY_STATUS
            Var(PredictCat) == 3

Trigger: OnMoveEnd
Priority: 4
Script: EncScript_Miraidon_PredictMiss
Conditions:
    Event.Target == B_POSITION_PLAYER_LEFT
    Var(PredictActive) == 1

# Phase 2 - FUTURE ENGINE ONLINE, at both checkpoints (a passive tick can cross 50% with no move
# involved). Once, so whichever fires first permanently disables the other.
Trigger: OnMoveEnd
Priority: 2
Flags: Once, OnEnter
Script: EncScript_Miraidon_Phase2
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 0

Trigger: OnTurnEnd
Priority: 2
Flags: Once, OnEnter
Script: EncScript_Miraidon_Phase2
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 0

Trigger: OnTurnStart
Priority: 3
Script: EncScript_Miraidon_OverclockStart
Conditions:
    Var(Phase) >= 1
    Var(Analysis) == 6
    Var(Nodes) >= 2
    Var(OverclockTurns) == 0

Trigger: OnTurnEnd
Priority: 12
Flags: OnEnter
Script: EncScript_Miraidon_OverclockShutdown
Conditions:
    Var(OverclockTurns) == 0
    Var(Nodes) == 0

# Phase 3 - PARADOX COLLAPSE.
Trigger: OnMoveEnd
Priority: 2
Flags: Once, OnEnter
Script: EncScript_Miraidon_Phase3
Conditions:
    Battler(Boss).HpPercent <= 20
    Var(Phase) == 1

Trigger: OnTurnEnd
Priority: 2
Flags: Once, OnEnter
Script: EncScript_Miraidon_Phase3
Conditions:
    Battler(Boss).HpPercent <= 20
    Var(Phase) == 1

Trigger: OnTurnStart
Priority: 4
Flags: OnEnter
Script: EncScript_Miraidon_SystemFailureStart
Conditions:
    Var(Phase) == 2
    Var(ErrorCount) >= 3
    Var(ErrorActive) == 0

# PARADOX DRIVE - the finisher, once, at either checkpoint.
Trigger: OnMoveEnd
Priority: 1
Flags: Once, OnEnter
Script: EncScript_Miraidon_ParadoxDrive
Conditions:
    Battler(Boss).HpPercent <= 15
    Var(Phase) == 2

Trigger: OnTurnEnd
Priority: 1
Flags: Once, OnEnter
Script: EncScript_Miraidon_ParadoxDrive
Conditions:
    Battler(Boss).HpPercent <= 15
    Var(Phase) == 2

# Catch window - Balls unlock at 10%, guideline 10.
Trigger: OnMoveEnd
Priority: 2
Flags: Once, OnEnter
Script: EncScript_Miraidon_CatchWindow
Conditions:
    Battler(Boss).HpPercent <= 10

Trigger: OnTurnEnd
Priority: 2
Flags: Once, OnEnter
Script: EncScript_Miraidon_CatchWindow
Conditions:
    Battler(Boss).HpPercent <= 10
