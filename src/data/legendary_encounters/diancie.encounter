Encounter: Diancie

# Diancie, "The Jewel Pokemon". One rule: FACETS (0-6) is the lattice - it drives damage reduction,
# Phase 2+ healing, and Diamond Storm's power. Facets grow automatically (every few turns, on a
# landed Rock/Fairy hit, on a player faint) and can only be broken by dealing >=5% of Diancie's max
# HP in a single turn - chip damage never accumulates across turns.
#   Phase 1 Crystal Growth (100-50%) - facets grow every 3 turns; Encase locks the field at 4+
#     facets; Diamond Storm charges at 6.
#   Phase 2 Jewel of Life (50-25%) - permanent Misty Terrain; growth every 2 turns; facets heal
#     Diancie; Storm charges at 5.
#   Phase 3 Mega Diancie (25-10%) - Mega Evolves, facets snap to 6, Cataclysm (Storm Tier 2) begins
#     a 4-turn fuse immediately.
#   Phase 4 Spent (<=10%) - guard torn down, the catch window.
# Diamond Storm is the burst window: while charging, guard drops 25 points, so breaking facets
# during the fuse is the intended play; each facet broken during a charge shrinks the storm's
# payload, and enough breaks collapses it into a harmless backfire instead.
# Anti-abuse is narrow (guideline 8): Immunities close the OHKO/fixed-damage/Pain-Split/Destiny-Bond
# holes DamageReduction/Survive leave open; CapTypeEffectiveness stops a 4x Rock hit from spiking
# past the reduction's balance; FlatToxicDamage keeps a long fight from being outlasted by ramp.
Properties:
    Level: LevelCap
    CatchRate: 15
    Balls: Blocked
    DamageReduction: 88          # authored seed only; EncScript_Diancie_Guard rewrites it live
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo
    CapTypeEffectiveness: True
    FlatToxicDamage: True
    Survive: True
    Ability: ABILITY_CLEAR_BODY
    Moves: MOVE_POWER_GEM, MOVE_MOONBLAST, MOVE_STONE_EDGE, MOVE_ANCIENT_POWER
    AiFlags: AI_FLAG_SMART_TRAINER

# Always-true block: pins the variable numbering the battle scripts hard-code. encounterproc assigns
# each Var() an index in first-appearance order.
# 0 Phase (1 Crystal Growth / 2 Jewel of Life / 3 Mega / 4 Spent), 1 Facets (0-6),
# 2 Band (last ANNOUNCED band: 0=0-2, 1=3-4, 2=5-6), 3 TurnGuard (once-per-turn scaffold),
# 4 Mark (HP% snapshot at turn open; damage-since-mark after ENC_SNAP_DAMAGE), 5 Growth (turns
# since last facet growth), 6 Charge (Storm fuse; 0 idle), 7 StormTier (0 none / 1 Diamond Storm /
# 2 Cataclysm), 8 Broken (facets broken during the current charge), 9 Encase (remaining encase
# turns), 10 MoveLatch (Rock/Fairy growth re-entry latch), 11 FaintLatch (faint growth re-entry
# latch).
Trigger: OnBattleStart
Priority: 1
Flags: Once
Script: EncScript_Diancie_Awakens
Conditions:
    Var(Phase) >= 0
    Var(Facets) >= 0
    Var(Band) >= 0
    Var(TurnGuard) >= 0
    Var(Mark) >= 0
    Var(Growth) >= 0
    Var(Charge) >= 0
    Var(StormTier) >= 0
    Var(Broken) >= 0
    Var(Encase) >= 0
    Var(MoveLatch) >= 0
    Var(FaintLatch) >= 0

# Phase transitions, duplicated at OnMoveEnd/OnTurnEnd so move damage and passive HP ticks both
# trigger them. Once, OnEnter - the first crossing disables the pair permanently.
Trigger: OnMoveEnd
Priority: 5
Flags: Once, OnEnter
Script: EncScript_Diancie_JewelOfLife
Conditions:
    Battler(Boss).HpPercent <= 70
    Var(Phase) == 1

Trigger: OnTurnEnd
Priority: 5
Flags: Once, OnEnter
Script: EncScript_Diancie_JewelOfLife
Conditions:
    Battler(Boss).HpPercent <= 70
    Var(Phase) == 1

Trigger: OnMoveEnd
Priority: 6
Flags: Once, OnEnter
Script: EncScript_Diancie_Mega
Conditions:
    Battler(Boss).HpPercent <= 40
    Var(Phase) == 2

Trigger: OnTurnEnd
Priority: 6
Flags: Once, OnEnter
Script: EncScript_Diancie_Mega
Conditions:
    Battler(Boss).HpPercent <= 40
    Var(Phase) == 2

Trigger: OnMoveEnd
Priority: 7
Flags: Once, OnEnter
Script: EncScript_Diancie_Spent
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 3

Trigger: OnTurnEnd
Priority: 7
Flags: Once, OnEnter
Script: EncScript_Diancie_Spent
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 3

# The once-per-turn scaffold. TurnGuard is the only gate and the script sets it immediately.
Trigger: OnTurnStart
Priority: 20
Script: EncScript_Diancie_Turn
Conditions:
    Var(TurnGuard) == 0

Trigger: OnTurnEnd
Priority: 20
Script: EncScript_Diancie_Resolve
Conditions:
    Var(TurnGuard) == 1

# Diancie lands a Rock or Fairy move on the player - self-disabling through MoveLatch, cleared by
# _Resolve.
Trigger: OnMoveEnd
Priority: 30
Script: EncScript_Diancie_Radiance
Conditions:
    Event.Target == B_POSITION_OPPONENT_LEFT
    Event.Battler == B_POSITION_PLAYER_LEFT
    Var(MoveLatch) == 0
    Var(Phase) <= 3
    Any:
        Event.MoveType == TYPE_ROCK
        Event.MoveType == TYPE_FAIRY

# A player Pokemon faints - self-disabling through FaintLatch, cleared by _Resolve.
Trigger: OnFaint
Priority: 30
Script: EncScript_Diancie_Drink
Conditions:
    Event.Battler == B_POSITION_PLAYER_LEFT
    Var(FaintLatch) == 0
    Var(Phase) <= 3
