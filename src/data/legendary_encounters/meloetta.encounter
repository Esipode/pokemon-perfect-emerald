Encounter: Meloetta

# Meloetta, "The Melody Pokemon". One rule, stated in both directions:
#   MELOETTA IS SINGING A BAR, AND THE BAR HAS SOFT BEATS AND A HARD BEAT. The meter does not change
#   how hard Meloetta is to hurt - it changes how much of the bar is the hard beat.
#     RHYTHM/TEMPO 0-1   VERSE VERSE VERSE CHORUS     three soft beats
#     RHYTHM/TEMPO 2-3   VERSE VERSE CHORUS CHORUS    two
#     RHYTHM/TEMPO 4     VERSE CHORUS CHORUS CHORUS   one
#     RHYTHM/TEMPO 5     CHORUS CHORUS CHORUS CHORUS  the song never comes back down
#                     VERSE  CHORUS
#     Phase 0           84      93
#     Phase 1           86      95
#     Phase 2         a flat 82, no beat - the song has stopped
#     charging a CRESCENDO +3 on whichever beat is running
#     STUMBLING (a broken crescendo) a flat 72 for one whole turn - the biggest window in the fight
#   THE BAR OWNS THE GUARD. Every shipped sibling owns its guard from the phase (Terrakion,
#   Cobalion), the meter (Virizion), the meter and the phase together (Kyurem) or a transient state
#   (Keldeo's duel). Meloetta's is owned by a COUNT the player can read in advance: the window is on
#   a schedule, it is announced every turn, and the player controls how wide it is.
# TWO METERS, 0-5, one per form. RHYTHM is Aria's, TEMPO is Pirouette's; the inactive one is parked
#   and the active one is mirrored into Meter, which is what every comparison reads.
#     +1  the player's active Pokemon lost >= 6% of its max HP this turn (the action connected)
#     +1  the player's Pokemon fainted this turn (the hall falls silent)
#     -2  a RHYTHM BREAK, and the bar restarts at beat 1
#     ->0 a broken CRESCENDO empties both meters
#     ->2 a resolved CRESCENDO drops both meters to 2 (the song restarts after the finale)
#   A RHYTHM BREAK fires at turn close on any of three routes: Meloetta carries a status condition,
#   the player protected, or the player's Pokemon lost < 6% of its max HP (a miss, an immunity, a
#   switch into a wall, a status move, a sleeping Meloetta - one test, read the other way round).
# WHAT THE METER BUYS: 2 tightens the bar; 3 tightens it further and the refrain CHIPS the player's
#   side on every chorus beat (and in Pirouette raises Meloetta's critical-hit ratio); 4 leaves one
#   verse beat, chips harder, and in Pirouette adds a FOLLOW-UP strike; 5 makes the whole bar chorus
#   and shifts Aria into Pirouette. RHYTHM 5 and TEMPO 5 together begin a CRESCENDO. Nothing here is
#   granted as a stat stage, so a meter falling two levels in one turn needs no teardown path.
# ANTI-ABUSE IS DISPLACEMENT, NOT IMMUNITY (guideline 8). Status is REWARDED - it breaks the rhythm
#   every turn it holds - but from Phase 1 every form shift sheds it and the forms shift on their
#   own every second beat, so it has to be re-applied around the cycle. Protect breaks the rhythm
#   too, and a protected turn deals no damage of its own while the chip and the finale come off max
#   HP regardless. Every crescendo opens by wiping the player's stat stages. Toxic is flat.
Properties:
    Level: LevelCap
    CatchRate: 0                # none; EncScript_Meloetta_Spent sets a real one
    Balls: Blocked
    DamageReduction: 84         # the VERSE value, Phase 0 - the softest Meloetta ever is. Every
                                # later value is written absolutely by
                                # EncScript_Meloetta_ApplyStance, which _Intro calls on turn 0
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo
    CapTypeEffectiveness: True
    FlatToxicDamage: True
    Survive: True               # so an oversized hit cannot skip the Final Note or the catch
                                # window. Cleared in _Spent
    Ability: ABILITY_SERENE_GRACE   # its own, and chosen because BOTH forms have it: encformchange
                                    # takes the ability from the new species, so an off-list one
                                    # would silently evaporate at the first shift
    Moves: MOVE_PSYCHIC, MOVE_HYPER_VOICE, MOVE_ECHOED_VOICE, MOVE_SHADOW_BALL
    AiFlags: AI_FLAG_SMART_TRAINER

# Always-true block: pins the variable numbering the battle scripts hard-code. encounterproc assigns
# each Var() an index in first-appearance order, so naming all sixteen here in order fixes
# Phase..StatusBreak to 0..15. No var-to-var comparison appears anywhere in this design; every test
# is against a literal, and ENC_SNAP_DAMAGE is the engine's own answer to "subtract one value from
# another".
# 0 Phase (0 Overture / 1 Grand Performance / 2 The Final Note / 3 Spent), 1 Meter (the live meter,
# 0-5; mirrors whichever park var the active form owns), 2 Rhythm (Aria's parked meter),
# 3 Tempo (Pirouette's parked meter), 4 Form (0 Aria / 1 Pirouette), 5 Beat (bar position, 1-4),
# 6 TurnGuard (the once-per-turn scaffold), 7 PlayerMark (the player's HP% at turn open),
# 8 Scratch (the copy ENC_SNAP_DAMAGE consumes; afterwards, the HP% the player lost this turn),
# 9 Charge (0 none / 2-1 turns left on a crescendo / 9 stumbling), 10 LastCall (the last ANNOUNCED
# beat state - 1 verse / 2 chorus / 3 gathering / 4 quiet), 11 LastMeter (the last ANNOUNCED meter
# level), 12 BeatClass (0 verse / 1 chorus - written by _ClassifyBeat, the one place the bar is
# read), 13 EventGuard (per-turn guard shared by OnFaint and OnSwitchIn), 14 Encore (finales already
# performed), 15 StatusBreak (a break requested by a condition a script cannot test itself).
Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_Meloetta_Intro
Conditions:
    Var(Phase) >= 0
    Var(Meter) >= 0
    Var(Rhythm) >= 0
    Var(Tempo) >= 0
    Var(Form) >= 0
    Var(Beat) >= 0
    Var(TurnGuard) >= 0
    Var(PlayerMark) >= 0
    Var(Scratch) >= 0
    Var(Charge) >= 0
    Var(LastCall) >= 0
    Var(LastMeter) >= 0
    Var(BeatClass) >= 0
    Var(EventGuard) >= 0
    Var(Encore) >= 0
    Var(StatusBreak) >= 0

# The three phase transitions. Each is registered at both checkpoints because the blow that crosses
# a threshold can be a move or an end-of-turn tick; both copies are Once, which is marked at
# SELECTION, so whichever fires first permanently disables the other. All three sit below _TurnClose
# (80), so at an OnTurnEnd where the player's damage crossed a threshold the transition runs first
# and the ledger sees the new Phase.
Trigger: OnMoveEnd
Priority: 5
Flags: Once, OnEnter
Script: EncScript_Meloetta_GrandPerformance
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 0

Trigger: OnTurnEnd
Priority: 5
Flags: Once, OnEnter
Script: EncScript_Meloetta_GrandPerformance
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 0

Trigger: OnMoveEnd
Priority: 6
Flags: Once, OnEnter
Script: EncScript_Meloetta_FinalNote
Conditions:
    Battler(Boss).HpPercent <= 15
    Var(Phase) == 1

Trigger: OnTurnEnd
Priority: 6
Flags: Once, OnEnter
Script: EncScript_Meloetta_FinalNote
Conditions:
    Battler(Boss).HpPercent <= 15
    Var(Phase) == 1

Trigger: OnMoveEnd
Priority: 7
Flags: Once, OnEnter
Script: EncScript_Meloetta_Spent
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 2

Trigger: OnTurnEnd
Priority: 7
Flags: Once, OnEnter
Script: EncScript_Meloetta_Spent
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 2

# The once-per-turn scaffold. TurnGuard is its only gate and the script sets it immediately, so no
# branch out of it can leave it re-armed. It takes the mark the turn is measured against, ticks the
# crescendo countdown (the decrement half of the split), re-asserts the critical-hit ratio
# absolutely, lands the new beat's guard and calls the beat.
Trigger: OnTurnStart
Priority: 10
Script: EncScript_Meloetta_TurnOpen
Conditions:
    Var(Phase) <= 2
    Var(TurnGuard) == 0

# THE CRESCENDO telegraph. Announced before the player picks a move, so the turn can be spent on the
# answer. Self-disabling: the script sets Charge.
Trigger: OnTurnStart
Priority: 14
Script: EncScript_Meloetta_BeginCrescendo
Conditions:
    Var(Phase) <= 1
    Var(Charge) == 0
    Var(Rhythm) == 5
    Var(Tempo) == 5

# The hall falls silent - one of the player's Pokemon fainted. EventGuard stops the replacement's
# switch-in being processed a second time against the same faint.
Trigger: OnFaint
Priority: 30
Script: EncScript_Meloetta_Silence
Conditions:
    Var(EventGuard) == 0
    Var(TurnGuard) == 1
    Var(Phase) <= 1
    Event.Battler == B_POSITION_PLAYER_LEFT

# TurnGuard == 1 is load-bearing: OnSwitchIn fires for the player's lead BEFORE OnBattleStart, when
# every var is still 0. Sets EventGuard and nothing else.
Trigger: OnSwitchIn
Priority: 31
Script: EncScript_Meloetta_TheyEntered
Conditions:
    Var(EventGuard) == 0
    Var(TurnGuard) == 1
    Var(Phase) <= 1
    Event.Battler == B_POSITION_PLAYER_LEFT

# The two break routes a SCRIPT cannot test for itself. There is no encjumpifprotected and no
# encjumpifstatus, so each is expressed as a condition on its own trigger, and both write the same
# request flag that _TurnClose and _Resolve read. StatusBreak == 0 is what self-disables them - the
# Event-free conditions they test stay true for the whole dispatch, so Once (once per BATTLE) and
# OnEnter (an HP edge) would both be wrong.
Trigger: OnTurnEnd
Priority: 77
Script: EncScript_Meloetta_BreakRequest
Conditions:
    Var(StatusBreak) == 0
    Var(TurnGuard) == 1
    Var(Phase) <= 1
    Battler(PlayerLeft).Protected == 1

Trigger: OnTurnEnd
Priority: 78
Script: EncScript_Meloetta_BreakRequest
Conditions:
    Var(StatusBreak) == 0
    Var(TurnGuard) == 1
    Var(Phase) <= 1
    Battler(Boss).Status != STATUS1_NONE

# THE LEDGER, and the only place the turn's subsystems resolve. One script rather than six triggers:
# the ledger, the chorus chip, the follow-up, both form routes, the beat advance and the two
# callouts plus a phase transition would sit one script away from the documented 8-per-checkpoint
# cap. Self-disables by clearing TurnGuard.
Trigger: OnTurnEnd
Priority: 80
Script: EncScript_Meloetta_TurnClose
Conditions:
    Var(TurnGuard) == 1

# THE CRESCENDO resolves. Runs after _TurnClose (80) has written Scratch - the number its interrupt
# test reads - and cleared TurnGuard, hence the TurnGuard == 0 here. Self-disabling: the script
# writes Charge.
Trigger: OnTurnEnd
Priority: 88
Script: EncScript_Meloetta_Resolve
Conditions:
    Var(Charge) == 1
    Var(TurnGuard) == 0
