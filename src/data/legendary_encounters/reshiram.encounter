Encounter: Reshiram

# Reshiram, "The Vast White Pokemon". One rule:
#   RESHIRAM LEARNS YOU. Everything the player does is information, and information is the only
#   currency in this fight. REVELATION, 0-5, owns the damage reduction: the more Reshiram
#   understands, the less anything done to it matters.
# THE METER FLIPS DIRECTION AT PHASE 1, and that reversal is the fight.
#   Phase 0 THE OBSERVER - Revelation climbs on its own (+1 a turn). The player can only slow it:
#     hit hard (>= 10% of Reshiram's max HP in a turn is -1) and stop repeating themselves.
#   Phase 1 THE TRUTH REVEALED - Revelation is forced to 5 and stops climbing by itself. Now it is
#     the player's to grind down: varying attacks is -1, repeating or switching is +1, pressure is
#     another -1. Grinding it below 3 shuts the Blue Flare cycle off entirely.
#   Phase 2 THE TRUTH CANNOT BE HIDDEN - it stops defending and starts burning. Guard drops to a
#     flat 88, WHITE LIGHT is raised, and it commits to one final judgment.
#   Phase 3 SPENT - the catch window.
# FEEDING IT: Revelation rises on a repeated attack CATEGORY (an author variable is a u8 and a move
#   id does not fit in one, so the pattern stored is the AI's own predicted category) and on a
#   switch. Both are things the player can watch themselves doing.
# REVEAL is the visible half: encstoreprediction returns the real AI_FLAG_PREDICT_MOVE answer, so
#   Reshiram announces what it read and raises the matching defence for the turn. The counter is
#   obvious once seen - change category - and the AI flag is mandatory, not cosmetic: without it
#   encstoreprediction writes 0 every turn and Reveal is silently dead.
# ANTI-ABUSE IS NARROW (guideline 8). Status lands and works COMPLETELY through Phases 0 and 1;
#   WHITE LIGHT displaces it once, at 15% HP, and never again. Substitute is a real option rather
#   than a wall: MOVE_HYPER_VOICE is sound-based and every scripted payload is a direct HP write.
#   Setup, screens, hazards and items are answered by EXPOSE and TRUTH FLAME, evasion by Gravity
#   plus a per-turn scour, and defensive abilities by Turboblaze itself.
Properties:
    Level: LevelCap
    CatchRate: 0                # none; EncScript_Reshiram_Spent sets a real one
    Balls: Blocked
    DamageReduction: 86         # UNREAD, Phase 0 - the softest Reshiram ever is outside a charge.
                                # Every later value is written absolutely by
                                # EncScript_Reshiram_ApplyStance, which _Intro calls on turn 0
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo
    CapTypeEffectiveness: True  # Fire/Dragon takes 4x from Rock; a single hit would otherwise spike
                                # well past what the reduction was balanced around
    FlatToxicDamage: True
    Survive: True               # Phase 2 must run its Judgment to completion for Phase 3 to exist,
                                # and the catch window is the only way this fight is meant to end.
                                # Cleared in _Spent
    Ability: ABILITY_TURBOBLAZE # its own, and the fight's thesis in ability form: the target's
                                # ability is ignored, so Flash Fire, Levitate, Water Absorb and
                                # Wonder Guard stop being answers. A Pokemon that sees through your
                                # strategy sees through that too
    Moves: MOVE_DRAGON_PULSE, MOVE_FLAMETHROWER, MOVE_EXTRASENSORY, MOVE_HYPER_VOICE
    AiFlags: AI_FLAG_SMART_TRAINER | AI_FLAG_PREDICT_MOVE

# MOVE_HYPER_VOICE is the deliberate anti-Substitute slot and a legal Reshiram level-up move.
# MOVE_EXTRASENSORY is the "reading you" flavour slot and the one Phase 1 swaps for MOVE_FUSION_FLARE
# via encsetmove. MOVE_BLUE_FLARE never enters the moveset: both Blue Flare sequences are scripted,
# telegraphed percentage payloads, and an AI able to fire the same-named move at will alongside them
# would make the telegraph meaningless.

# Always-true block: pins the variable numbering the battle scripts hard-code. encounterproc assigns
# each Var() an index in first-appearance order, so naming all sixteen here in order fixes
# Phase..CueTick to 0..15. Every test is against a literal; ENC_SNAP_DAMAGE is the engine's own
# answer to "subtract one value from another".
# 0 Phase (0 Observer / 1 Truth Revealed / 2 White Light / 3 Spent), 1 Rev (REVELATION, 0-5),
# 2 LastBand (the last ANNOUNCED band - the callout's re-fire latch), 3 TurnGuard (the once-per-turn
# scaffold), 4 BossMark (Reshiram's HP% at turn open), 5 Scratch (the copy ENC_SNAP_DAMAGE consumes,
# so BossMark survives being measured; reused by the ledger as "the meter went the player's way"),
# 6 Read (this turn's predicted category: 0 unset / 1 physical / 2 special / 3 status / 9 the AI
# declined to answer), 7 LastRead (last turn's, for the repeat test), 8 Fed (the player handed it
# information this turn), 9 MarkDepth (TRUTH MARK depth, 0-3), 10 Flame (turns until the next TRUTH
# FLAME), 11 Charge (0 none / 1-3 turns left on a charge / 9 the Judgment has resolved),
# 12 EventGuard (per-turn guard for OnSwitchIn), 13 Pressure (the player took >= 10% of Reshiram's
# max HP off this turn), 14 Exposed (EXPOSE cooldown), 15 CueTick (alternates the recurring cue).
Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_Reshiram_Intro
Conditions:
    Var(Phase) >= 0
    Var(Rev) >= 0
    Var(LastBand) >= 0
    Var(TurnGuard) >= 0
    Var(BossMark) >= 0
    Var(Scratch) >= 0
    Var(Read) >= 0
    Var(LastRead) >= 0
    Var(Fed) >= 0
    Var(MarkDepth) >= 0
    Var(Flame) >= 0
    Var(Charge) >= 0
    Var(EventGuard) >= 0
    Var(Pressure) >= 0
    Var(Exposed) >= 0
    Var(CueTick) >= 0

# The three phase transitions. Each is registered at both checkpoints because the blow that crosses a
# threshold can be a move or an end-of-turn tick; both copies are Once, which is marked at SELECTION,
# so whichever fires first permanently disables the other. All three sit BELOW _TurnClose (80), so at
# an OnTurnEnd where the player's damage crossed a threshold the transition runs first and the ledger
# sees the new Phase.
Trigger: OnMoveEnd
Priority: 5
Flags: Once, OnEnter
Script: EncScript_Reshiram_TruthRevealed
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 0

Trigger: OnTurnEnd
Priority: 5
Flags: Once, OnEnter
Script: EncScript_Reshiram_TruthRevealed
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 0

Trigger: OnMoveEnd
Priority: 6
Flags: Once, OnEnter
Script: EncScript_Reshiram_WhiteLight
Conditions:
    Battler(Boss).HpPercent <= 15
    Var(Phase) == 1

Trigger: OnTurnEnd
Priority: 6
Flags: Once, OnEnter
Script: EncScript_Reshiram_WhiteLight
Conditions:
    Battler(Boss).HpPercent <= 15
    Var(Phase) == 1

# The deadlock fallback. Survive: True pins Reshiram at 1 HP, so a player who grinds Phase 2 down
# before the Judgment lands still reaches the catch window.
Trigger: OnMoveEnd
Priority: 7
Flags: Once
Script: EncScript_Reshiram_Spent
Conditions:
    Battler(Boss).HpPercent <= 1
    Var(Phase) == 2

Trigger: OnTurnEnd
Priority: 7
Flags: Once
Script: EncScript_Reshiram_Spent
Conditions:
    Battler(Boss).HpPercent <= 1
    Var(Phase) == 2

# The once-per-turn scaffold. TurnGuard is the only gate and the script sets it immediately, so no
# branch out of it can leave the trigger re-armed.
Trigger: OnTurnStart
Priority: 10
Script: EncScript_Reshiram_TurnOpen
Conditions:
    Var(Phase) <= 2
    Var(TurnGuard) == 0

# REVEAL. Self-disabling through Read, which _TurnOpen clears: the script always leaves it non-zero,
# writing 9 on the turns the AI declines to answer, so the trigger cannot re-select.
Trigger: OnTurnStart
Priority: 14
Script: EncScript_Reshiram_Reveal
Conditions:
    Var(Phase) <= 2
    Var(Rev) >= 1
    Var(Read) == 0

# EXPOSE, the targeted strip. Phases 0-1 only - Phase 2 does its own scouring every turn.
# Self-disabling through Exposed, which the script sets on every path.
Trigger: OnTurnStart
Priority: 15
Script: EncScript_Reshiram_Expose
Conditions:
    Var(Phase) <= 1
    Var(Rev) >= 2
    Var(Exposed) == 0

# TRUTH MARK is laid once and then deepens at the ledger. Self-disabling through MarkDepth, which
# _AttentionShifts resets to 1 rather than 0 when somebody new walks in.
Trigger: OnTurnStart
Priority: 16
Script: EncScript_Reshiram_Mark
Conditions:
    Var(Phase) <= 2
    Var(Rev) >= 3
    Var(MarkDepth) == 0

# BLUE FLARE, telegraphed before the player picks a move so the turn can be spent on the answer.
# Rev >= 3 is the reward the phase is built around: grind the meter below 3 and the cycle never
# opens. Self-disabling through Charge.
Trigger: OnTurnStart
Priority: 17
Script: EncScript_Reshiram_BeginCharge
Conditions:
    Var(Phase) == 1
    Var(Rev) >= 3
    Var(Charge) == 0

# Somebody walked in - that is information, and Reshiram re-marks whoever is standing there.
# TurnGuard == 1 is load-bearing: OnSwitchIn fires for the player's lead BEFORE OnBattleStart, when
# every variable is still 0.
Trigger: OnSwitchIn
Priority: 30
Script: EncScript_Reshiram_AttentionShifts
Conditions:
    Var(Phase) <= 2
    Var(EventGuard) == 0
    Var(TurnGuard) == 1
    Event.Battler == B_POSITION_PLAYER_LEFT

# THE LEDGER, and the only place the turn's subsystems resolve. One script with internal branching
# rather than six triggers, to stay clear of the 8-scripts-per-checkpoint cap. Self-disables by
# clearing TurnGuard.
Trigger: OnTurnEnd
Priority: 80
Script: EncScript_Reshiram_TurnClose
Conditions:
    Var(TurnGuard) == 1

# TRUTH'S JUDGMENT has resolved. Runs after the ledger that fired it.
Trigger: OnTurnEnd
Priority: 88
Flags: Once
Script: EncScript_Reshiram_Spent
Conditions:
    Var(Phase) == 2
    Var(Charge) == 9
