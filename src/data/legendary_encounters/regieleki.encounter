Encounter: Regieleki

# Regieleki, "The Electrified Pokemon". One rule:
#   THE CHARGE METER (0-10) OWNS EVERYTHING. It rises from Regieleki attacking, being hit by
#   Electric moves, the player switching, turns passing, Electric Terrain, and Regieleki moving
#   first. It falls only when the player lands a damaging hit - the one brake on the loop. High
#   CHARGE raises an Overcharge tier (faster/harder-hitting/frailer) and risks Flash Step, a bonus
#   burst that feeds CHARGE further - a runaway only a landed hit interrupts.
# Phase 0 (100% -> 50%): the CHARGE/Overcharge/Flash Step loop, live from turn 1.
# Phase 1, Grid Expansion (HP <= 50%): CHARGE accrual from Regieleki's own attacks doubles; a
#   one-turn Power Surge window opens the instant the phase begins.
# Phase 2, Critical Overload (HP <= 15%): CHARGE forced to 10, Overcharge locked at Tier 2, then
#   Electro Drift fires once and the grid collapses (CHARGE -> 0, reduction craters to 60).
#   Balls unlock at HP <= 10%.
# ANTI-ABUSE (guideline 8): passive play - status moves, switching, stalling - only feeds CHARGE.
#   There is no safe way to wait this fight out, and the Power Surge window punishes standing
#   still specifically: doing nothing is the worst outcome (a full-strength surge), not a neutral
#   one.
# PLAN DEVIATIONS from docs Regieleki plan (Gen 8):
#   - Event.MoveCategory/Event.MoveType can only be read from a Condition, never inside a script
#     (confirmed against galarian_articuno.inc/uxie.inc). The plan's single PlayerHitBoss script
#     is split into per-category (Physical/Special) and per-type (Ground/other) trigger pairs,
#     each baking its own literal into the shared PlayerCat/PlayerType vars. This adds one guard
#     var (TypeGuard) beyond the plan's 12.
#   - Terrain likewise can't be read inside a script; the "+1 CHARGE on Electric Terrain" tick is
#     its own OnTurnStart trigger (TerrainCharge) gated on the same TurnStartGuard, running at a
#     lower priority than TurnTally so both fire in the same first pass before the guard closes.
#   - TierUp1/TierUp2/TierDown write Overcharge's stat stages and damage reduction through a
#     single absolute-write subroutine keyed only on the current Tier (guideline: "one writer per
#     number"), rather than incremental per-transition deltas - so TierDown always lands on the
#     correct total regardless of which tier it fell from.
#   - BallsUnlock (HP <= 10%) has no Phase gate in the plan's trigger table and can in principle
#     fire in the same OnMoveEnd dispatch as Electro Drift's telegraph (an overkill hit crossing
#     both 15% and 10% at once), before Electro Drift's own COLLAPSE line would announce the catch
#     window. It carries its own short line for that case - one string beyond the plan's ten.
Properties:
    Level: LevelCap
    CatchRate: 3
    Balls: Blocked
    DamageReduction: 96
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo
    CapTypeEffectiveness: True
    FlatToxicDamage: True
    Survive: True
    Ability: ABILITY_TRANSISTOR
    Moves: MOVE_THUNDERBOLT, MOVE_ELECTROWEB, MOVE_QUICK_ATTACK, MOVE_VOLT_SWITCH
    AiFlags: AI_FLAG_SMART_TRAINER

# Always-true block: pins the variable numbering the battle scripts hard-code. encounterproc
# assigns each Var() an index in first-appearance order, so naming all fourteen here in order
# fixes Charge..FlashStepGuard to 0..13.
# 0 Charge (0-10 meter), 1 Phase (0/1/2), 2 Tier (Overcharge tier, 0/1/2),
# 3 TurnStartGuard (once-per-turn scaffold), 4 MoveGuard (boss-attack-connects, once/turn),
# 5 ElecGuard (boss-hit-by-Electric, once/turn), 6 SwitchGuard (player-switched, once/turn),
# 7 HitGuard (player-hit-boss with a damaging move, once/turn), 8 Scratch (enccomparestat result),
# 9 SurgeWindow (Power Surge turn active, 0/1), 10 PlayerCat (this turn's player move category
# on the boss, sentinel DAMAGE_CATEGORY_STATUS=3 if no damaging hit landed), 11 PlayerType (this
# turn's player move type on the boss, sentinel TYPE_MYSTERY=10 if nothing landed), 12 TypeGuard
# (once-per-turn scaffold for the type-observation triggers), 13 FlashStepGuard (once-per-turn
# scaffold for Flash Step - a miss leaves Tier at 2, so the trigger needs its own latch or it
# re-selects every pass at OnTurnEnd until the runaway-script guard trips).
Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_Regieleki_Intro
Conditions:
    Var(Charge) >= 0
    Var(Phase) >= 0
    Var(Tier) >= 0
    Var(TurnStartGuard) >= 0
    Var(MoveGuard) >= 0
    Var(ElecGuard) >= 0
    Var(SwitchGuard) >= 0
    Var(HitGuard) >= 0
    Var(Scratch) >= 0
    Var(SurgeWindow) >= 0
    Var(PlayerCat) >= 0
    Var(PlayerType) >= 0
    Var(TypeGuard) >= 0
    Var(FlashStepGuard) >= 0

# The once-per-turn scaffold. TerrainCharge sits below TurnTally so both are eligible in the same
# first pass (neither writes TurnStartGuard itself except TurnTally, which closes both).
Trigger: OnTurnStart
Priority: 5
Script: EncScript_Regieleki_TerrainCharge
Conditions:
    Terrain == B_TERRAIN_ELECTRIC
    Var(TurnStartGuard) == 0

Trigger: OnTurnStart
Priority: 10
Script: EncScript_Regieleki_TurnTally
Conditions:
    Var(TurnStartGuard) == 0

# Regieleki attacking connects.
Trigger: OnMoveEnd
Priority: 14
Script: EncScript_Regieleki_BossAttacked
Conditions:
    Event.Target == B_POSITION_OPPONENT_LEFT
    Var(MoveGuard) == 0

# Regieleki takes an Electric hit.
Trigger: OnMoveEnd
Priority: 15
Script: EncScript_Regieleki_ElectricHit
Conditions:
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Event.MoveType == TYPE_ELECTRIC
    Var(ElecGuard) == 0

# The player switches.
Trigger: OnSwitchIn
Priority: 10
Script: EncScript_Regieleki_PlayerSwitched
Conditions:
    Event.Battler == B_POSITION_PLAYER_LEFT
    Var(SwitchGuard) == 0

# --- PlayerHitBoss, split by category (only a damaging hit drains Charge; MoveCategory is
# Condition-only, so each category gets its own trigger baking a literal into PlayerCat). ---
Trigger: OnMoveEnd
Priority: 10
Script: EncScript_Regieleki_PlayerHitBoss_Physical
Conditions:
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Event.MoveCategory == DAMAGE_CATEGORY_PHYSICAL
    Var(HitGuard) == 0

Trigger: OnMoveEnd
Priority: 11
Script: EncScript_Regieleki_PlayerHitBoss_Special
Conditions:
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Event.MoveCategory == DAMAGE_CATEGORY_SPECIAL
    Var(HitGuard) == 0

# --- PlayerType, split by type (any landed hit, damaging or not, can ground the Power Surge). ---
Trigger: OnMoveEnd
Priority: 12
Script: EncScript_Regieleki_PlayerHitBoss_Ground
Conditions:
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Event.MoveType == TYPE_GROUND
    Var(TypeGuard) == 0

Trigger: OnMoveEnd
Priority: 13
Script: EncScript_Regieleki_PlayerHitBoss_OtherType
Conditions:
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Var(TypeGuard) == 0
    Not:
        Event.MoveType == TYPE_GROUND

# Grid Expansion - phase transition at 50% HP.
Trigger: OnMoveEnd
Priority: 5
Flags: Once, OnEnter
Script: EncScript_Regieleki_GridExpansionEnter
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 0

# Critical Overload - phase transition at 15% HP.
Trigger: OnMoveEnd
Priority: 6
Flags: Once, OnEnter
Script: EncScript_Regieleki_CriticalOverloadEnter
Conditions:
    Battler(Boss).HpPercent <= 15
    Var(Phase) == 1

# Balls unlock at 10% HP - no Phase gate; by construction Phase is already 2 by the time HP is
# this low (Critical Overload fires at 15%).
Trigger: OnMoveEnd
Priority: 7
Flags: Once
Script: EncScript_Regieleki_BallsUnlock
Conditions:
    Battler(Boss).HpPercent <= 10

# Overcharge tier ladder - self-disabling: each script writes Tier, which closes its own
# condition. Runs before FlashStep so Flash Step sees this turn's final Tier.
Trigger: OnTurnEnd
Priority: 6
Script: EncScript_Regieleki_TierUp1
Conditions:
    Var(Charge) >= 5
    Var(Tier) < 1

Trigger: OnTurnEnd
Priority: 7
Script: EncScript_Regieleki_TierUp2
Conditions:
    Var(Charge) >= 8
    Var(Tier) < 2

Trigger: OnTurnEnd
Priority: 8
Script: EncScript_Regieleki_TierDown
Conditions:
    Var(Charge) < 5
    Var(Tier) > 0

Trigger: OnTurnEnd
Priority: 9
Script: EncScript_Regieleki_FlashStep
Conditions:
    Var(Tier) == 2
    Var(FlashStepGuard) == 0

# The Power Surge window resolves before ClearGuards clears PlayerCat/PlayerType.
Trigger: OnTurnEnd
Priority: 30
Script: EncScript_Regieleki_SurgeResolve
Conditions:
    Var(SurgeWindow) == 1

# Electro Drift - the Critical Overload finisher. Runs after the tier ladder and Power Surge so
# its collapse is the last word for the dispatch.
Trigger: OnTurnEnd
Priority: 90
Flags: Once
Script: EncScript_Regieleki_ElectroDrift
Conditions:
    Var(Phase) == 2
    Var(Charge) >= 10

# The once-per-turn scaffold's closing half. Last, so it clears guards only after everything else
# this turn has read them.
Trigger: OnTurnEnd
Priority: 95
Script: EncScript_Regieleki_ClearGuards
Conditions:
    Var(TurnStartGuard) == 1
