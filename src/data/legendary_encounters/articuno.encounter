Encounter: Articuno

# Ice Barrier loop: Articuno's Ice moves raise Frost, the player's Fire moves lower it, and while
# Frost >= 1 the barrier regrows every turn - at a strength that scales with Frost - until shattered
# by a damaging hit. Absolute Zero locks Frost (sealing the barrier at its current strength) and
# repurposes the Fire answer into a recurring timer instead.
Properties:
    Level: LevelCap
    CatchRate: 0                # none; the weakened script sets a real one
    Balls: Blocked
    DamageReduction: 80
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo
    CapTypeEffectiveness: True
    FlatToxicDamage: True
    AiFlags: AI_FLAG_SMART_TRAINER
    Moves: MOVE_FREEZE_DRY, MOVE_BLIZZARD, MOVE_DUAL_WINGBEAT, MOVE_ANCIENT_POWER
    Ability: ABILITY_SNOW_CLOAK

# The Conditions here are always true - they exist only to fix the variable numbering.
# encounterproc assigns each Var() an index in the order it first appears in a Conditions block, so
# naming all eleven here, in order, pins Phase..LastBlunt to 0..7 (the indices the battle scripts
# hard-code) regardless of where they are actually used later, and lets the three re-entry guards
# land on 8/9/10. IceGuard/FireGuard/SwitchGuard stop OnMoveEnd/OnSwitchIn triggers, whose Event
# conditions stay true across the re-evaluation loop, from firing more than once per event.
Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_Articuno_Intro
Conditions:
    Var(Phase) >= 0
    Var(Barrier) >= 0
    Var(Plummet) >= 0
    Var(Frost) >= 0
    Var(Chill) >= 0
    Var(FrostLock) >= 0
    Var(Answered) >= 0
    Var(LastBlunt) >= 0
    Var(IceGuard) >= 0
    Var(FireGuard) >= 0
    Var(SwitchGuard) >= 0

Trigger: OnMoveEnd
Priority: 5
Flags: Once, OnEnter
Script: EncScript_Articuno_PhaseFrozenField
Conditions:
    Battler(Boss).HpPercent <= 75
    Var(Phase) == 0

Trigger: OnMoveEnd
Priority: 5
Flags: Once, OnEnter
Script: EncScript_Articuno_AbsoluteZero
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 1

# At OnMoveEnd, Event.Battler is the mon that got hit and Event.Target is the mon that used the
# move (see MoveEndEncounter). Both compare against a battler id: B_POSITION_PLAYER_LEFT is the
# player, B_POSITION_OPPONENT_LEFT is Articuno.
Trigger: OnMoveEnd
Priority: 10
Script: EncScript_Articuno_BarrierShatter
Conditions:
    Var(Barrier) == 1
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Event.Cause == ENC_CAUSE_MOVE_DAMAGE

Trigger: OnMoveEnd
Priority: 20
Script: EncScript_Articuno_IceMove
Conditions:
    Event.Target == B_POSITION_OPPONENT_LEFT
    Event.MoveType == TYPE_ICE
    Var(IceGuard) == 0

Trigger: OnMoveEnd
Priority: 20
Script: EncScript_Articuno_FireResponse
Conditions:
    Event.Target == B_POSITION_PLAYER_LEFT
    Event.MoveType == TYPE_FIRE
    Var(FireGuard) == 0

Trigger: OnTurnStart
Priority: 10
Script: EncScript_Articuno_ShakeOff
Conditions:
    Battler(Boss).Status == STATUS1_SLEEP

Trigger: OnTurnStart
Priority: 20
Script: EncScript_Articuno_PlummetTick
Conditions:
    Var(Plummet) == 2

Trigger: OnTurnStart
Priority: 30
Script: EncScript_Articuno_BarrierRaise
Conditions:
    Var(Phase) >= 1
    Var(Phase) != 3
    Var(Barrier) == 0
    Var(Frost) >= 1

Trigger: OnSwitchIn
Priority: 20
Script: EncScript_Articuno_FrozenGround
Conditions:
    Event.Battler == B_POSITION_PLAYER_LEFT
    Var(SwitchGuard) == 0
    Any:
        Var(Frost) >= 3
        Var(Chill) == 1

Trigger: OnTurnEnd
Priority: 10
Flags: Once
Script: EncScript_Articuno_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10

Trigger: OnTurnEnd
Priority: 20
Script: EncScript_Articuno_PlummetResolve
Conditions:
    Var(Plummet) == 1

# Clears the per-event re-entry guards so each fires again next turn. Self-disabling: once all three
# are 0 the Any is false and it stops.
Trigger: OnTurnEnd
Priority: 30
Script: EncScript_Articuno_TurnReset
Conditions:
    Any:
        Var(IceGuard) == 1
        Var(FireGuard) == 1
        Var(SwitchGuard) == 1
