# =================================================================================================
# ENCOUNTER SHOWCASE (commented out; copy, rename, and uncomment the parts you need)
#
# An encounter is two pieces: this definition chooses WHEN it runs, and a battle-script label
# chooses WHAT it does. Before enabling this example, add its `EncScript_Showcase_*` labels and
# `STRINGID_ENCSHOWCASE_*` text to the appropriate battle-script/string files, then put
# `setbattleencounter ENCOUNTER_SHOWCASE` immediately before the battle it should affect.
#
# This single boss demonstrates every checkpoint, priority/flag mode, author variables, grouped
# conditions, event context, battle-start properties, HP/stat changes, damage reduction and move
# immunities, catching rules, Mega Evolution, trainer presentation, and animation. It is
# intentionally more comprehensive than a production encounter: copy the individual triggers that
# match your design instead of enabling all of them at once.
#
# Encounter: Showcase
#
# # `Properties:` is optional and appears at most once, before the first `Trigger:`. It configures
# # the battle itself at battle start rather than reacting to it; every field may be omitted.
# Properties:
#     Level: LevelCap            # or a literal level; LevelCap tracks story progression
#     CatchRate: 15              # replaces the species' own catch rate (0-255, higher is easier)
#     Balls: Blocked             # Default, Blocked, or Allowed
#     DamageReduction: 70        # the boss takes 70% less damage from every source (max 99)
#     Immunities: Ohko, FixedDamage, HpSwap, SharedKo   # or None / All
#     CapTypeEffectiveness: True # clamps incoming type effectiveness to 2x; no quadruple weaknesses
#     FlatToxicDamage: True      # Toxic deals flat 1/16 max HP every turn instead of ramping up
#     Survive: True              # boss HP can't be taken below 1 via the damage formula/passive ticks
#
# # `OnBattleStart`: introduce the boss once, after all entry effects resolve.
# Trigger: OnBattleStart
# Priority: 10
# Flags: Once
# Script: EncScript_Showcase_Intro
# Conditions:
#     Battler(Boss).Species == SPECIES_RAYQUAZA
#     BattlerCount == 2
#
# # `OnTurnStart`: a repeating reminder/control point. Omitting `Flags:` makes it
# # run each turn while its conditions hold. `Turn` starts at 0, so `Turn >= 3` is the fourth turn.
# Trigger: OnTurnStart
# Priority: 30
# Script: EncScript_Showcase_TurnStart
# Conditions:
#     Turn >= 3
#     Var(TurnStartSeen) == 0
#
# # `OnMoveEnd`: a phase transition the moment HP crosses 50%. `Once, OnEnter` is the usual phase
# # combination. `Event.*` fields below are only valid at the checkpoints documented in the tutorial.
# Trigger: OnMoveEnd
# Priority: 10
# Flags: Once, OnEnter
# Script: EncScript_Showcase_HalfHealth
# Conditions:
#     Battler(Boss).HpPercent <= 50
#     Var(Phase) == 0
#     Event.Battler == B_POSITION_OPPONENT_LEFT   # the boss is the one that got hit
#     Any:
#         Event.Move == MOVE_SURF
#         Event.Move == MOVE_THUNDERBOLT
#         Event.Cause == ENC_CAUSE_MOVE_DAMAGE
#
# # `OnMoveEnd`: react whenever the player uses a particular move. `OnEnter` alone can fire again
# # after the condition becomes false and later true; use this for a repeatable edge, not a phase.
# Trigger: OnMoveEnd
# Priority: 20
# Flags: OnEnter
# Script: EncScript_Showcase_MoveReaction
# Conditions:
#     Event.Target == B_POSITION_PLAYER_LEFT   # the player is the one that used the move
#     Event.Move == MOVE_DRAGON_ASCENT
#     Not:
#         Battler(Boss).Type == TYPE_DRAGON
#
# # `OnFaint`: react after a combatant's faint bookkeeping finishes. `Self` is the event battler.
# Trigger: OnFaint
# Priority: 10
# Flags: Once
# Script: EncScript_Showcase_FaintReaction
# Conditions:
#     Event.Battler == B_POSITION_PLAYER_LEFT   # the fainted battler
#     Var(PlayerFainted) == 0
#
# # `OnSwitchIn`: reward or punish an incoming battler after its own entry effects resolve.
# Trigger: OnSwitchIn
# Priority: 10
# Flags: OnEnter
# Script: EncScript_Showcase_SwitchIn
# Conditions:
#     Battler(Self).Ability == ABILITY_INTIMIDATE
#     Battler(Boss).Status == 0
#
# # `OnTurnEnd`: make a second phase depend on the first. `OldValue`/`NewValue` can inspect an
# # end-of-turn HP/status/weather change; Weather and Terrain read the current field state.
# Trigger: OnTurnEnd
# Priority: 10
# Flags: Once, OnEnter
# Script: EncScript_Showcase_Desperation
# Conditions:
#     Battler(Boss).HpPercent <= 25
#     Var(Phase) == 1
#     Any:
#         Weather == B_WEATHER_RAIN_NORMAL
#         Terrain == STATUS_FIELD_ELECTRIC_TERRAIN
#         Event.OldValue > 50
#         Event.NewValue <= 50
#
# # `OnBattleEnd`: presentation only; the winner is already decided, so do not change battle state.
# Trigger: OnBattleEnd
# Priority: 10
# Flags: Once
# Script: EncScript_Showcase_Outro
# Conditions:
#     Var(Phase) >= 1
#
#
# # Add the following labels to data/battle_scripts_encounters.s. The `Var(...)` names above receive
# # indexes in first-use order: TurnStartSeen = 0, Phase = 1, PlayerFainted = 2. Using numeric
# # indexes here matches the existing encounter scripts. Every encounter script must end in `return`.
#
# EncScript_Showcase_Intro::
#     trainerslidein BS_OPPONENT1
#     printstring STRINGID_ENCSHOWCASEINTRO
#     waitmessage B_WAIT_TIME_LONG
#     trainerslideout BS_OPPONENT1
#     return
#
# EncScript_Showcase_TurnStart::
#     encsetvar 0, 1                         @ TurnStartSeen = true
#     printstring STRINGID_ENCSHOWCASETURNTHREE
#     waitmessage B_WAIT_TIME_SHORT
#     return
#
# EncScript_Showcase_HalfHealth::
#     encsetvar 1, 1                         @ Phase = 1
#     trainerslidein BS_OPPONENT1
#     printstring STRINGID_ENCSHOWCASEBARRIER
#     waitmessage B_WAIT_TIME_LONG
#     trainerslideout BS_OPPONENT1
#     enchangehp ENC_TARGET_BOSS, 25, ENC_AMOUNT_PERCENT   @ positive heals; negative damages
#     encchangestat ENC_TARGET_BOSS, STAT_SPATK, 2         @ stat STAGE, undone by Haze/switching
#     encchangestatvalue ENC_TARGET_BOSS, STAT_SPEED, 20, ENC_AMOUNT_PERCENT   @ raw stat, permanent
#     encsetdamagereduction ENC_TARGET_BOSS, 70
#     encsetimmunity ENC_TARGET_BOSS, ENC_IMMUNE_OHKO | ENC_IMMUNE_FIXED_DAMAGE
#     playanimation BS_OPPONENT1, B_ANIM_SIMPLE_HEAL
#     return
#
# # The catching rules the Properties: block set at battle start can be changed at any point - the
# # usual legendary shape is "blocked until it's weak enough, then easier to catch than usual".
# EncScript_Showcase_Weakened::
#     encsetdamagereduction ENC_TARGET_BOSS, 0
#     encsetimmunity ENC_TARGET_BOSS, 0
#     encsetcatchrate 60
#     encsetballs ENC_BALLS_ALLOWED
#     return
#
# EncScript_Showcase_MoveReaction::
#     encaddvar 1, 1                         @ Phase += 1 (shown for variable arithmetic)
#     encjumpifvar CMP_GREATER_THAN, 1, 2, EncScript_Showcase_MoveReaction_Done
#     encchangestat ENC_TARGET_ALL_FOES, STAT_SPEED, -1
# EncScript_Showcase_MoveReaction_Done:
#     return
#
# EncScript_Showcase_FaintReaction::
#     encsetvar 2, 1                         @ PlayerFainted = true
#     enchangehp ENC_TARGET_ALL_ALLIES, 10
#     return
#
# EncScript_Showcase_SwitchIn::
#     encsubvar 1, 1                         @ Phase -= 1
#     encchangestat ENC_TARGET_SELF, STAT_DEF, -1
#     return
#
# EncScript_Showcase_Desperation::
#     encmegaevolve ENC_TARGET_BOSS, EncScript_Showcase_Desperation_Done
#     # `encmegaevolve` plays the stock Mega Evolution animation itself. For other presentation,
#     # use normal battle commands such as `playanimation` above; choose a valid `B_ANIM_*` id.
# EncScript_Showcase_Desperation_Done:
#     return
#
# EncScript_Showcase_Outro::
#     trainerslidein BS_OPPONENT1
#     printstring STRINGID_ENCSHOWCASEOUTRO
#     waitmessage B_WAIT_TIME_LONG
#     trainerslideout BS_OPPONENT1
#     return
#
# # In the map script that starts the desired battle:
# #     setbattleencounter ENCOUNTER_SHOWCASE
# #     trainerbattle_single TRAINER_SOME_BOSS, IntroText, DefeatText
# =================================================================================================


#-------------------------------------------------------

Encounter: Test

#-------------------------------------------------------

Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_TestBattleStart
Conditions:
    Turn >= 0

#-------------------------------------------------------

Encounter: Legendary_Barrier

#-------------------------------------------------------

# Battle-start configuration. Level: LevelCap keeps the boss at the player's progression cap, so
# the fight scales with the save (New Game Plus offsets included) instead of a hardcoded level.
# DamageReduction/Immunities make it a test of attrition rather than of one lucky Sheer Cold, and
# Balls: Blocked holds the catch back until the weakened phase below unblocks it.
Properties:
    Level: LevelCap
    CatchRate: 15
    Balls: Blocked
    DamageReduction: 70
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo

Trigger: OnMoveEnd
Priority: 10
Flags: Once, OnEnter
Script: EncScript_LegendaryBarrier_PhaseTransition
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 0

# The weakened phase: once the boss is nearly down, its guard drops and the player can finally
# throw a ball at it.
Trigger: OnTurnEnd
Priority: 10
Flags: Once, OnEnter
Script: EncScript_LegendaryBarrier_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 2

#-------------------------------------------------------

Encounter: Trainer_Mega

#-------------------------------------------------------

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_TrainerMega_Reveal
Conditions:
    Turn >= 5
    Var(MegaEvolved) == 0

#-------------------------------------------------------

Encounter: Storm_Herald

#-------------------------------------------------------

Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_StormHerald_Intro

Trigger: OnMoveEnd
Priority: 10
Flags: Once, OnEnter
Script: EncScript_StormHerald_Surge
Conditions:
    Battler(Boss).HpPercent <= 80
    Var(Phase) == 0

Trigger: OnTurnEnd
Priority: 10
Flags: Once, OnEnter
Script: EncScript_StormHerald_Desperation
Conditions:
    Battler(Boss).HpPercent <= 40
    Var(Phase) == 2

#-------------------------------------------------------

Encounter: Articuno

#-------------------------------------------------------

# Ice Barrier loop: Articuno's Ice moves raise Frost, the player's Fire moves lower it, and while
# Frost >= 1 the barrier regrows every turn - at a strength that scales with Frost - until shattered
# by a damaging hit. Absolute Zero locks Frost (sealing the barrier at its current strength) and
# repurposes the Fire answer into a recurring timer instead.
Properties:
    Level: LevelCap
    CatchRate: 0                # none; the weakened script sets a real one
    Balls: Blocked
    DamageReduction: 80
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo
    CapTypeEffectiveness: True
    FlatToxicDamage: True
    AiFlags: AI_FLAG_SMART_TRAINER
    Moves: MOVE_FREEZE_DRY, MOVE_BLIZZARD, MOVE_DUAL_WINGBEAT, MOVE_ANCIENT_POWER

# The Conditions here are always true - they exist only to fix the variable numbering.
# encounterproc assigns each Var() an index in the order it first appears in a Conditions block, so
# naming all eleven here, in order, pins Phase..LastBlunt to 0..7 (the indices the battle scripts
# hard-code) regardless of where they are actually used later, and lets the three re-entry guards
# land on 8/9/10. IceGuard/FireGuard/SwitchGuard stop OnMoveEnd/OnSwitchIn triggers, whose Event
# conditions stay true across the re-evaluation loop, from firing more than once per event.
Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_Articuno_Intro
Conditions:
    Var(Phase) >= 0
    Var(Barrier) >= 0
    Var(Plummet) >= 0
    Var(Frost) >= 0
    Var(Chill) >= 0
    Var(FrostLock) >= 0
    Var(Answered) >= 0
    Var(LastBlunt) >= 0
    Var(IceGuard) >= 0
    Var(FireGuard) >= 0
    Var(SwitchGuard) >= 0

Trigger: OnMoveEnd
Priority: 5
Flags: Once, OnEnter
Script: EncScript_Articuno_PhaseFrozenField
Conditions:
    Battler(Boss).HpPercent <= 75
    Var(Phase) == 0

Trigger: OnMoveEnd
Priority: 5
Flags: Once, OnEnter
Script: EncScript_Articuno_AbsoluteZero
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 1

# At OnMoveEnd, Event.Battler is the mon that got hit and Event.Target is the mon that used the
# move (see MoveEndEncounter). Both compare against a battler id: B_POSITION_PLAYER_LEFT is the
# player, B_POSITION_OPPONENT_LEFT is Articuno.
Trigger: OnMoveEnd
Priority: 10
Script: EncScript_Articuno_BarrierShatter
Conditions:
    Var(Barrier) == 1
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Event.Cause == ENC_CAUSE_MOVE_DAMAGE

Trigger: OnMoveEnd
Priority: 20
Script: EncScript_Articuno_IceMove
Conditions:
    Event.Target == B_POSITION_OPPONENT_LEFT
    Event.MoveType == TYPE_ICE
    Var(IceGuard) == 0

Trigger: OnMoveEnd
Priority: 20
Script: EncScript_Articuno_FireResponse
Conditions:
    Event.Target == B_POSITION_PLAYER_LEFT
    Event.MoveType == TYPE_FIRE
    Var(FireGuard) == 0

Trigger: OnTurnStart
Priority: 10
Script: EncScript_Articuno_ShakeOff
Conditions:
    Battler(Boss).Status == STATUS1_SLEEP

Trigger: OnTurnStart
Priority: 20
Script: EncScript_Articuno_PlummetTick
Conditions:
    Var(Plummet) == 2

Trigger: OnTurnStart
Priority: 30
Script: EncScript_Articuno_BarrierRaise
Conditions:
    Var(Phase) >= 1
    Var(Phase) != 3
    Var(Barrier) == 0
    Var(Frost) >= 1

Trigger: OnSwitchIn
Priority: 20
Script: EncScript_Articuno_FrozenGround
Conditions:
    Event.Battler == B_POSITION_PLAYER_LEFT
    Var(SwitchGuard) == 0
    Any:
        Var(Frost) >= 3
        Var(Chill) == 1

Trigger: OnTurnEnd
Priority: 10
Flags: Once
Script: EncScript_Articuno_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10

Trigger: OnTurnEnd
Priority: 20
Script: EncScript_Articuno_PlummetResolve
Conditions:
    Var(Plummet) == 1

# Clears the per-event re-entry guards so each fires again next turn. Self-disabling: once all three
# are 0 the Any is false and it stops.
Trigger: OnTurnEnd
Priority: 30
Script: EncScript_Articuno_TurnReset
Conditions:
    Any:
        Var(IceGuard) == 1
        Var(FireGuard) == 1
        Var(SwitchGuard) == 1

#-------------------------------------------------------

Encounter: Zapdos

#-------------------------------------------------------

# Storm Overload: one number, Charge (0-4), drives Zapdos's guard, its Sp. Atk, the weather, and
# its lightning strikes. Charge rises from Zapdos's Electric moves, the player's Electric moves,
# a chance on any other hit, and every 3rd turn; it falls by 2 when a Ground move earths it out
# (Ground can't damage Electric/Flying, so a discharge turn is a zero-damage turn) and by 1 when
# Zapdos sheds a sleep/freeze. At Charge 4 it OVERLOADS - huge offense, a strike every turn, but a
# soft guard - then BURNS OUT: Charge to 0, self-damage, guard collapses for one turn. Provoking
# that cycle is the fast, dangerous way through its HP; holding Charge at 0 is the safe, slow way.
# Below 25% HP it locks into permanent overload (Last Stand); below 10% the storm dies and it
# becomes catchable.
Properties:
    Level: LevelCap
    CatchRate: 0                # none; the weakened script sets a real one
    Balls: Blocked
    DamageReduction: 80
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo
    CapTypeEffectiveness: True
    FlatToxicDamage: True
    AiFlags: AI_FLAG_SMART_TRAINER
    Moves: MOVE_THUNDERBOLT, MOVE_THUNDER, MOVE_DRILL_PECK, MOVE_HEAT_WAVE

# Always-true block: pins the variable numbering the battle scripts hard-code. encounterproc
# assigns each Var() an index in first-appearance order, so naming all 13 here in order fixes
# Phase..TickGuard to 0..12 regardless of where they are first used later.
# 0 Phase, 1 Charge, 2 Overload, 3 Crash, 4 Mark, 5 Answered, 6 Tick, 7 LastGuard,
# 8 TurnGuard, 9 HitGuard, 10 BossGuard, 11 SwitchGuard, 12 TickGuard.
Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_Zapdos_Intro
Conditions:
    Var(Phase) >= 0
    Var(Charge) >= 0
    Var(Overload) >= 0
    Var(Crash) >= 0
    Var(Mark) >= 0
    Var(Answered) >= 0
    Var(Tick) >= 0
    Var(LastGuard) >= 0
    Var(TurnGuard) >= 0
    Var(HitGuard) >= 0
    Var(BossGuard) >= 0
    Var(SwitchGuard) >= 0
    Var(TickGuard) >= 0

# Last Stand: permanent overload, guard back up, no more burnout window. The final stage.
Trigger: OnMoveEnd
Priority: 5
Flags: Once, OnEnter
Script: EncScript_Zapdos_LastStand
Conditions:
    Battler(Boss).HpPercent <= 25
    Var(Phase) == 0

# The three "a move was aimed at Zapdos" triggers share HitGuard, so exactly one fires per hit and
# priority order makes them mutually exclusive: Ground discharges, Electric charges at 100%, and
# anything else falls through to the 25% roll.
Trigger: OnMoveEnd
Priority: 10
Script: EncScript_Zapdos_GroundHit
Conditions:
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Event.MoveType == TYPE_GROUND
    Var(HitGuard) == 0
    Var(Phase) <= 1

Trigger: OnMoveEnd
Priority: 20
Script: EncScript_Zapdos_ElectricHit
Conditions:
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Event.MoveType == TYPE_ELECTRIC
    Var(HitGuard) == 0
    Var(Phase) <= 1

# Zapdos itself using an Electric move - separate guard, since this is "boss used" not "aimed at".
Trigger: OnMoveEnd
Priority: 20
Script: EncScript_Zapdos_BossElectric
Conditions:
    Event.Target == B_POSITION_OPPONENT_LEFT
    Event.MoveType == TYPE_ELECTRIC
    Var(BossGuard) == 0
    Var(Phase) <= 1

Trigger: OnMoveEnd
Priority: 30
Script: EncScript_Zapdos_AnyHit
Conditions:
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Var(HitGuard) == 0
    Var(Phase) <= 1

Trigger: OnSwitchIn
Priority: 10
Script: EncScript_Zapdos_SwitchIn
Conditions:
    Event.Battler == B_POSITION_PLAYER_LEFT
    Var(SwitchGuard) == 0

# Runs once at the top of every turn regardless of state: clears the per-turn guards, ticks the
# passive-charge counter, sheds sleep/freeze. TurnGuard makes it unconditional-once-per-turn;
# EncScript_Zapdos_TurnClose clears TurnGuard at end of turn.
Trigger: OnTurnStart
Priority: 10
Script: EncScript_Zapdos_TurnOpen
Conditions:
    Var(TurnGuard) == 0

# Burnout resolves off the exact sentinel Overload == 1 (set by the OnTurnEnd tick on its way down).
Trigger: OnTurnStart
Priority: 20
Script: EncScript_Zapdos_Burnout
Conditions:
    Var(Overload) == 1

# The mark/strike loop: resolves a pending strike and lays the next one while Charge >= 3 and not
# overloaded (overload has its own every-turn strike).
Trigger: OnTurnStart
Priority: 30
Script: EncScript_Zapdos_Storm
Conditions:
    Any:
        Var(Mark) == 1
        All:
            Var(Mark) == 0
            Var(Charge) >= 3
            Var(Overload) == 0

Trigger: OnTurnEnd
Priority: 10
Flags: Once
Script: EncScript_Zapdos_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 1

# Overload strike + step-down. TickGuard stops the tick from running itself to the sentinel inside
# one OnTurnEnd dispatch; the step-down is skipped in Last Stand (permanent overload).
Trigger: OnTurnEnd
Priority: 20
Script: EncScript_Zapdos_OverloadTick
Conditions:
    Var(Overload) >= 2
    Var(TickGuard) == 0

Trigger: OnTurnEnd
Priority: 30
Script: EncScript_Zapdos_CrashEnd
Conditions:
    Var(Crash) == 1

# Priority 90 - runs last at the checkpoint. Clears TurnGuard and steps a freshly-laid mark (2->1)
# so the warning it gives is a full turn long.
Trigger: OnTurnEnd
Priority: 90
Script: EncScript_Zapdos_TurnClose
Conditions:
    Var(TurnGuard) == 1

#-------------------------------------------------------

Encounter: Moltres

#-------------------------------------------------------

# Moltres, "The Everlasting Flame". One number, Flame Intensity (0-5), drives the whole fight: its
# guard (which FALLS as Intensity rises, the inverse of Zapdos), its Sp. Atk, the weather, the flame
# aura and the field burn. Intensity rises when a move damages Moltres, when a Fire move hits it
# (which also HEALS it), when Moltres uses a Fire move, and when it sheds sleep/freeze; it decays by
# 1 at end of turn only if Moltres took no damage and only while Intensity <= 3. At Intensity 4 the
# fire sustains itself - permanent sun, Moltres burns 5% of its own HP per turn, and Intensity never
# falls again. When Moltres would be KO'd it instead survives at 1 HP (Survive:) and REBIRTHS once:
# HP restored, Intensity floored at 2, sun and aura made permanent. The second death is real.
Properties:
    Level: LevelCap
    CatchRate: 0                # none; the weakened script sets a real one
    Balls: Blocked
    DamageReduction: 90         # seeds Intensity 0; the ladder runs downward from here
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo
    CapTypeEffectiveness: True
    FlatToxicDamage: True
    Survive: True
    AiFlags: AI_FLAG_SMART_TRAINER
    Moves: MOVE_FLAMETHROWER, MOVE_FIRE_BLAST, MOVE_AIR_SLASH, MOVE_SOLAR_BEAM

# Always-true block: pins the variable numbering the battle scripts hard-code. encounterproc assigns
# each Var() an index in first-appearance order, so naming all 7 here in order fixes
# Phase..BossGuard to 0..6.
# 0 Phase (0 first life / 1 reborn / 2 weakened), 1 Intensity (0-5), 2 Fed (a move damaged Moltres
# this turn), 3 Chant (recurring-callout cadence), 4 TurnGuard, 5 HitGuard, 6 BossGuard.
Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_Moltres_Intro
Conditions:
    Var(Phase) >= 0
    Var(Intensity) >= 0
    Var(Fed) >= 0
    Var(Chant) >= 0
    Var(TurnGuard) >= 0
    Var(HitGuard) >= 0
    Var(BossGuard) >= 0

# Rebirth: registered at both checkpoints because the lethal blow can be a move or an end-of-turn
# tick. Both copies are Once and both gate on Var(Phase) == 0, which the script overwrites, so
# whichever fires first permanently disables the other. HP <= 1 (not a percent) because the Survive
# clamp lands Moltres at exactly 1 and, with Level: LevelCap, HpPercent rounds to 0 well before HP.
Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Moltres_Rebirth
Conditions:
    Battler(Boss).HP <= 1
    Var(Phase) == 0

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Moltres_Rebirth
Conditions:
    Battler(Boss).HP <= 1
    Var(Phase) == 0

# The only catch window. Same two-checkpoint pattern; gated on Phase 1 so it can't precede Rebirth.
Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Moltres_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 1

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Moltres_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 1

# The two "a move hit Moltres" triggers share HitGuard, so exactly one fires per hit and priority
# order makes them mutually exclusive: a Fire move is absorbed and heals Moltres (pri 10), anything
# else damaging falls through to the ordinary flame-feeding response (pri 20).
Trigger: OnMoveEnd
Priority: 10
Script: EncScript_Moltres_FireHit
Conditions:
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Event.MoveType == TYPE_FIRE
    Var(HitGuard) == 0
    Var(Phase) <= 1

Trigger: OnMoveEnd
Priority: 20
Script: EncScript_Moltres_TookDamage
Conditions:
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Event.Cause == ENC_CAUSE_MOVE_DAMAGE
    Var(HitGuard) == 0
    Var(Phase) <= 1

# Moltres itself using a Fire move - separate guard, since this is "boss used" not "aimed at".
Trigger: OnMoveEnd
Priority: 20
Script: EncScript_Moltres_BossFire
Conditions:
    Event.Target == B_POSITION_OPPONENT_LEFT
    Event.MoveType == TYPE_FIRE
    Var(BossGuard) == 0
    Var(Phase) <= 1

# Once-per-turn scaffold: TurnOpen is unconditional-once-per-turn (only gate is TurnGuard == 0, which
# it sets), TurnClose is self-disabling (gate TurnGuard == 1, which it clears).
Trigger: OnTurnStart
Priority: 10
Script: EncScript_Moltres_TurnOpen
Conditions:
    Var(TurnGuard) == 0

Trigger: OnTurnEnd
Priority: 90
Script: EncScript_Moltres_TurnClose
Conditions:
    Var(TurnGuard) == 1

#-------------------------------------------------------

Encounter: Mewtwo

#-------------------------------------------------------

# Mewtwo, "The Perfect Weapon". Two numbers drive the fight. Lean (0-6) is a tug-of-war the player
# moves without meaning to: physical moves push it up, special and status moves push it down. When
# Mewtwo's adaptation cooldown expires it mirrors whichever side won - Mega X at Lean >= 5, Mega Y
# at Lean <= 1 - and the new species' stat spread does all the countering with no extra scripting.
# Every form change costs it Instability (+1), as does shrugging off sleep/freeze, and Instability
# drives its guard DOWNWARD. At Instability 3 it OVERLOADS: it collapses back to base Mewtwo and its
# guard craters for two full turns. So the only way to open a damage window is to keep changing what
# you do, which is also the counterplay to the mirroring - one lever, both payoffs. Stance (Force in
# X, Focus in Y) builds toward a punish every third landed hit and resets on every form change.
# Phase 2 (25% HP) makes the adaptation compulsory, so the thing that made Mewtwo unbeatable is what
# kills it.
Properties:
    Level: LevelCap
    CatchRate: 0                # none; the weakened script sets a real one
    Balls: Blocked
    DamageReduction: 90         # seeds Instability tier 0; the ladder runs downward from here
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo
    CapTypeEffectiveness: True
    FlatToxicDamage: True
    AiFlags: AI_FLAG_SMART_TRAINER
    Moves: MOVE_PSYSTRIKE, MOVE_AURA_SPHERE, MOVE_PSYCHO_CUT, MOVE_BRICK_BREAK

# Always-true block: pins the variable numbering the battle scripts hard-code. encounterproc assigns
# each Var() an index in first-appearance order, so naming all 14 here in order fixes Phase..Scratch
# to 0..13.
# 0 Phase (0 analysis / 1 adaptation / 2 perfect adaptation / 3 weakened), 1 Form (0 base / 1 Mega X
# / 2 Mega Y), 2 Lean (0-6, starts 3), 3 Cooldown, 4 Instability (0-3), 5 Overload (3->1 countdown,
# 0 = off), 6 Stance (0-3), 7 LastGuard (last ANNOUNCED guard tier - the re-fire latch), 8 Chant,
# 9 TurnGuard, 10 MoveGuard, 11 BossGuard, 12 Power (banked Annihilation stacks), 13 Scratch.
Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_Mewtwo_Intro
Conditions:
    Var(Phase) >= 0
    Var(Form) >= 0
    Var(Lean) >= 0
    Var(Cooldown) >= 0
    Var(Instability) >= 0
    Var(Overload) >= 0
    Var(Stance) >= 0
    Var(LastGuard) >= 0
    Var(Chant) >= 0
    Var(TurnGuard) >= 0
    Var(MoveGuard) >= 0
    Var(BossGuard) >= 0
    Var(Power) >= 0
    Var(Scratch) >= 0

# The two phase transitions, each registered at both checkpoints because the threshold-crossing blow
# can be a move or an end-of-turn tick. Both copies are Once and both gate on a Var(Phase) value
# their script overwrites, so whichever fires first permanently disables the other.
Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Mewtwo_PerfectAdaptation
Conditions:
    Battler(Boss).HpPercent <= 25
    Var(Phase) == 1

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Mewtwo_PerfectAdaptation
Conditions:
    Battler(Boss).HpPercent <= 25
    Var(Phase) == 1

# The only catch window. Gated on Phase 2 so it can't precede Perfect Adaptation.
Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Mewtwo_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 2

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Mewtwo_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 2

# The Lean tug-of-war. One logical rule split three ways because the physical/special/status test has
# to be a condition - Event.MoveCategory is readable by the condition evaluator, not by a script
# branch. All three share MoveGuard and priority orders them, so exactly one fires per move.
# Event.Target is the battler that USED the move (Event.Battler is the one it happened to), so this
# is "the player attacked", self-targeting setup moves included.
Trigger: OnMoveEnd
Priority: 20
Script: EncScript_Mewtwo_PlayerPhysical
Conditions:
    Event.Target == B_POSITION_PLAYER_LEFT
    Event.MoveCategory == DAMAGE_CATEGORY_PHYSICAL
    Var(MoveGuard) == 0
    Var(Phase) <= 2

Trigger: OnMoveEnd
Priority: 21
Script: EncScript_Mewtwo_PlayerStatus
Conditions:
    Event.Target == B_POSITION_PLAYER_LEFT
    Event.MoveCategory == DAMAGE_CATEGORY_STATUS
    Var(MoveGuard) == 0
    Var(Phase) <= 2

Trigger: OnMoveEnd
Priority: 22
Script: EncScript_Mewtwo_PlayerSpecial
Conditions:
    Event.Target == B_POSITION_PLAYER_LEFT
    Var(MoveGuard) == 0
    Var(Phase) <= 2

# Mewtwo's own move landed on the player: Stance climbs. Mutually exclusive with the three above,
# since Event.Target can't be the player and Mewtwo at once.
Trigger: OnMoveEnd
Priority: 23
Script: EncScript_Mewtwo_BossHit
Conditions:
    Event.Target == B_POSITION_OPPONENT_LEFT
    Event.Battler == B_POSITION_PLAYER_LEFT
    Event.Cause == ENC_CAUSE_MOVE_DAMAGE
    Var(BossGuard) == 0
    Var(Phase) >= 1
    Var(Phase) <= 2

# Once-per-turn scaffold: TurnOpen is unconditional-once-per-turn (only gate is TurnGuard == 0, which
# it sets), TurnClose is self-disabling (gate TurnGuard == 1, which it clears). Both countdowns live
# inside them - Cooldown ticks at TurnOpen, Overload steps down at TurnClose and resolves at
# TurnOpen's checkpoint, so a real turn always passes between a countdown's tick and its resolution.
Trigger: OnTurnStart
Priority: 10
Script: EncScript_Mewtwo_TurnOpen
Conditions:
    Var(TurnGuard) == 0

Trigger: OnTurnEnd
Priority: 90
Script: EncScript_Mewtwo_TurnClose
Conditions:
    Var(TurnGuard) == 1

# Overload: the damage window. Start and End share a priority because Overload == 0 and == 1 are
# mutually exclusive. OverloadStart sets Cooldown, so Adapt can never join it in one dispatch.
Trigger: OnTurnStart
Priority: 20
Script: EncScript_Mewtwo_OverloadEnd
Conditions:
    Var(Overload) == 1

Trigger: OnTurnStart
Priority: 20
Script: EncScript_Mewtwo_OverloadStart
Conditions:
    Var(Instability) >= 3
    Var(Overload) == 0
    Var(Phase) >= 1
    Var(Phase) <= 2

# Phase 0 ends on a turn count, not an HP threshold - Mewtwo spends the opening turns gathering
# information, and the HP thresholds are spoken for by the later phases. Turn starts at 0, so
# Turn >= 3 is the fourth turn. FirstAdapt sets Phase AND Cooldown, so Adapt can't follow it.
Trigger: OnTurnStart
Priority: 30
Flags: Once
Script: EncScript_Mewtwo_FirstAdapt
Conditions:
    Turn >= 3
    Var(Phase) == 0

Trigger: OnTurnStart
Priority: 30
Script: EncScript_Mewtwo_Adapt
Conditions:
    Var(Phase) >= 1
    Var(Phase) <= 2
    Var(Cooldown) == 0
    Var(Overload) == 0

#-------------------------------------------------------

Encounter: Mew

#-------------------------------------------------------

# Mew, "The Genetic Wonder". The fight punishes a habit, not a resource. Two numbers: Wonder (0-6)
# rises whenever the player changes what KIND of thing they do (a move category different from last
# turn, or a switch) and drives Mew's guard DOWNWARD - it gets so absorbed in watching that it forgets
# to shield itself. Bored (0-3) rises on repetition; at 3 it fires one Mischief roll off a fixed chaos
# table and knocks Wonder back down, so spamming actively regresses. From Playtime (60% HP) on, Mew
# uses enctransform to literally become the player's active Pokemon and re-copies on every switch. At
# 30% HP it stops fighting for one turn and asks to be shown something new (answer: a status move or a
# switch); either way the fight enters Genesis - raw offense +20% and Mischief every turn. Below 10%
# it reverts to Mew, all guards off, Poke Balls unlocked. Survive: True the whole fight (a transformed
# Mew can inherit a self-KO move, and the 30->10% stretch runs at guard 68 where a crit can overshoot).
Properties:
    Level: LevelCap
    CatchRate: 0                # none; the weakened script sets a real one
    Balls: Blocked
    DamageReduction: 92         # seeds Wonder 0; the ladder runs downward from here
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo
    CapTypeEffectiveness: True
    FlatToxicDamage: True
    Survive: True
    AiFlags: AI_FLAG_SMART_TRAINER
    Moves: MOVE_PSYCHIC, MOVE_AURA_SPHERE, MOVE_ANCIENT_POWER, MOVE_SHADOW_BALL

# Always-true block: pins the variable numbering the battle scripts hard-code. encounterproc assigns
# each Var() an index in first-appearance order, so naming all 15 here in order fixes
# Phase..ChaosGuard to 0..14.
# 0 Phase (0 curious / 1 playtime / 2 genesis / 3 weakened), 1 Wonder (0-6, drives the guard ladder
# down), 2 Bored (0-3, repetition; 3 fires Mischief), 3 LastCat (last thing shown: 1 physical /
# 2 special / 3 status / 4 switch), 4-7 SeenPhys/SeenSpec/SeenStatus/SeenSwitch (first-time mimicry
# latches), 8 Wait (challenge state: 0 off / 1 armed / 2 waiting / 3 satisfied / 4 delighted /
# 5 disappointed), 9 LastGuard (last ANNOUNCED guard tier - the re-fire latch), 10 Chant (recurring-
# callout cadence), 11 TurnGuard, 12 MoveGuard, 13 SwitchGuard, 14 ChaosGuard (one Mischief roll/turn).
Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_Mew_Intro
Conditions:
    Var(Phase) >= 0
    Var(Wonder) >= 0
    Var(Bored) >= 0
    Var(LastCat) >= 0
    Var(SeenPhys) >= 0
    Var(SeenSpec) >= 0
    Var(SeenStatus) >= 0
    Var(SeenSwitch) >= 0
    Var(Wait) >= 0
    Var(LastGuard) >= 0
    Var(Chant) >= 0
    Var(TurnGuard) >= 0
    Var(MoveGuard) >= 0
    Var(SwitchGuard) >= 0
    Var(ChaosGuard) >= 0

# The three phase transitions, each registered at both checkpoints because the threshold-crossing
# blow can be a move or an end-of-turn tick. Both copies are Once and both gate on a Var(Phase) value
# their script overwrites, so whichever fires first permanently disables the other. Mirrors Moltres.
Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Mew_Playtime
Conditions:
    Battler(Boss).HpPercent <= 60
    Var(Phase) == 0

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Mew_Playtime
Conditions:
    Battler(Boss).HpPercent <= 60
    Var(Phase) == 0

Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Mew_Challenge
Conditions:
    Battler(Boss).HpPercent <= 30
    Var(Phase) == 1

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Mew_Challenge
Conditions:
    Battler(Boss).HpPercent <= 30
    Var(Phase) == 1

Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Mew_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 2

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Mew_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 2

# The variety/repetition read. One logical rule split three ways because the category test must be a
# condition (Event.MoveCategory is readable by the evaluator, not by a script branch). All three
# share MoveGuard and priority orders them, so exactly one fires per move. Event.Target is the
# battler that USED the move, so this is "the player acted", self-targeting setup included.
Trigger: OnMoveEnd
Priority: 20
Script: EncScript_Mew_PlayerPhysical
Conditions:
    Event.Target == B_POSITION_PLAYER_LEFT
    Event.MoveCategory == DAMAGE_CATEGORY_PHYSICAL
    Var(MoveGuard) == 0
    Var(Phase) <= 2

Trigger: OnMoveEnd
Priority: 21
Script: EncScript_Mew_PlayerStatus
Conditions:
    Event.Target == B_POSITION_PLAYER_LEFT
    Event.MoveCategory == DAMAGE_CATEGORY_STATUS
    Var(MoveGuard) == 0
    Var(Phase) <= 2

Trigger: OnMoveEnd
Priority: 22
Script: EncScript_Mew_PlayerSpecial
Conditions:
    Event.Target == B_POSITION_PLAYER_LEFT
    Var(MoveGuard) == 0
    Var(Phase) <= 2

# Turn >= 1 so the opening send-out is not counted as "the player showed me a switch".
Trigger: OnSwitchIn
Priority: 10
Script: EncScript_Mew_SwitchIn
Conditions:
    Event.Battler == B_POSITION_PLAYER_LEFT
    Turn >= 1
    Var(SwitchGuard) == 0
    Var(Phase) <= 2

# Once-per-turn scaffold: TurnOpen is unconditional-once-per-turn (only gate is TurnGuard == 0, which
# it sets), TurnClose is self-disabling (gate TurnGuard == 1, which it clears).
Trigger: OnTurnStart
Priority: 10
Script: EncScript_Mew_TurnOpen
Conditions:
    Var(TurnGuard) == 0

# The challenge state machine ticks across two checkpoints so a timer that resolves at the same
# checkpoint it advances can't chase itself: WaitStep (OnTurnStart) moves Wait 1->2 and drops Mew's
# offense; the player acts; WaitResolve (OnTurnEnd) reads 2 or 3 and sets 5 or 4.
Trigger: OnTurnStart
Priority: 15
Script: EncScript_Mew_WaitStep
Conditions:
    Var(Wait) == 1
    Var(Phase) == 2

Trigger: OnTurnStart
Priority: 30
Script: EncScript_Mew_Mischief
Conditions:
    Var(ChaosGuard) == 0
    Var(Phase) <= 2
    Any:
        Var(Bored) >= 3
        All:
            Var(Phase) == 2
            Var(Wait) >= 4

Trigger: OnTurnEnd
Priority: 80
Script: EncScript_Mew_WaitResolve
Conditions:
    Var(Wait) >= 2
    Var(Wait) <= 3

Trigger: OnTurnEnd
Priority: 90
Script: EncScript_Mew_TurnClose
Conditions:
    Var(TurnGuard) == 1
