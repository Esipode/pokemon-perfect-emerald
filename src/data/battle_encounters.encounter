# =================================================================================================
# ENCOUNTER SHOWCASE (commented out; copy, rename, and uncomment the parts you need)
#
# An encounter is two pieces: this definition chooses WHEN it runs, and a battle-script label
# chooses WHAT it does. Before enabling this example, add its `EncScript_Showcase_*` labels and
# `STRINGID_ENCSHOWCASE_*` text to the appropriate battle-script/string files, then put
# `setbattleencounter ENCOUNTER_SHOWCASE` immediately before the battle it should affect.
#
# This single boss demonstrates every checkpoint, priority/flag mode, author variables, grouped
# conditions, event context, battle-start properties, HP/stat changes, damage reduction and move
# immunities, catching rules, Mega Evolution, trainer presentation, and animation. It is
# intentionally more comprehensive than a production encounter: copy the individual triggers that
# match your design instead of enabling all of them at once.
#
# Encounter: Showcase
#
# # `Properties:` is optional and appears at most once, before the first `Trigger:`. It configures
# # the battle itself at battle start rather than reacting to it; every field may be omitted.
# Properties:
#     Level: LevelCap            # or a literal level; LevelCap tracks story progression
#     CatchRate: 15              # replaces the species' own catch rate (0-255, higher is easier)
#     Balls: Blocked             # Default, Blocked, or Allowed
#     DamageReduction: 70        # the boss takes 70% less damage from every source (max 99)
#     Immunities: Ohko, FixedDamage, HpSwap, SharedKo   # or None / All
#     CapTypeEffectiveness: True # clamps incoming type effectiveness to 2x; no quadruple weaknesses
#     FlatToxicDamage: True      # Toxic deals flat 1/16 max HP every turn instead of ramping up
#     Survive: True              # boss HP can't be taken below 1 via the damage formula/passive ticks
#
# # `OnBattleStart`: introduce the boss once, after all entry effects resolve.
# Trigger: OnBattleStart
# Priority: 10
# Flags: Once
# Script: EncScript_Showcase_Intro
# Conditions:
#     Battler(Boss).Species == SPECIES_RAYQUAZA
#     BattlerCount == 2
#
# # `OnTurnStart`: a repeating reminder/control point. Omitting `Flags:` makes it
# # run each turn while its conditions hold. `Turn` starts at 0, so `Turn >= 3` is the fourth turn.
# Trigger: OnTurnStart
# Priority: 30
# Script: EncScript_Showcase_TurnStart
# Conditions:
#     Turn >= 3
#     Var(TurnStartSeen) == 0
#
# # `OnMoveEnd`: a phase transition the moment HP crosses 50%. `Once, OnEnter` is the usual phase
# # combination. `Event.*` fields below are only valid at the checkpoints documented in the tutorial.
# Trigger: OnMoveEnd
# Priority: 10
# Flags: Once, OnEnter
# Script: EncScript_Showcase_HalfHealth
# Conditions:
#     Battler(Boss).HpPercent <= 50
#     Var(Phase) == 0
#     Event.Battler == B_POSITION_OPPONENT_LEFT   # the boss is the one that got hit
#     Any:
#         Event.Move == MOVE_SURF
#         Event.Move == MOVE_THUNDERBOLT
#         Event.Cause == ENC_CAUSE_MOVE_DAMAGE
#
# # `OnMoveEnd`: react whenever the player uses a particular move. `OnEnter` alone can fire again
# # after the condition becomes false and later true; use this for a repeatable edge, not a phase.
# Trigger: OnMoveEnd
# Priority: 20
# Flags: OnEnter
# Script: EncScript_Showcase_MoveReaction
# Conditions:
#     Event.Target == B_POSITION_PLAYER_LEFT   # the player is the one that used the move
#     Event.Move == MOVE_DRAGON_ASCENT
#     Not:
#         Battler(Boss).Type == TYPE_DRAGON
#
# # `OnFaint`: react after a combatant's faint bookkeeping finishes. `Self` is the event battler.
# Trigger: OnFaint
# Priority: 10
# Flags: Once
# Script: EncScript_Showcase_FaintReaction
# Conditions:
#     Event.Battler == B_POSITION_PLAYER_LEFT   # the fainted battler
#     Var(PlayerFainted) == 0
#
# # `OnSwitchIn`: reward or punish an incoming battler after its own entry effects resolve.
# Trigger: OnSwitchIn
# Priority: 10
# Flags: OnEnter
# Script: EncScript_Showcase_SwitchIn
# Conditions:
#     Battler(Self).Ability == ABILITY_INTIMIDATE
#     Battler(Boss).Status == 0
#
# # `OnTurnEnd`: make a second phase depend on the first. `OldValue`/`NewValue` can inspect an
# # end-of-turn HP/status/weather change; Weather and Terrain read the current field state.
# Trigger: OnTurnEnd
# Priority: 10
# Flags: Once, OnEnter
# Script: EncScript_Showcase_Desperation
# Conditions:
#     Battler(Boss).HpPercent <= 25
#     Var(Phase) == 1
#     Any:
#         Weather == B_WEATHER_RAIN_NORMAL
#         Terrain == STATUS_FIELD_ELECTRIC_TERRAIN
#         Event.OldValue > 50
#         Event.NewValue <= 50
#
# # `OnBattleEnd`: presentation only; the winner is already decided, so do not change battle state.
# Trigger: OnBattleEnd
# Priority: 10
# Flags: Once
# Script: EncScript_Showcase_Outro
# Conditions:
#     Var(Phase) >= 1
#
#
# # Add the following labels to data/battle_scripts_encounters.s. The `Var(...)` names above receive
# # indexes in first-use order: TurnStartSeen = 0, Phase = 1, PlayerFainted = 2. Using numeric
# # indexes here matches the existing encounter scripts. Every encounter script must end in `return`.
#
# EncScript_Showcase_Intro::
#     trainerslidein BS_OPPONENT1
#     printstring STRINGID_ENCSHOWCASEINTRO
#     waitmessage B_WAIT_TIME_LONG
#     trainerslideout BS_OPPONENT1
#     return
#
# EncScript_Showcase_TurnStart::
#     encsetvar 0, 1                         @ TurnStartSeen = true
#     printstring STRINGID_ENCSHOWCASETURNTHREE
#     waitmessage B_WAIT_TIME_SHORT
#     return
#
# EncScript_Showcase_HalfHealth::
#     encsetvar 1, 1                         @ Phase = 1
#     trainerslidein BS_OPPONENT1
#     printstring STRINGID_ENCSHOWCASEBARRIER
#     waitmessage B_WAIT_TIME_LONG
#     trainerslideout BS_OPPONENT1
#     enchangehp ENC_TARGET_BOSS, 25, ENC_AMOUNT_PERCENT   @ positive heals; negative damages
#     encchangestat ENC_TARGET_BOSS, STAT_SPATK, 2         @ stat STAGE, undone by Haze/switching
#     encchangestatvalue ENC_TARGET_BOSS, STAT_SPEED, 20, ENC_AMOUNT_PERCENT   @ raw stat, permanent
#     encsetdamagereduction ENC_TARGET_BOSS, 70
#     encsetimmunity ENC_TARGET_BOSS, ENC_IMMUNE_OHKO | ENC_IMMUNE_FIXED_DAMAGE
#     playanimation BS_OPPONENT1, B_ANIM_SIMPLE_HEAL
#     return
#
# # The catching rules the Properties: block set at battle start can be changed at any point - the
# # usual legendary shape is "blocked until it's weak enough, then easier to catch than usual".
# EncScript_Showcase_Weakened::
#     encsetdamagereduction ENC_TARGET_BOSS, 0
#     encsetimmunity ENC_TARGET_BOSS, 0
#     encsetcatchrate 60
#     encsetballs ENC_BALLS_ALLOWED
#     return
#
# EncScript_Showcase_MoveReaction::
#     encaddvar 1, 1                         @ Phase += 1 (shown for variable arithmetic)
#     encjumpifvar CMP_GREATER_THAN, 1, 2, EncScript_Showcase_MoveReaction_Done
#     encchangestat ENC_TARGET_ALL_FOES, STAT_SPEED, -1
# EncScript_Showcase_MoveReaction_Done:
#     return
#
# EncScript_Showcase_FaintReaction::
#     encsetvar 2, 1                         @ PlayerFainted = true
#     enchangehp ENC_TARGET_ALL_ALLIES, 10
#     return
#
# EncScript_Showcase_SwitchIn::
#     encsubvar 1, 1                         @ Phase -= 1
#     encchangestat ENC_TARGET_SELF, STAT_DEF, -1
#     return
#
# EncScript_Showcase_Desperation::
#     encmegaevolve ENC_TARGET_BOSS, EncScript_Showcase_Desperation_Done
#     # `encmegaevolve` plays the stock Mega Evolution animation itself. For other presentation,
#     # use normal battle commands such as `playanimation` above; choose a valid `B_ANIM_*` id.
# EncScript_Showcase_Desperation_Done:
#     return
#
# EncScript_Showcase_Outro::
#     trainerslidein BS_OPPONENT1
#     printstring STRINGID_ENCSHOWCASEOUTRO
#     waitmessage B_WAIT_TIME_LONG
#     trainerslideout BS_OPPONENT1
#     return
#
# # In the map script that starts the desired battle:
# #     setbattleencounter ENCOUNTER_SHOWCASE
# #     trainerbattle_single TRAINER_SOME_BOSS, IntroText, DefeatText
# =================================================================================================


#-------------------------------------------------------

Encounter: Test

#-------------------------------------------------------

Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_TestBattleStart
Conditions:
    Turn >= 0

#-------------------------------------------------------

Encounter: Legendary_Barrier

#-------------------------------------------------------

# Battle-start configuration. Level: LevelCap keeps the boss at the player's progression cap, so
# the fight scales with the save (New Game Plus offsets included) instead of a hardcoded level.
# DamageReduction/Immunities make it a test of attrition rather than of one lucky Sheer Cold, and
# Balls: Blocked holds the catch back until the weakened phase below unblocks it.
Properties:
    Level: LevelCap
    CatchRate: 15
    Balls: Blocked
    DamageReduction: 70
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo

Trigger: OnMoveEnd
Priority: 10
Flags: Once, OnEnter
Script: EncScript_LegendaryBarrier_PhaseTransition
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 0

# The weakened phase: once the boss is nearly down, its guard drops and the player can finally
# throw a ball at it.
Trigger: OnTurnEnd
Priority: 10
Flags: Once, OnEnter
Script: EncScript_LegendaryBarrier_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 2

#-------------------------------------------------------

Encounter: Trainer_Mega

#-------------------------------------------------------

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_TrainerMega_Reveal
Conditions:
    Turn >= 5
    Var(MegaEvolved) == 0

#-------------------------------------------------------

Encounter: Storm_Herald

#-------------------------------------------------------

Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_StormHerald_Intro

Trigger: OnMoveEnd
Priority: 10
Flags: Once, OnEnter
Script: EncScript_StormHerald_Surge
Conditions:
    Battler(Boss).HpPercent <= 80
    Var(Phase) == 0

Trigger: OnTurnEnd
Priority: 10
Flags: Once, OnEnter
Script: EncScript_StormHerald_Desperation
Conditions:
    Battler(Boss).HpPercent <= 40
    Var(Phase) == 2

#-------------------------------------------------------

Encounter: Articuno

#-------------------------------------------------------

# Ice Barrier loop: Articuno's Ice moves raise Frost, the player's Fire moves lower it, and while
# Frost >= 1 the barrier regrows every turn - at a strength that scales with Frost - until shattered
# by a damaging hit. Absolute Zero locks Frost (sealing the barrier at its current strength) and
# repurposes the Fire answer into a recurring timer instead.
Properties:
    Level: LevelCap
    CatchRate: 0                # none; the weakened script sets a real one
    Balls: Blocked
    DamageReduction: 80
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo
    CapTypeEffectiveness: True
    FlatToxicDamage: True
    AiFlags: AI_FLAG_SMART_TRAINER
    Moves: MOVE_FREEZE_DRY, MOVE_BLIZZARD, MOVE_DUAL_WINGBEAT, MOVE_ANCIENT_POWER
    Ability: ABILITY_SNOW_CLOAK

# The Conditions here are always true - they exist only to fix the variable numbering.
# encounterproc assigns each Var() an index in the order it first appears in a Conditions block, so
# naming all eleven here, in order, pins Phase..LastBlunt to 0..7 (the indices the battle scripts
# hard-code) regardless of where they are actually used later, and lets the three re-entry guards
# land on 8/9/10. IceGuard/FireGuard/SwitchGuard stop OnMoveEnd/OnSwitchIn triggers, whose Event
# conditions stay true across the re-evaluation loop, from firing more than once per event.
Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_Articuno_Intro
Conditions:
    Var(Phase) >= 0
    Var(Barrier) >= 0
    Var(Plummet) >= 0
    Var(Frost) >= 0
    Var(Chill) >= 0
    Var(FrostLock) >= 0
    Var(Answered) >= 0
    Var(LastBlunt) >= 0
    Var(IceGuard) >= 0
    Var(FireGuard) >= 0
    Var(SwitchGuard) >= 0

Trigger: OnMoveEnd
Priority: 5
Flags: Once, OnEnter
Script: EncScript_Articuno_PhaseFrozenField
Conditions:
    Battler(Boss).HpPercent <= 75
    Var(Phase) == 0

Trigger: OnMoveEnd
Priority: 5
Flags: Once, OnEnter
Script: EncScript_Articuno_AbsoluteZero
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 1

# At OnMoveEnd, Event.Battler is the mon that got hit and Event.Target is the mon that used the
# move (see MoveEndEncounter). Both compare against a battler id: B_POSITION_PLAYER_LEFT is the
# player, B_POSITION_OPPONENT_LEFT is Articuno.
Trigger: OnMoveEnd
Priority: 10
Script: EncScript_Articuno_BarrierShatter
Conditions:
    Var(Barrier) == 1
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Event.Cause == ENC_CAUSE_MOVE_DAMAGE

Trigger: OnMoveEnd
Priority: 20
Script: EncScript_Articuno_IceMove
Conditions:
    Event.Target == B_POSITION_OPPONENT_LEFT
    Event.MoveType == TYPE_ICE
    Var(IceGuard) == 0

Trigger: OnMoveEnd
Priority: 20
Script: EncScript_Articuno_FireResponse
Conditions:
    Event.Target == B_POSITION_PLAYER_LEFT
    Event.MoveType == TYPE_FIRE
    Var(FireGuard) == 0

Trigger: OnTurnStart
Priority: 10
Script: EncScript_Articuno_ShakeOff
Conditions:
    Battler(Boss).Status == STATUS1_SLEEP

Trigger: OnTurnStart
Priority: 20
Script: EncScript_Articuno_PlummetTick
Conditions:
    Var(Plummet) == 2

Trigger: OnTurnStart
Priority: 30
Script: EncScript_Articuno_BarrierRaise
Conditions:
    Var(Phase) >= 1
    Var(Phase) != 3
    Var(Barrier) == 0
    Var(Frost) >= 1

Trigger: OnSwitchIn
Priority: 20
Script: EncScript_Articuno_FrozenGround
Conditions:
    Event.Battler == B_POSITION_PLAYER_LEFT
    Var(SwitchGuard) == 0
    Any:
        Var(Frost) >= 3
        Var(Chill) == 1

Trigger: OnTurnEnd
Priority: 10
Flags: Once
Script: EncScript_Articuno_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10

Trigger: OnTurnEnd
Priority: 20
Script: EncScript_Articuno_PlummetResolve
Conditions:
    Var(Plummet) == 1

# Clears the per-event re-entry guards so each fires again next turn. Self-disabling: once all three
# are 0 the Any is false and it stops.
Trigger: OnTurnEnd
Priority: 30
Script: EncScript_Articuno_TurnReset
Conditions:
    Any:
        Var(IceGuard) == 1
        Var(FireGuard) == 1
        Var(SwitchGuard) == 1

#-------------------------------------------------------

Encounter: Zapdos

#-------------------------------------------------------

# Storm Overload: one number, Charge (0-4), drives Zapdos's guard, its Sp. Atk, the weather, and
# its lightning strikes. Charge rises from Zapdos's Electric moves, the player's Electric moves,
# a chance on any other hit, and every 3rd turn; it falls by 2 when a Ground move earths it out
# (Ground can't damage Electric/Flying, so a discharge turn is a zero-damage turn) and by 1 when
# Zapdos sheds a sleep/freeze. At Charge 4 it OVERLOADS - huge offense, a strike every turn, but a
# soft guard - then BURNS OUT: Charge to 0, self-damage, guard collapses for one turn. Provoking
# that cycle is the fast, dangerous way through its HP; holding Charge at 0 is the safe, slow way.
# Below 25% HP it locks into permanent overload (Last Stand); below 10% the storm dies and it
# becomes catchable.
Properties:
    Level: LevelCap
    CatchRate: 0                # none; the weakened script sets a real one
    Balls: Blocked
    DamageReduction: 80
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo
    CapTypeEffectiveness: True
    FlatToxicDamage: True
    AiFlags: AI_FLAG_SMART_TRAINER
    Moves: MOVE_THUNDERBOLT, MOVE_THUNDER, MOVE_DRILL_PECK, MOVE_HEAT_WAVE
    Ability: ABILITY_STATIC

# Always-true block: pins the variable numbering the battle scripts hard-code. encounterproc
# assigns each Var() an index in first-appearance order, so naming all 13 here in order fixes
# Phase..TickGuard to 0..12 regardless of where they are first used later.
# 0 Phase, 1 Charge, 2 Overload, 3 Crash, 4 Mark, 5 Answered, 6 Tick, 7 LastGuard,
# 8 TurnGuard, 9 HitGuard, 10 BossGuard, 11 SwitchGuard, 12 TickGuard.
Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_Zapdos_Intro
Conditions:
    Var(Phase) >= 0
    Var(Charge) >= 0
    Var(Overload) >= 0
    Var(Crash) >= 0
    Var(Mark) >= 0
    Var(Answered) >= 0
    Var(Tick) >= 0
    Var(LastGuard) >= 0
    Var(TurnGuard) >= 0
    Var(HitGuard) >= 0
    Var(BossGuard) >= 0
    Var(SwitchGuard) >= 0
    Var(TickGuard) >= 0

# Last Stand: permanent overload, guard back up, no more burnout window. The final stage.
Trigger: OnMoveEnd
Priority: 5
Flags: Once, OnEnter
Script: EncScript_Zapdos_LastStand
Conditions:
    Battler(Boss).HpPercent <= 25
    Var(Phase) == 0

# The three "a move was aimed at Zapdos" triggers share HitGuard, so exactly one fires per hit and
# priority order makes them mutually exclusive: Ground discharges, Electric charges at 100%, and
# anything else falls through to the 25% roll.
Trigger: OnMoveEnd
Priority: 10
Script: EncScript_Zapdos_GroundHit
Conditions:
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Event.MoveType == TYPE_GROUND
    Var(HitGuard) == 0
    Var(Phase) <= 1

Trigger: OnMoveEnd
Priority: 20
Script: EncScript_Zapdos_ElectricHit
Conditions:
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Event.MoveType == TYPE_ELECTRIC
    Var(HitGuard) == 0
    Var(Phase) <= 1

# Zapdos itself using an Electric move - separate guard, since this is "boss used" not "aimed at".
Trigger: OnMoveEnd
Priority: 20
Script: EncScript_Zapdos_BossElectric
Conditions:
    Event.Target == B_POSITION_OPPONENT_LEFT
    Event.MoveType == TYPE_ELECTRIC
    Var(BossGuard) == 0
    Var(Phase) <= 1

Trigger: OnMoveEnd
Priority: 30
Script: EncScript_Zapdos_AnyHit
Conditions:
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Var(HitGuard) == 0
    Var(Phase) <= 1

Trigger: OnSwitchIn
Priority: 10
Script: EncScript_Zapdos_SwitchIn
Conditions:
    Event.Battler == B_POSITION_PLAYER_LEFT
    Var(SwitchGuard) == 0

# Runs once at the top of every turn regardless of state: clears the per-turn guards, ticks the
# passive-charge counter, sheds sleep/freeze. TurnGuard makes it unconditional-once-per-turn;
# EncScript_Zapdos_TurnClose clears TurnGuard at end of turn.
Trigger: OnTurnStart
Priority: 10
Script: EncScript_Zapdos_TurnOpen
Conditions:
    Var(TurnGuard) == 0

# Burnout resolves off the exact sentinel Overload == 1 (set by the OnTurnEnd tick on its way down).
Trigger: OnTurnStart
Priority: 20
Script: EncScript_Zapdos_Burnout
Conditions:
    Var(Overload) == 1

# The mark/strike loop: resolves a pending strike and lays the next one while Charge >= 3 and not
# overloaded (overload has its own every-turn strike).
Trigger: OnTurnStart
Priority: 30
Script: EncScript_Zapdos_Storm
Conditions:
    Any:
        Var(Mark) == 1
        All:
            Var(Mark) == 0
            Var(Charge) >= 3
            Var(Overload) == 0

Trigger: OnTurnEnd
Priority: 10
Flags: Once
Script: EncScript_Zapdos_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 1

# Overload strike + step-down. TickGuard stops the tick from running itself to the sentinel inside
# one OnTurnEnd dispatch; the step-down is skipped in Last Stand (permanent overload).
Trigger: OnTurnEnd
Priority: 20
Script: EncScript_Zapdos_OverloadTick
Conditions:
    Var(Overload) >= 2
    Var(TickGuard) == 0

Trigger: OnTurnEnd
Priority: 30
Script: EncScript_Zapdos_CrashEnd
Conditions:
    Var(Crash) == 1

# Priority 90 - runs last at the checkpoint. Clears TurnGuard and steps a freshly-laid mark (2->1)
# so the warning it gives is a full turn long.
Trigger: OnTurnEnd
Priority: 90
Script: EncScript_Zapdos_TurnClose
Conditions:
    Var(TurnGuard) == 1

#-------------------------------------------------------

Encounter: Moltres

#-------------------------------------------------------

# Moltres, "The Everlasting Flame". One number, Flame Intensity (0-5), drives the whole fight: its
# guard (which FALLS as Intensity rises, the inverse of Zapdos), its Sp. Atk, the weather, the flame
# aura and the field burn. Intensity rises when a move damages Moltres, when a Fire move hits it
# (which also HEALS it), when Moltres uses a Fire move, and when it sheds sleep/freeze; it decays by
# 1 at end of turn only if Moltres took no damage and only while Intensity <= 3. At Intensity 4 the
# fire sustains itself - permanent sun, Moltres burns 5% of its own HP per turn, and Intensity never
# falls again. When Moltres would be KO'd it instead survives at 1 HP (Survive:) and REBIRTHS once:
# HP restored, Intensity floored at 2, sun and aura made permanent. The second death is real.
Properties:
    Level: LevelCap
    CatchRate: 0                # none; the weakened script sets a real one
    Balls: Blocked
    DamageReduction: 90         # seeds Intensity 0; the ladder runs downward from here
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo
    CapTypeEffectiveness: True
    FlatToxicDamage: True
    Survive: True
    AiFlags: AI_FLAG_SMART_TRAINER
    Moves: MOVE_FLAMETHROWER, MOVE_FIRE_BLAST, MOVE_AIR_SLASH, MOVE_SOLAR_BEAM
    Ability: ABILITY_FLAME_BODY

# Always-true block: pins the variable numbering the battle scripts hard-code. encounterproc assigns
# each Var() an index in first-appearance order, so naming all 7 here in order fixes
# Phase..BossGuard to 0..6.
# 0 Phase (0 first life / 1 reborn / 2 weakened), 1 Intensity (0-5), 2 Fed (a move damaged Moltres
# this turn), 3 Chant (recurring-callout cadence), 4 TurnGuard, 5 HitGuard, 6 BossGuard.
Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_Moltres_Intro
Conditions:
    Var(Phase) >= 0
    Var(Intensity) >= 0
    Var(Fed) >= 0
    Var(Chant) >= 0
    Var(TurnGuard) >= 0
    Var(HitGuard) >= 0
    Var(BossGuard) >= 0

# Rebirth: registered at both checkpoints because the lethal blow can be a move or an end-of-turn
# tick. Both copies are Once and both gate on Var(Phase) == 0, which the script overwrites, so
# whichever fires first permanently disables the other. HP <= 1 (not a percent) because the Survive
# clamp lands Moltres at exactly 1 and, with Level: LevelCap, HpPercent rounds to 0 well before HP.
Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Moltres_Rebirth
Conditions:
    Battler(Boss).HP <= 1
    Var(Phase) == 0

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Moltres_Rebirth
Conditions:
    Battler(Boss).HP <= 1
    Var(Phase) == 0

# The only catch window. Same two-checkpoint pattern; gated on Phase 1 so it can't precede Rebirth.
Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Moltres_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 1

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Moltres_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 1

# The two "a move hit Moltres" triggers share HitGuard, so exactly one fires per hit and priority
# order makes them mutually exclusive: a Fire move is absorbed and heals Moltres (pri 10), anything
# else damaging falls through to the ordinary flame-feeding response (pri 20).
Trigger: OnMoveEnd
Priority: 10
Script: EncScript_Moltres_FireHit
Conditions:
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Event.MoveType == TYPE_FIRE
    Var(HitGuard) == 0
    Var(Phase) <= 1

Trigger: OnMoveEnd
Priority: 20
Script: EncScript_Moltres_TookDamage
Conditions:
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Event.Cause == ENC_CAUSE_MOVE_DAMAGE
    Var(HitGuard) == 0
    Var(Phase) <= 1

# Moltres itself using a Fire move - separate guard, since this is "boss used" not "aimed at".
Trigger: OnMoveEnd
Priority: 20
Script: EncScript_Moltres_BossFire
Conditions:
    Event.Target == B_POSITION_OPPONENT_LEFT
    Event.MoveType == TYPE_FIRE
    Var(BossGuard) == 0
    Var(Phase) <= 1

# Once-per-turn scaffold: TurnOpen is unconditional-once-per-turn (only gate is TurnGuard == 0, which
# it sets), TurnClose is self-disabling (gate TurnGuard == 1, which it clears).
Trigger: OnTurnStart
Priority: 10
Script: EncScript_Moltres_TurnOpen
Conditions:
    Var(TurnGuard) == 0

Trigger: OnTurnEnd
Priority: 90
Script: EncScript_Moltres_TurnClose
Conditions:
    Var(TurnGuard) == 1

#-------------------------------------------------------

Encounter: Mewtwo

#-------------------------------------------------------

# Mewtwo, "The Perfect Weapon". Two numbers drive the fight. Lean (0-6) is a tug-of-war the player
# moves without meaning to: physical moves push it up, special and status moves push it down. When
# Mewtwo's adaptation cooldown expires it mirrors whichever side won - Mega X at Lean >= 5, Mega Y
# at Lean <= 1 - and the new species' stat spread does all the countering with no extra scripting.
# Every form change costs it Instability (+1), as does shrugging off sleep/freeze, and Instability
# drives its guard DOWNWARD. At Instability 3 it OVERLOADS: it collapses back to base Mewtwo and its
# guard craters for two full turns. So the only way to open a damage window is to keep changing what
# you do, which is also the counterplay to the mirroring - one lever, both payoffs. Stance (Force in
# X, Focus in Y) builds toward a punish every third landed hit and resets on every form change.
# Phase 2 (25% HP) makes the adaptation compulsory, so the thing that made Mewtwo unbeatable is what
# kills it.
Properties:
    Level: LevelCap
    CatchRate: 0                # none; the weakened script sets a real one
    Balls: Blocked
    DamageReduction: 90         # seeds Instability tier 0; the ladder runs downward from here
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo
    CapTypeEffectiveness: True
    FlatToxicDamage: True
    AiFlags: AI_FLAG_SMART_TRAINER
    Moves: MOVE_PSYSTRIKE, MOVE_AURA_SPHERE, MOVE_PSYCHO_CUT, MOVE_BRICK_BREAK

# Always-true block: pins the variable numbering the battle scripts hard-code. encounterproc assigns
# each Var() an index in first-appearance order, so naming all 14 here in order fixes Phase..Scratch
# to 0..13.
# 0 Phase (0 analysis / 1 adaptation / 2 perfect adaptation / 3 weakened), 1 Form (0 base / 1 Mega X
# / 2 Mega Y), 2 Lean (0-6, starts 3), 3 Cooldown, 4 Instability (0-3), 5 Overload (3->1 countdown,
# 0 = off), 6 Stance (0-3), 7 LastGuard (last ANNOUNCED guard tier - the re-fire latch), 8 Chant,
# 9 TurnGuard, 10 MoveGuard, 11 BossGuard, 12 Power (banked Annihilation stacks), 13 Scratch.
Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_Mewtwo_Intro
Conditions:
    Var(Phase) >= 0
    Var(Form) >= 0
    Var(Lean) >= 0
    Var(Cooldown) >= 0
    Var(Instability) >= 0
    Var(Overload) >= 0
    Var(Stance) >= 0
    Var(LastGuard) >= 0
    Var(Chant) >= 0
    Var(TurnGuard) >= 0
    Var(MoveGuard) >= 0
    Var(BossGuard) >= 0
    Var(Power) >= 0
    Var(Scratch) >= 0

# The two phase transitions, each registered at both checkpoints because the threshold-crossing blow
# can be a move or an end-of-turn tick. Both copies are Once and both gate on a Var(Phase) value
# their script overwrites, so whichever fires first permanently disables the other.
Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Mewtwo_PerfectAdaptation
Conditions:
    Battler(Boss).HpPercent <= 25
    Var(Phase) == 1

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Mewtwo_PerfectAdaptation
Conditions:
    Battler(Boss).HpPercent <= 25
    Var(Phase) == 1

# The only catch window. Gated on Phase 2 so it can't precede Perfect Adaptation.
Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Mewtwo_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 2

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Mewtwo_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 2

# The Lean tug-of-war. One logical rule split three ways because the physical/special/status test has
# to be a condition - Event.MoveCategory is readable by the condition evaluator, not by a script
# branch. All three share MoveGuard and priority orders them, so exactly one fires per move.
# Event.Target is the battler that USED the move (Event.Battler is the one it happened to), so this
# is "the player attacked", self-targeting setup moves included.
Trigger: OnMoveEnd
Priority: 20
Script: EncScript_Mewtwo_PlayerPhysical
Conditions:
    Event.Target == B_POSITION_PLAYER_LEFT
    Event.MoveCategory == DAMAGE_CATEGORY_PHYSICAL
    Var(MoveGuard) == 0
    Var(Phase) <= 2

Trigger: OnMoveEnd
Priority: 21
Script: EncScript_Mewtwo_PlayerStatus
Conditions:
    Event.Target == B_POSITION_PLAYER_LEFT
    Event.MoveCategory == DAMAGE_CATEGORY_STATUS
    Var(MoveGuard) == 0
    Var(Phase) <= 2

Trigger: OnMoveEnd
Priority: 22
Script: EncScript_Mewtwo_PlayerSpecial
Conditions:
    Event.Target == B_POSITION_PLAYER_LEFT
    Var(MoveGuard) == 0
    Var(Phase) <= 2

# Mewtwo's own move landed on the player: Stance climbs. Mutually exclusive with the three above,
# since Event.Target can't be the player and Mewtwo at once.
Trigger: OnMoveEnd
Priority: 23
Script: EncScript_Mewtwo_BossHit
Conditions:
    Event.Target == B_POSITION_OPPONENT_LEFT
    Event.Battler == B_POSITION_PLAYER_LEFT
    Event.Cause == ENC_CAUSE_MOVE_DAMAGE
    Var(BossGuard) == 0
    Var(Phase) >= 1
    Var(Phase) <= 2

# Once-per-turn scaffold: TurnOpen is unconditional-once-per-turn (only gate is TurnGuard == 0, which
# it sets), TurnClose is self-disabling (gate TurnGuard == 1, which it clears). Both countdowns live
# inside them - Cooldown ticks at TurnOpen, Overload steps down at TurnClose and resolves at
# TurnOpen's checkpoint, so a real turn always passes between a countdown's tick and its resolution.
Trigger: OnTurnStart
Priority: 10
Script: EncScript_Mewtwo_TurnOpen
Conditions:
    Var(TurnGuard) == 0

Trigger: OnTurnEnd
Priority: 90
Script: EncScript_Mewtwo_TurnClose
Conditions:
    Var(TurnGuard) == 1

# Overload: the damage window. Start and End share a priority because Overload == 0 and == 1 are
# mutually exclusive. OverloadStart sets Cooldown, so Adapt can never join it in one dispatch.
Trigger: OnTurnStart
Priority: 20
Script: EncScript_Mewtwo_OverloadEnd
Conditions:
    Var(Overload) == 1

Trigger: OnTurnStart
Priority: 20
Script: EncScript_Mewtwo_OverloadStart
Conditions:
    Var(Instability) >= 3
    Var(Overload) == 0
    Var(Phase) >= 1
    Var(Phase) <= 2

# Phase 0 ends on a turn count, not an HP threshold - Mewtwo spends the opening turns gathering
# information, and the HP thresholds are spoken for by the later phases. Turn starts at 0, so
# Turn >= 3 is the fourth turn. FirstAdapt sets Phase AND Cooldown, so Adapt can't follow it.
Trigger: OnTurnStart
Priority: 30
Flags: Once
Script: EncScript_Mewtwo_FirstAdapt
Conditions:
    Turn >= 3
    Var(Phase) == 0

Trigger: OnTurnStart
Priority: 30
Script: EncScript_Mewtwo_Adapt
Conditions:
    Var(Phase) >= 1
    Var(Phase) <= 2
    Var(Cooldown) == 0
    Var(Overload) == 0

#-------------------------------------------------------

Encounter: Mew

#-------------------------------------------------------

# Mew, "The Genetic Wonder". The fight punishes a habit, not a resource. Two numbers: Wonder (0-6)
# rises whenever the player changes what KIND of thing they do (a move category different from last
# turn, or a switch) and drives Mew's guard DOWNWARD - it gets so absorbed in watching that it forgets
# to shield itself. Bored (0-3) rises on repetition; at 3 it fires one Mischief roll off a fixed chaos
# table and knocks Wonder back down, so spamming actively regresses. From Playtime (60% HP) on, Mew
# uses enctransform to literally become the player's active Pokemon and re-copies on every switch. At
# 30% HP it stops fighting for one turn and asks to be shown something new (answer: a status move or a
# switch); either way the fight enters Genesis - raw offense +20% and Mischief every turn. Below 10%
# it reverts to Mew, all guards off, Poke Balls unlocked. Survive: True the whole fight (a transformed
# Mew can inherit a self-KO move, and the 30->10% stretch runs at guard 68 where a crit can overshoot).
Properties:
    Level: LevelCap
    CatchRate: 0                # none; the weakened script sets a real one
    Balls: Blocked
    DamageReduction: 92         # seeds Wonder 0; the ladder runs downward from here
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo
    CapTypeEffectiveness: True
    FlatToxicDamage: True
    Survive: True
    AiFlags: AI_FLAG_SMART_TRAINER
    Moves: MOVE_PSYCHIC, MOVE_AURA_SPHERE, MOVE_ANCIENT_POWER, MOVE_SHADOW_BALL

# Always-true block: pins the variable numbering the battle scripts hard-code. encounterproc assigns
# each Var() an index in first-appearance order, so naming all 15 here in order fixes
# Phase..ChaosGuard to 0..14.
# 0 Phase (0 curious / 1 playtime / 2 genesis / 3 weakened), 1 Wonder (0-6, drives the guard ladder
# down), 2 Bored (0-3, repetition; 3 fires Mischief), 3 LastCat (last thing shown: 1 physical /
# 2 special / 3 status / 4 switch), 4-7 SeenPhys/SeenSpec/SeenStatus/SeenSwitch (first-time mimicry
# latches), 8 Wait (challenge state: 0 off / 1 armed / 2 waiting / 3 satisfied / 4 delighted /
# 5 disappointed), 9 LastGuard (last ANNOUNCED guard tier - the re-fire latch), 10 Chant (recurring-
# callout cadence), 11 TurnGuard, 12 MoveGuard, 13 SwitchGuard, 14 ChaosGuard (one Mischief roll/turn).
Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_Mew_Intro
Conditions:
    Var(Phase) >= 0
    Var(Wonder) >= 0
    Var(Bored) >= 0
    Var(LastCat) >= 0
    Var(SeenPhys) >= 0
    Var(SeenSpec) >= 0
    Var(SeenStatus) >= 0
    Var(SeenSwitch) >= 0
    Var(Wait) >= 0
    Var(LastGuard) >= 0
    Var(Chant) >= 0
    Var(TurnGuard) >= 0
    Var(MoveGuard) >= 0
    Var(SwitchGuard) >= 0
    Var(ChaosGuard) >= 0

# The three phase transitions, each registered at both checkpoints because the threshold-crossing
# blow can be a move or an end-of-turn tick. Both copies are Once and both gate on a Var(Phase) value
# their script overwrites, so whichever fires first permanently disables the other. Mirrors Moltres.
Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Mew_Playtime
Conditions:
    Battler(Boss).HpPercent <= 60
    Var(Phase) == 0

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Mew_Playtime
Conditions:
    Battler(Boss).HpPercent <= 60
    Var(Phase) == 0

Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Mew_Challenge
Conditions:
    Battler(Boss).HpPercent <= 30
    Var(Phase) == 1

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Mew_Challenge
Conditions:
    Battler(Boss).HpPercent <= 30
    Var(Phase) == 1

Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Mew_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 2

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Mew_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 2

# The variety/repetition read. One logical rule split three ways because the category test must be a
# condition (Event.MoveCategory is readable by the evaluator, not by a script branch). All three
# share MoveGuard and priority orders them, so exactly one fires per move. Event.Target is the
# battler that USED the move, so this is "the player acted", self-targeting setup included.
Trigger: OnMoveEnd
Priority: 20
Script: EncScript_Mew_PlayerPhysical
Conditions:
    Event.Target == B_POSITION_PLAYER_LEFT
    Event.MoveCategory == DAMAGE_CATEGORY_PHYSICAL
    Var(MoveGuard) == 0
    Var(Phase) <= 2

Trigger: OnMoveEnd
Priority: 21
Script: EncScript_Mew_PlayerStatus
Conditions:
    Event.Target == B_POSITION_PLAYER_LEFT
    Event.MoveCategory == DAMAGE_CATEGORY_STATUS
    Var(MoveGuard) == 0
    Var(Phase) <= 2

Trigger: OnMoveEnd
Priority: 22
Script: EncScript_Mew_PlayerSpecial
Conditions:
    Event.Target == B_POSITION_PLAYER_LEFT
    Var(MoveGuard) == 0
    Var(Phase) <= 2

# Turn >= 1 so the opening send-out is not counted as "the player showed me a switch".
Trigger: OnSwitchIn
Priority: 10
Script: EncScript_Mew_SwitchIn
Conditions:
    Event.Battler == B_POSITION_PLAYER_LEFT
    Turn >= 1
    Var(SwitchGuard) == 0
    Var(Phase) <= 2

# Once-per-turn scaffold: TurnOpen is unconditional-once-per-turn (only gate is TurnGuard == 0, which
# it sets), TurnClose is self-disabling (gate TurnGuard == 1, which it clears).
Trigger: OnTurnStart
Priority: 10
Script: EncScript_Mew_TurnOpen
Conditions:
    Var(TurnGuard) == 0

# The challenge state machine ticks across two checkpoints so a timer that resolves at the same
# checkpoint it advances can't chase itself: WaitStep (OnTurnStart) moves Wait 1->2 and drops Mew's
# offense; the player acts; WaitResolve (OnTurnEnd) reads 2 or 3 and sets 5 or 4.
Trigger: OnTurnStart
Priority: 15
Script: EncScript_Mew_WaitStep
Conditions:
    Var(Wait) == 1
    Var(Phase) == 2

Trigger: OnTurnStart
Priority: 30
Script: EncScript_Mew_Mischief
Conditions:
    Var(ChaosGuard) == 0
    Var(Phase) <= 2
    Any:
        Var(Bored) >= 3
        All:
            Var(Phase) == 2
            Var(Wait) >= 4

Trigger: OnTurnEnd
Priority: 80
Script: EncScript_Mew_WaitResolve
Conditions:
    Var(Wait) >= 2
    Var(Wait) <= 3

Trigger: OnTurnEnd
Priority: 90
Script: EncScript_Mew_TurnClose
Conditions:
    Var(TurnGuard) == 1

#-------------------------------------------------------

Encounter: Raikou

#-------------------------------------------------------

# Raikou, "The Hunting Thunder". One number runs the fight: Velocity (0-5), a TEMPO resource, not
# an elemental one. It rises when Raikou gets to act before you and when it knocks something out, and
# it falls whenever the initiative is taken away - a Ground move, a turn it never got to act, shedding
# sleep/freeze, a negative Speed stage, quarry that refuses to break, a read Lightning Dash. Its guard
# runs UPWARD with Velocity (78/84/89/93), so the fight is "never let it get going", and the counter-
# tension is that every turn spent slowing it is a turn not spent damaging it. Exactly two windows
# genuinely drop its guard and both must be earned: breaking the Mark (70 for a turn) and the final
# phase's wild discharge (55 for two). Velocity moves a RAW Speed stat (+12%/-11%), never a stage, so
# the "it is slowed" drain reads only the player's speed control. Paralysis is free (Electric type);
# sleep and freeze are shed at turn start at a cost of 2 Velocity; burn, poison and confusion stick.
Properties:
    Level: LevelCap
    CatchRate: 0                # none; the weakened script sets a real one
    Balls: Blocked
    DamageReduction: 78         # Velocity 0, the bottom of the ladder
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo
    CapTypeEffectiveness: True
    FlatToxicDamage: True
    AiFlags: AI_FLAG_SMART_TRAINER
    Moves: MOVE_THUNDERBOLT, MOVE_EXTREME_SPEED, MOVE_AURA_SPHERE, MOVE_CRUNCH
    Ability: ABILITY_INNER_FOCUS

# Always-true block: pins the variable numbering the battle scripts hard-code. encounterproc assigns
# each Var() an index in first-appearance order, so naming all 15 here in order fixes
# Phase..FaintGuard to 0..14.
# 0 Phase (0 prowl / 1 hunt / 2 lightning incarnate / 3 weakened), 1 Velocity (0-5), 2 Mark (0 none,
# else a 3->2->1 countdown on the current quarry), 3 MarkCool (turns before it may re-mark), 4 Dash
# (0 none / 2 telegraphed / 1 dashing this turn), 5 Instability (0-4, phase 2 only), 6 Soft (turns of
# soft-guard window left), 7 LastGuard (damage reduction last ANNOUNCED - the re-fire latch),
# 8 MoveSeen (1 once any move resolved this turn - the turn-order detector), 9 BossActed, 10 TurnGuard,
# 11 PMove (0 none yet / 1 player used a status move / 2 player attacked - guard and fact in one var),
# 12 BMoveGuard, 13 SwitchGuard, 14 FaintGuard.
Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_Raikou_Intro
Conditions:
    Var(Phase) >= 0
    Var(Velocity) >= 0
    Var(Mark) >= 0
    Var(MarkCool) >= 0
    Var(Dash) >= 0
    Var(Instability) >= 0
    Var(Soft) >= 0
    Var(LastGuard) >= 0
    Var(MoveSeen) >= 0
    Var(BossActed) >= 0
    Var(TurnGuard) >= 0
    Var(PMove) >= 0
    Var(BMoveGuard) >= 0
    Var(SwitchGuard) >= 0
    Var(FaintGuard) >= 0

# The three phase transitions, each registered at both checkpoints because the threshold-crossing blow
# can be a move or an end-of-turn tick. Both copies are Once and both gate on a Var(Phase) value their
# shared script overwrites, so whichever fires first permanently disables the other.
Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Raikou_Hunt
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 0

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Raikou_Hunt
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 0

Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Raikou_Incarnate
Conditions:
    Battler(Boss).HpPercent <= 25
    Var(Phase) == 1

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Raikou_Incarnate
Conditions:
    Battler(Boss).HpPercent <= 25
    Var(Phase) == 1

Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Raikou_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 2

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Raikou_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 2

# The player's move, read three ways. All three share PMove as their guard, so priority makes them
# mutually exclusive: a Ground move pulls the tempo lever and never falls through, anything else lands
# on the attack/status pair by category. The value PMove is left holding is also the fact TurnClose
# needs to score a read Lightning Dash, which is what keeps this inside the variable budget.
# While a Dash is live the Ground lever is gated off and a Ground move falls through to _PlayerAttack -
# a dashing Raikou dodges the lever too.
Trigger: OnMoveEnd
Priority: 20
Script: EncScript_Raikou_PlayerGround
Conditions:
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Event.MoveType == TYPE_GROUND
    Var(PMove) == 0
    Var(Dash) == 0
    Var(Phase) <= 2

Trigger: OnMoveEnd
Priority: 21
Script: EncScript_Raikou_PlayerAttack
Conditions:
    Event.Target == B_POSITION_PLAYER_LEFT
    Event.MoveCategory != DAMAGE_CATEGORY_STATUS
    Var(PMove) == 0

Trigger: OnMoveEnd
Priority: 22
Script: EncScript_Raikou_PlayerStatus
Conditions:
    Event.Target == B_POSITION_PLAYER_LEFT
    Var(PMove) == 0

# Raikou used a move. Separate guard, since this is "boss used" not "aimed at". If nothing else has
# resolved this turn yet, it got there first - the whole thesis of the fight.
Trigger: OnMoveEnd
Priority: 30
Script: EncScript_Raikou_BossMove
Conditions:
    Event.Target == B_POSITION_OPPONENT_LEFT
    Var(BMoveGuard) == 0

Trigger: OnFaint
Priority: 10
Script: EncScript_Raikou_Faint
Conditions:
    Event.Battler == B_POSITION_PLAYER_LEFT
    Var(FaintGuard) == 0
    Var(Phase) <= 2

# Fires after a faint replacement too, which is correct - the hunt does not stop because you lost a
# Pokemon. Turn >= 1 keeps the opening send-out from reading as a flinch from the mark.
Trigger: OnSwitchIn
Priority: 10
Script: EncScript_Raikou_SwitchIn
Conditions:
    Event.Battler == B_POSITION_PLAYER_LEFT
    Turn >= 1
    Var(SwitchGuard) == 0
    Var(Phase) <= 2

# Once-per-turn scaffold: TurnOpen is unconditional-once-per-turn (its only gate is TurnGuard == 0,
# which it sets), TurnClose is self-disabling (gate TurnGuard == 1, which it clears). Between them
# they absorb the storm roll, the mark lifecycle, the dash lifecycle and every countdown, which is
# what keeps the scripts-per-checkpoint count at 2.
Trigger: OnTurnStart
Priority: 10
Script: EncScript_Raikou_TurnOpen
Conditions:
    Var(TurnGuard) == 0

# Instability climbs in TurnClose and resolves here, one checkpoint later, so the counter can't chase
# itself through every state in a single dispatch. The HP floor is load-bearing: enchangehp bypasses
# the damage-reduction path, so an unguarded 12% self-hit near death would faint Raikou before the
# catch window ever opens.
Trigger: OnTurnStart
Priority: 20
Script: EncScript_Raikou_Discharge
Conditions:
    Var(Instability) >= 4
    Var(Soft) == 0
    Var(Phase) == 2
    Battler(Boss).HpPercent >= 15

Trigger: OnTurnEnd
Priority: 90
Script: EncScript_Raikou_TurnClose
Conditions:
    Var(TurnGuard) == 1

#-------------------------------------------------------

Encounter: Entei

#-------------------------------------------------------

# Entei, "The Walking Volcano". Raikou is a slider you fight downward; Entei is a bomb timer you
# cannot defuse. Pressure (0-5) NEVER falls on its own - it only ever rises, and is only ever spent
# by erupting. The player does not choose whether the volcano goes off, only when, how big, and what
# they are standing on. Its guard is a locked door, not a ladder: a flat value for the whole phase
# (90/92/94), and the only thing that opens it is an eruption - its own (65 for two turns), a
# Cataclysm (55 for three), or one the player forced early by turtling (78 for one). Scorch (0-3) is
# a transition tax and eruption fuel, not a chip: it taxes switching in and sets the next eruption's
# size, and is cooled only by Water moves and Rain. No status immunities at all - burn and freeze are
# dead against a Fire type, and sleep/paralysis/poison all FEED Pressure every turn they last.
Properties:
    Level: LevelCap
    CatchRate: 0                # none; the weakened script sets a real one
    Balls: Blocked
    DamageReduction: 90         # Dormant; flat for the whole phase
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo
    CapTypeEffectiveness: True
    FlatToxicDamage: True
    AiFlags: AI_FLAG_SMART_TRAINER
    Moves: MOVE_SACRED_FIRE, MOVE_ERUPTION, MOVE_BULLDOZE, MOVE_EXTRASENSORY
    Ability: ABILITY_INNER_FOCUS

# Always-true block: pins the variable numbering the battle scripts hard-code. encounterproc assigns
# each Var() an index in first-appearance order, so naming all 12 here in order fixes Phase..FaintGuard
# to 0..11.
# 0 Phase (0 dormant / 1 eruption cycle / 2 cataclysm / 3 weakened), 1 Pressure (0-5), 2 Fuse (0
# unlit, else 3->2->1 resolved at 1), 3 Scorch (0-3), 4 Window (turns of open guard left),
# 5 LastGuard (damage reduction last ANNOUNCED - the re-fire latch), 6 VentCool (turns before it may
# vent early again), 7 TurnGuard, 8 PMove, 9 BMoveGuard, 10 SwitchGuard, 11 FaintGuard.
Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_Entei_Intro
Conditions:
    Var(Phase) >= 0
    Var(Pressure) >= 0
    Var(Fuse) >= 0
    Var(Scorch) >= 0
    Var(Window) >= 0
    Var(LastGuard) >= 0
    Var(VentCool) >= 0
    Var(TurnGuard) >= 0
    Var(PMove) >= 0
    Var(BMoveGuard) >= 0
    Var(SwitchGuard) >= 0
    Var(FaintGuard) >= 0

# The three phase transitions, each registered at both checkpoints because the threshold-crossing blow
# can be a move or an end-of-turn tick. Both copies are Once and both gate on a Var(Phase) value their
# shared script overwrites, so whichever fires first permanently disables the other.
Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Entei_Cycle
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 0

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Entei_Cycle
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 0

Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Entei_Cataclysm
Conditions:
    Battler(Boss).HpPercent <= 25
    Var(Phase) == 1

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Entei_Cataclysm
Conditions:
    Battler(Boss).HpPercent <= 25
    Var(Phase) == 1

Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Entei_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 2

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Entei_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 2

# The player's move, read two ways, sharing PMove as their guard so priority makes them mutually
# exclusive. A Water move that lands on Entei cools the field AND feeds Pressure in one script -
# being the cooling lever does not exempt it from "Pressure cannot be prevented".
Trigger: OnMoveEnd
Priority: 20
Script: EncScript_Entei_PlayerWater
Conditions:
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Event.MoveType == TYPE_WATER
    Var(PMove) == 0
    Var(Phase) <= 2

Trigger: OnMoveEnd
Priority: 21
Script: EncScript_Entei_PlayerAttack
Conditions:
    Event.Target == B_POSITION_PLAYER_LEFT
    Event.MoveCategory != DAMAGE_CATEGORY_STATUS
    Var(PMove) == 0
    Var(Phase) <= 2

# Entei stoking its own fire. Separate guard, since this is "boss used" not "aimed at".
Trigger: OnMoveEnd
Priority: 30
Script: EncScript_Entei_BossFire
Conditions:
    Event.Target == B_POSITION_OPPONENT_LEFT
    Event.MoveType == TYPE_FIRE
    Var(BMoveGuard) == 0
    Var(Phase) <= 2

Trigger: OnFaint
Priority: 10
Script: EncScript_Entei_Faint
Conditions:
    Event.Battler == B_POSITION_PLAYER_LEFT
    Var(FaintGuard) == 0
    Var(Phase) <= 2

# The switch tax. Turn >= 1 keeps the opening send-out off the burning ground, and Scorch > 0 means
# an uncooked field costs nothing to pivot on.
Trigger: OnSwitchIn
Priority: 10
Script: EncScript_Entei_SwitchIn
Conditions:
    Event.Battler == B_POSITION_PLAYER_LEFT
    Turn >= 1
    Var(SwitchGuard) == 0
    Var(Scorch) > 0
    Var(Phase) <= 2

# Once-per-turn scaffold: TurnOpen is unconditional-once-per-turn (its only gate is TurnGuard == 0,
# which it sets), TurnClose is self-disabling (gate TurnGuard == 1, which it clears). Between them
# they absorb the rain cooling, the status feed, every countdown and the fuse.
Trigger: OnTurnStart
Priority: 10
Script: EncScript_Entei_TurnOpen
Conditions:
    Var(TurnGuard) == 0

# The fuse is stepped down in TurnClose and resolved here, one checkpoint later, so the countdown
# cannot chase itself through every state in a single dispatch. The HP split is load-bearing:
# enchangehp bypasses the damage-reduction path, so the 8% recoil could faint Entei before the catch
# window opens. Below 15% the eruption still fires, it just costs Entei nothing - a lit fuse can
# never be un-lit, so blocking the event outright would stall it forever.
Trigger: OnTurnStart
Priority: 20
Script: EncScript_Entei_Erupt
Conditions:
    Var(Fuse) == 1
    Battler(Boss).HpPercent >= 15

Trigger: OnTurnStart
Priority: 21
Script: EncScript_Entei_EruptSafe
Conditions:
    Var(Fuse) == 1
    Battler(Boss).HpPercent < 15

# Pressure Break, the anti-turtle vent. "Preparing to heal" is not observable; holding a stat boost
# is, and carries the same intent. Turtle up and you force a small, early, weak eruption; stay lean
# and Pressure climbs to 5 on its own for a devastating one with the biggest window in the fight.
Trigger: OnTurnStart
Priority: 30
Script: EncScript_Entei_Vent
Conditions:
    Var(Pressure) >= 3
    Var(Fuse) == 0
    Var(Window) == 0
    Var(VentCool) == 0
    Var(Phase) <= 1
    Any:
        Battler(PlayerLeft).Stat(STAT_ATK) > DEFAULT_STAT_STAGE
        Battler(PlayerLeft).Stat(STAT_DEF) > DEFAULT_STAT_STAGE
        Battler(PlayerLeft).Stat(STAT_SPATK) > DEFAULT_STAT_STAGE
        Battler(PlayerLeft).Stat(STAT_SPDEF) > DEFAULT_STAT_STAGE
        Battler(PlayerLeft).Stat(STAT_SPEED) > DEFAULT_STAT_STAGE

Trigger: OnTurnEnd
Priority: 90
Script: EncScript_Entei_TurnClose
Conditions:
    Var(TurnGuard) == 1

#-------------------------------------------------------

Encounter: Suicune

#-------------------------------------------------------

# Suicune, "The Purifier". Raikou is a slider you fight downward and Entei is a bomb timer you cannot
# defuse; Suicune is a resource you are constantly tempted to hand it. Flow (0-5) is fed ONLY by
# Suicune finding something on the field to wash away - weather, terrain, screens, hazards, a
# Substitute, a status on itself, or a stat stage off neutral on either side. Every impurity the
# player puts down is a point of Flow waiting to be collected, and a clean turn drains one back. Its
# own kit punishes patience (Scald burns, Bulldoze grinds Speed) so playing clean is not free. Then
# the fight inverts twice: Sacred Water at Flow 5 only heals if the field is CLEAN when it resolves,
# and phase 2 is untouchable at any Flow above 0, so the player must drain it to empty and then land
# a super-effective or critical hit to shatter it. No status immunity until phase 2 - a status on
# Suicune is an impurity, so inflicting one just pays it a point of Flow to cure itself.
Properties:
    Level: LevelCap
    CatchRate: 0                # none; the weakened script sets a real one
    Balls: Blocked
    DamageReduction: 88         # Cleansing Current at Flow 0
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo
    CapTypeEffectiveness: True
    FlatToxicDamage: True
    AiFlags: AI_FLAG_SMART_TRAINER
    Moves: MOVE_SCALD, MOVE_ICE_BEAM, MOVE_EXTRASENSORY, MOVE_BULLDOZE
    Ability: ABILITY_INNER_FOCUS

# Always-true block: pins the variable numbering the battle scripts hard-code. encounterproc assigns
# each Var() an index in first-appearance order, so naming all 14 here in order fixes Phase..Still
# to 0..13.
# 0 Phase (0 Cleansing Current / 1 The Cleansing / 2 Sacred Beast / 3 Weakened), 1 Flow (0-5),
# 2 Rite (purification countdown; 0 idle, else 3->2->1 resolved at 1), 3 Draw (Sacred Water
# countdown; 0 idle, 2 telegraphed, 1 resolves), 4 Break (turns of open guard left), 5 LastGuard
# (damage reduction last ANNOUNCED - the re-fire latch), 6 Cleansed (things removed by this turn's
# purification; zeroed at TurnOpen, read by the Flow decay), 7 TurnGuard, 8 Shatter (per-turn
# re-entry guard for the two OnMoveEnd shatter triggers), 9 Calm (consecutive clean turns),
# 10 Breach (which opening is live: 1 broken draw, 2 shattered purity), 11 Prev (ApplyGuard's
# before-value scratch), 12 Dirty (result of the read-only impurity sweep), 13 Swept (a purification
# already ran this turn; set by Purify itself, cleared at TurnOpen).
Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_Suicune_Intro
Conditions:
    Var(Phase) >= 0
    Var(Flow) >= 0
    Var(Rite) >= 0
    Var(Draw) >= 0
    Var(Break) >= 0
    Var(LastGuard) >= 0
    Var(Cleansed) >= 0
    Var(TurnGuard) >= 0
    Var(Shatter) >= 0
    Var(Calm) >= 0
    Var(Breach) >= 0
    Var(Prev) >= 0
    Var(Cycle) >= 0
    Var(Dirty) >= 0
    Var(Swept) >= 0

# The three phase transitions, each registered at both checkpoints because the threshold-crossing
# blow can be a move or an end-of-turn tick. Both copies are Once and both gate on a Var(Phase) value
# their shared script overwrites, so whichever fires first permanently disables the other.
Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Suicune_Cleansing
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 0

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Suicune_Cleansing
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 0

Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Suicune_SacredBeast
Conditions:
    Battler(Boss).HpPercent <= 20
    Var(Phase) == 1

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Suicune_SacredBeast
Conditions:
    Battler(Boss).HpPercent <= 20
    Var(Phase) == 1

Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Suicune_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 2

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Suicune_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 2

# Once-per-turn scaffold: TurnOpen is unconditional-once-per-turn (its only gate is TurnGuard == 0,
# which it sets), TurnClose is self-disabling (gate TurnGuard == 1, which it clears). Between them
# they own every countdown, the Flow decay, the regen and the recurring callouts.
Trigger: OnTurnStart
Priority: 10
Script: EncScript_Suicune_TurnOpen
Conditions:
    Var(TurnGuard) == 0

# Rite is stepped down in TurnClose and resolved here, one checkpoint later, so the countdown cannot
# chase itself through every state in a single dispatch. Phase 2 hands purification over to
# StillWater instead, which runs at the end of every turn.
Trigger: OnTurnStart
Priority: 20
Script: EncScript_Suicune_Rite
Conditions:
    Var(Rite) == 1
    Var(Phase) <= 1

# Sacred Water. The draw is telegraphed a full turn ahead (Draw 2, stepped to 1 in TurnClose) and
# resolves at priority 15 - ahead of the scheduled Rite at 20, so the check reads the field as the
# player actually left it. Behind the Rite, a sweep that happened to land on the resolve turn would
# wash the player's interrupt away and hand Suicune the heal it had just been denied.
Trigger: OnTurnStart
Priority: 15
Script: EncScript_Suicune_SacredResolve
Conditions:
    Var(Draw) == 1

# Var(Swept) keeps the draw off a turn a Rite already swept. The draw opens with its own purification,
# and nothing else in its gates goes false when a Rite runs first at priority 20 - so without this a
# Flow-5 turn that also happened to be a rite turn played the whole PURIFICATION sequence twice back
# to back, undertow included. Only reachable from Phase 1, which is where it was showing up.
Trigger: OnTurnStart
Priority: 30
Script: EncScript_Suicune_SacredDraw
Conditions:
    Var(Flow) == 5
    Var(Draw) == 0
    Var(Break) == 0
    Var(Swept) == 0
    Var(Phase) >= 1
    Var(Phase) <= 2

# The phase-2 puzzle. Both share Var(Shatter) as their re-entry guard, so exactly one fires per move -
# an Event.* condition stays true for the whole dispatch, so an event-reacting trigger has to disable
# itself. Once would be wrong: it means once per BATTLE, and the shatter is meant to be repeatable.
# The crit test cannot be expressed as a condition, so ShatterCrit leads with jumpifnotcriticalhit
# in-script and still consumes the guard on a non-crit rather than re-firing.
Trigger: OnMoveEnd
Priority: 20
Script: EncScript_Suicune_ShatterType
Conditions:
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Var(Phase) == 2
    Var(Flow) == 0
    Var(Break) == 0
    Var(Shatter) == 0
    Any:
        Event.MoveType == TYPE_GRASS
        Event.MoveType == TYPE_ELECTRIC

Trigger: OnMoveEnd
Priority: 21
Script: EncScript_Suicune_ShatterCrit
Conditions:
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Var(Phase) == 2
    Var(Flow) == 0
    Var(Break) == 0
    Var(Shatter) == 0

# Sacred Beast purifies at the end of every turn instead of on the Rite timer - but not while a
# shatter has it open, so breaking through genuinely stops it working. Var(Swept) is its
# self-disabling gate (set by Purify, cleared at TurnOpen); without one, a level trigger whose
# conditions still hold re-selects until the per-checkpoint script cap trips.
Trigger: OnTurnEnd
Priority: 20
Script: EncScript_Suicune_StillWater
Conditions:
    Var(Phase) == 2
    Var(Break) == 0
    Var(Swept) == 0

Trigger: OnTurnEnd
Priority: 90
Script: EncScript_Suicune_TurnClose
Conditions:
    Var(TurnGuard) == 1

#-------------------------------------------------------

Encounter: Celebi

#-------------------------------------------------------

# Celebi, "The Guardian of Time". Raikou is a slider you fight downward, Entei is a bomb timer you
# cannot defuse, Suicune is a resource you are tempted to hand it. Celebi is a fight where damage is
# not permanent until you make it permanent. Everything hangs off Echo, an HP percentage Celebi has
# recorded: a record window opens, Celebi marks its HP, and TIME REWIND later snaps its HP back to
# that mark. The mark only ever moves DOWN, and it is re-taken whenever the player lands a hit while
# the window is open (an ANCHOR) - so roughly two turns in three of damage stick, and the player
# chooses which. Then the fight adds a layer twice: Future Sight surfaces the AI's real move
# prediction and pays the player for defying it, and Temporal Collapse shortens the cycle and ends
# in one final TIME COLLAPSE that the banked anchors are what survive.
Properties:
    Level: LevelCap
    CatchRate: 0                # none; the weakened script sets a real one
    Balls: Blocked
    DamageReduction: 86         # The Guardian of Time
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo
    CapTypeEffectiveness: True
    FlatToxicDamage: True
    AiFlags: AI_FLAG_UNFAIR_TRAINER   # AI_FLAG_SMART_TRAINER | AI_FLAG_PREDICTION; the prediction is the fight
    Moves: MOVE_FUTURE_SIGHT, MOVE_PSYCHIC, MOVE_ENERGY_BALL, MOVE_ANCIENT_POWER

# Always-true block: pins the variable numbering the battle scripts hard-code. encounterproc assigns
# each Var() an index in first-appearance order, so naming all 14 here in order fixes Phase..Breach
# to 0..13.
# 0 Phase (0 The Guardian of Time / 1 Future Sight / 2 Temporal Collapse / 3 Weakened), 1 Echo
# (recorded HP percentage; 101 = nothing recorded yet, so the first ENC_SNAP_LOWEST always writes),
# 2 Cycle (rewind countdown; 0 idle, else 3->2->1 resolved at 1, 4 = spent sentinel), 3 Window
# (0 closed, 1 open, 2 anchored this turn), 4 Anchored (0-5, read by TIME COLLAPSE), 5 Pred
# (0 clouded / 1 physical / 2 special / 3 status / 4 consumed / 5 unread), 6 Broken (turns of open
# guard left), 7 LastGuard (damage reduction last ANNOUNCED - the re-fire latch), 8 TurnGuard,
# 9 PEcho (player HP percentage at record time), 10 Delta (scratch: player recovery since PEcho),
# 11 Collapsed (TIME COLLAPSE has fired), 12 Prev (ApplyGuard's before-value scratch), 13 Breach
# (which opening is live: 1 broken future, 2 failed collapse).
Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_Celebi_Intro
Conditions:
    Var(Phase) >= 0
    Var(Echo) >= 0
    Var(Cycle) >= 0
    Var(Window) >= 0
    Var(Anchored) >= 0
    Var(Pred) >= 0
    Var(Broken) >= 0
    Var(LastGuard) >= 0
    Var(TurnGuard) >= 0
    Var(PEcho) >= 0
    Var(Delta) >= 0
    Var(Collapsed) >= 0
    Var(Prev) >= 0
    Var(Breach) >= 0

# The phase transitions, each registered at both checkpoints because the threshold-crossing blow can
# be a move or an end-of-turn tick. Both copies are Once and both gate on a variable their shared
# script overwrites, so whichever fires first permanently disables the other.
Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Celebi_FutureSight
Conditions:
    Battler(Boss).HpPercent <= 60
    Var(Phase) == 0

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Celebi_FutureSight
Conditions:
    Battler(Boss).HpPercent <= 60
    Var(Phase) == 0

Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Celebi_Collapse
Conditions:
    Battler(Boss).HpPercent <= 25
    Var(Phase) == 1

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Celebi_Collapse
Conditions:
    Battler(Boss).HpPercent <= 25
    Var(Phase) == 1

# TIME COLLAPSE sits AHEAD of the weakened trigger (4 vs 5) and the weakened trigger gates on
# Var(Collapsed) == 1, so the finale always plays before the catch window opens even when one hit
# crosses both thresholds. Var(Collapsed) is also what disables the second copy of this trigger -
# unlike the other transitions, TIME COLLAPSE doesn't move Var(Phase).
Trigger: OnMoveEnd
Priority: 4
Flags: Once
Script: EncScript_Celebi_TimeCollapse
Conditions:
    Battler(Boss).HpPercent <= 13
    Var(Phase) == 2
    Var(Collapsed) == 0

Trigger: OnTurnEnd
Priority: 4
Flags: Once
Script: EncScript_Celebi_TimeCollapse
Conditions:
    Battler(Boss).HpPercent <= 13
    Var(Phase) == 2
    Var(Collapsed) == 0

Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Celebi_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 2
    Var(Collapsed) == 1

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Celebi_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 2
    Var(Collapsed) == 1

# Once-per-turn scaffold: TurnOpen is unconditional-once-per-turn (its only gate is TurnGuard == 0,
# which it sets), TurnClose is self-disabling (gate TurnGuard == 1, which it clears). Between them
# they own the per-turn scratch, every countdown, and the recurring callouts.
Trigger: OnTurnStart
Priority: 10
Script: EncScript_Celebi_TurnOpen
Conditions:
    Var(TurnGuard) == 0

# Cycle is stepped down in TurnClose and resolved here, one checkpoint later, so the countdown
# cannot chase itself through every state in a single dispatch. It resolves to the spent sentinel 4,
# which TurnClose skips and the next TurnOpen clears back to 0.
Trigger: OnTurnStart
Priority: 20
Script: EncScript_Celebi_Rewind
Conditions:
    Var(Cycle) == 1

# Behind the rewind on purpose: on a turn that does both, the snapshot has to see the post-rewind HP
# rather than the damage the rewind is about to erase.
Trigger: OnTurnStart
Priority: 30
Script: EncScript_Celebi_OpenWindow
Conditions:
    Var(Cycle) == 0
    Var(Phase) <= 2

# Last thing said before the player picks a move. encstoreprediction writes Var(Pred), which is this
# trigger's own self-disabling gate; TurnOpen re-arms it to 5 each turn from phase 1 on.
Trigger: OnTurnStart
Priority: 40
Script: EncScript_Celebi_Foresee
Conditions:
    Var(Pred) == 5
    Var(Phase) >= 1
    Var(Phase) <= 2

# An anchor is earned by damaging Celebi during its record window. Var(Window) 1 -> 2 is the
# self-disabling guard an event-reacting trigger needs: an Event.* condition stays true for the whole
# dispatch, so without one this re-fires until the per-checkpoint script cap trips.
Trigger: OnMoveEnd
Priority: 20
Script: EncScript_Celebi_Anchor
Conditions:
    Event.Battler == B_POSITION_OPPONENT_LEFT
    Event.Cause == ENC_CAUSE_MOVE_DAMAGE
    Var(Window) == 1

# The prediction comparison. Conditions compare a var against a literal, never against another var,
# so "does Event.MoveCategory equal Var(Pred)?" is three matched pairs plus one catch-all behind
# them. A matched trigger writes Pred = 4, which makes the catch-all's gate false in the same
# dispatch - the lower-priority trigger is disabled by a variable the higher one wrote, not by
# ordering alone. Event.Target is the battler that USED the move, so a self-targeting status move
# (Swords Dance, Recover) still registers as the player having played a status move.
Trigger: OnMoveEnd
Priority: 25
Script: EncScript_Celebi_PredHeld
Conditions:
    Event.Target == B_POSITION_PLAYER_LEFT
    Var(Pred) == 1
    Event.MoveCategory == DAMAGE_CATEGORY_PHYSICAL

Trigger: OnMoveEnd
Priority: 26
Script: EncScript_Celebi_PredHeld
Conditions:
    Event.Target == B_POSITION_PLAYER_LEFT
    Var(Pred) == 2
    Event.MoveCategory == DAMAGE_CATEGORY_SPECIAL

Trigger: OnMoveEnd
Priority: 27
Script: EncScript_Celebi_PredHeld
Conditions:
    Event.Target == B_POSITION_PLAYER_LEFT
    Var(Pred) == 3
    Event.MoveCategory == DAMAGE_CATEGORY_STATUS

Trigger: OnMoveEnd
Priority: 30
Script: EncScript_Celebi_PredBroken
Conditions:
    Event.Target == B_POSITION_PLAYER_LEFT
    Var(Pred) >= 1
    Var(Pred) <= 3

Trigger: OnTurnEnd
Priority: 90
Script: EncScript_Celebi_TurnClose
Conditions:
    Var(TurnGuard) == 1

#-------------------------------------------------------

Encounter: Lugia

#-------------------------------------------------------

# Lugia, "The Storm Beneath the Sea". Raikou is a slider you fight downward, Entei is a bomb timer
# you cannot defuse, Suicune is a resource you are tempted to hand it, Celebi is a fight where damage
# is not permanent until you make it permanent. Lugia is a fight you have to make WORSE on purpose.
# Everything hangs off Storm (0-5), which Lugia raises itself by attacking, and the ladder is real
# battle weather: rain at 2-3, Strong Winds at 4 (which cancels Lugia's own Electric/Ice/Rock
# weaknesses), primal rain at 5. Calm Lugia is SOFTER than storming Lugia and never tires; storming
# Lugia is nearly untouchable, chips the field every turn and erodes accuracy - but it accrues Strain,
# and capping Strain collapses its guard to 60 for two turns. That window is the only place real
# damage happens, so the player's problem is not "survive the storm", it is "race the Strain" before
# the Maelstrom cycle closes into a restful Eye that sheds it.
Properties:
    Level: LevelCap
    CatchRate: 0                # none; the weakened script sets a real one
    Balls: Blocked
    DamageReduction: 86         # Guardian of the Sea at Storm 0
    Immunities: Ohko, FixedDamage, HpSwap, SharedKo
    CapTypeEffectiveness: True
    FlatToxicDamage: True
    AiFlags: AI_FLAG_SMART_TRAINER
    Moves: MOVE_AEROBLAST, MOVE_HYDRO_PUMP, MOVE_THUNDER, MOVE_PSYCHIC
    Ability: ABILITY_MULTISCALE

# Always-true block: pins the variable numbering the battle scripts hard-code. encounterproc assigns
# each Var() an index in first-appearance order, so naming all 15 here in order fixes Phase..Cycle
# to 0..14.
# 0 Phase (0 Guardian of the Sea / 1 The Sea Erupts / 2 Ocean's Wrath / 3 Weakened), 1 Storm (0-5),
# 2 Strain (0-6; capping it collapses the guard), 3 Eye (0 closed, else 2->1 countdown), 4 Hold
# (Maelstrom cycle timer; 0 idle, 3 surface, 2 deep sea, 1 strike), 5 Break (turns of collapsed
# guard left), 6 LastGuard (damage reduction last ANNOUNCED - the re-fire latch), 7 LastStorm (storm
# tier last APPLIED - the weather/banner latch), 8 TurnGuard, 9 Rise (per-turn re-entry guard shared
# by the two storm-rise triggers), 10 Vent (per-turn re-entry guard for the weather vent), 11 Swell
# (per-switch re-entry guard for the Maelstrom switch-in toll), 12 HpMark (boss HP percentage at turn
# open; ENC_SNAP_DAMAGE turns it into "lost this turn"), 13 Prev (ApplyGuard's before-value scratch),
# 14 Cycle (per-turn re-entry guard shared by the two Maelstrom cycle triggers).
Trigger: OnBattleStart
Priority: 10
Flags: Once
Script: EncScript_Lugia_Intro
Conditions:
    Var(Phase) >= 0
    Var(Storm) >= 0
    Var(Strain) >= 0
    Var(Eye) >= 0
    Var(Hold) >= 0
    Var(Break) >= 0
    Var(LastGuard) >= 0
    Var(LastStorm) >= 0
    Var(TurnGuard) >= 0
    Var(Rise) >= 0
    Var(Vent) >= 0
    Var(Swell) >= 0
    Var(HpMark) >= 0
    Var(Prev) >= 0

# The three phase transitions, each registered at both checkpoints because the threshold-crossing
# blow can be a move or an end-of-turn tick. Both copies are Once and both gate on a Var(Phase) value
# their shared script overwrites, so whichever fires first permanently disables the other.
Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Lugia_SeaErupts
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 0

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Lugia_SeaErupts
Conditions:
    Battler(Boss).HpPercent <= 50
    Var(Phase) == 0

Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Lugia_OceansWrath
Conditions:
    Battler(Boss).HpPercent <= 25
    Var(Phase) == 1

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Lugia_OceansWrath
Conditions:
    Battler(Boss).HpPercent <= 25
    Var(Phase) == 1

Trigger: OnMoveEnd
Priority: 5
Flags: Once
Script: EncScript_Lugia_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 2

Trigger: OnTurnEnd
Priority: 5
Flags: Once
Script: EncScript_Lugia_Weakened
Conditions:
    Battler(Boss).HpPercent <= 10
    Var(Phase) == 2

# Once-per-turn scaffold: TurnOpen is unconditional-once-per-turn (its only gate is TurnGuard == 0,
# which it sets), TurnClose is self-disabling (gate TurnGuard == 1, which it clears). Between them
# they own every countdown, the whole Strain economy and the recurring callouts.
Trigger: OnTurnStart
Priority: 10
Script: EncScript_Lugia_TurnOpen
Conditions:
    Var(TurnGuard) == 0

# Hold is stepped down in TurnClose and read here, one checkpoint later, so a real turn always passes
# between a tick and its resolution. The strike sits AHEAD of the dive so a resolving strike can never
# be re-telegraphed in the same dispatch.
# Both share Var(Cycle), cleared by TurnOpen at the same checkpoint one priority earlier: a level
# condition on Hold alone stays true for the rest of the dispatch and would re-select forever.
Trigger: OnTurnStart
Priority: 15
Script: EncScript_Lugia_Strike
Conditions:
    Var(Hold) == 1
    Var(Cycle) == 0
    Var(Phase) <= 2

Trigger: OnTurnStart
Priority: 20
Script: EncScript_Lugia_DeepSea
Conditions:
    Var(Hold) == 2
    Var(Cycle) == 0
    Var(Phase) <= 2

# The two storm-rise triggers share Var(Rise), so exactly one rung is climbed per turn and a Psychic
# turn is a free turn. Both are event-reacting, so they must disable themselves: an Event.* condition
# stays true for the whole dispatch and Once would mean once per BATTLE.
Trigger: OnMoveEnd
Priority: 20
Script: EncScript_Lugia_StormAeroblast
Conditions:
    Event.Target == B_POSITION_OPPONENT_LEFT     # the boss USED the move
    Event.Move == MOVE_AEROBLAST
    Var(Rise) == 0
    Var(Phase) <= 2

Trigger: OnMoveEnd
Priority: 21
Script: EncScript_Lugia_StormSurge
Conditions:
    Event.Target == B_POSITION_OPPONENT_LEFT
    Var(Rise) == 0
    Var(Phase) <= 2
    Any:
        Event.MoveType == TYPE_WATER
        Event.MoveType == TYPE_ELECTRIC

# The vent: overwriting the weather while the storm is still overwritable knocks two rungs off it.
# Only reachable at Storm 2-3 - Tempest and Maelstrom are primal-class weather, which
# TryChangeBattleWeather refuses to let anything replace, so the door visibly closes as the ladder
# climbs. Weather != B_WEATHER_RAIN_NORMAL is what makes Lugia's own rain not count as a vent.
Trigger: OnMoveEnd
Priority: 25
Script: EncScript_Lugia_Vent
Conditions:
    Var(Storm) >= 2
    Var(Storm) <= 3
    Var(Vent) == 0
    Var(Phase) <= 2
    Weather != B_WEATHER_NONE
    Weather != B_WEATHER_RAIN_NORMAL

# The Maelstrom's answer to pivot stalling. Var(Swell) is cleared at TurnClose rather than TurnOpen,
# so a mid-turn replacement after a faint is still tolled.
Trigger: OnSwitchIn
Priority: 20
Script: EncScript_Lugia_Undertow
Conditions:
    Event.Battler == B_POSITION_PLAYER_LEFT
    Var(Storm) == 5
    Var(Swell) == 0
    Var(Phase) <= 2

Trigger: OnTurnEnd
Priority: 90
Script: EncScript_Lugia_TurnClose
Conditions:
    Var(TurnGuard) == 1
